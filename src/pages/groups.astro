---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { directoryShelves, directorySource } from '../data/facebookDirectory';
import { formatMedium } from '../lib/time';

const pageIds = new Set(['news-pages', 'official', 'parties', 'nonprofits', 'places']);
const groups = directoryShelves.filter((shelf) => !pageIds.has(shelf.id));
const pages = directoryShelves.filter((shelf) => pageIds.has(shelf.id));
const total = directoryShelves.reduce((count, shelf) => count + shelf.items.length, 0);
const highlights = (await getCollection('social')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Social"
  description="Public Facebook groups and pages for Bastrop County — rooms to join and pages to follow."
>
  <PageHead
    kicker="Community"
    title="Social"
    lede="Public Facebook groups and pages around Bastrop County. A private group has to approve you before you can read it."
  />
  <div class="wrap">
    {highlights.length > 0 && (
      <section class="section" id="highlights">
        <div class="section-head">
          <div>
            <p class="kicker">From the rooms</p>
            <h2>Highlights</h2>
            <p class="meta">Public posts the desk filed from county Facebook groups. Not the whole feed — only what is worth a second look.</p>
          </div>
          <p class="meta">{highlights.length} note{highlights.length === 1 ? '' : 's'}</p>
        </div>
        <div class="news-list">
          {highlights.map((item) => (
            <article class="update-card">
              <a href={`/social/${item.id}`}>
                <p class="kicker">{item.data.group} · {formatMedium(item.data.pubDate)}</p>
                <h3>{item.data.title}</h3>
                <p class="meta">{item.data.summary}</p>
              </a>
            </article>
          ))}
        </div>
      </section>
    )}

    <p class="meta" id="directory">{total} Facebook rooms and pages. Member counts are approximate.</p>
    <nav class="filters" aria-label="Jump to a category">
      <div>
        <p class="kicker">Groups to join</p>
        <div class="filter-row">
          {groups.map((shelf) => (
            <a class="chip" href={`#${shelf.id}`}>{shelf.title}</a>
          ))}
        </div>
      </div>
      <div>
        <p class="kicker">Pages to follow</p>
        <div class="filter-row">
          {pages.map((shelf) => (
            <a class="chip" href={`#${shelf.id}`}>{shelf.title}</a>
          ))}
        </div>
      </div>
    </nav>

    {groups.map((shelf) => (
      <section class="section" id={shelf.id}>
        <div class="section-head">
          <div>
            <h2>{shelf.title}</h2>
            <p class="meta">{shelf.intro}</p>
          </div>
          <p class="meta">{shelf.items.length} groups</p>
        </div>
        <ul class="directory">
          {shelf.items.map((item) => (
            <li>
              <a href={item.href} rel="noopener">
                <strong>{item.name}</strong>
                <em>{item.detail}</em>
                {item.note && <span class="note">{item.note}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <div class="section-head" id="pages">
      <div>
        <p class="kicker">Follow</p>
        <h2>Pages</h2>
        <p class="meta">These are Facebook pages, not groups you request to join.</p>
      </div>
    </div>

    {pages.map((shelf) => (
      <section class="section" id={shelf.id}>
        <div class="section-head">
          <div>
            <h2>{shelf.title}</h2>
            <p class="meta">{shelf.intro}</p>
          </div>
          <p class="meta">{shelf.items.length} pages</p>
        </div>
        <ul class="directory">
          {shelf.items.map((item) => (
            <li>
              <a href={item.href} rel="noopener">
                <strong>{item.name}</strong>
                <em>{item.detail}</em>
                {item.note && <span class="note">{item.note}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <p class="disclaimer">
      Names, privacy, and member counts come from <a href={directorySource}>this community list</a>.
      Counts change, and a private group may not let you in. Bastropia does not run these groups or pages, and a name here is not an endorsement.
      Official business — a burn ban, a polling place, a 911 call — still belongs on the county, the city, or the emergency line.
    </p>
  </div>
</BaseLayout>
