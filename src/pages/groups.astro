---
export const prerender = false;

import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import HomeBanner from '../components/HomeBanner.astro';
import { directoryShelves, directorySource } from '../data/facebookDirectory';
import { laneFilters, pluginPages, pluginSrc, sourceInitial } from '../data/socialSources';
import { directoryCards } from '../lib/directoryListing';
import { eventHref, listEvents } from '../lib/eventSource';
import { capOrganizer, filterEvents } from '../lib/events';
import { offsiteAttrs } from '../lib/links';
import { newestPerSource, readSocialFeed, relativeTime, type SocialFeedRecord, type StoredPost } from '../lib/socialFeed';
import { formatMedium, whenLabel } from '../lib/time';

const now = new Date();
const nowMs = now.getTime();

let feed: SocialFeedRecord | null = null;
try {
  feed = await readSocialFeed();
} catch (error) {
  console.error('groups feed failed', error);
}

const posts = newestPerSource(feed?.posts ?? []);
const videos = feed?.videos ?? [];
const updated = feed ? relativeTime(feed.fetchedAt, nowMs) : '';

let stories: { href: string; title: string; place: string; summary: string; when: string }[] = [];
try {
  const collection = await getCollection('news');
  stories = collection
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
    .slice(0, 4)
    .map((story) => ({
      href: `/news/${story.id}`,
      title: story.data.title,
      place: story.data.place,
      summary: story.data.description,
      when: formatMedium(story.data.pubDate),
    }));
} catch (error) {
  console.error('groups news failed', error);
}

let todayEvents: { href: string; title: string; when: string; city: string }[] = [];
let eventsAreToday = false;
try {
  const { events, source } = await listEvents();
  const today = capOrganizer(filterEvents(events, { when: 'today' }, now)).slice(0, 4);
  const upcoming = today.length
    ? []
    : filterEvents(events, { when: 'upcoming' }, now).slice(0, 4);
  const shown = today.length ? today : upcoming;
  eventsAreToday = today.length > 0;
  todayEvents = shown.map((event) => ({
    href: eventHref(event, source),
    title: event.data.title,
    when: `${whenLabel(event.data.schedule, event.data.start, event.data.end)} · ${event.data.city}`,
    city: event.data.city,
  }));
} catch (error) {
  console.error('groups events failed', error);
}

const shelves = directoryCards(directoryShelves);
const groups = shelves.filter((shelf) => shelf.kind === 'group');
const pages = shelves.filter((shelf) => shelf.kind === 'page');
const total = shelves.reduce((count, shelf) => count + shelf.items.length, 0);

const laneLabel: Record<StoredPost['lane'], string> = {
  government: 'Government',
  safety: 'Public safety',
  news: 'News',
  community: 'Community',
};
---

<BaseLayout
  title="Bastrop County Social: live posts, groups and pages"
  description="Live public posts, videos, and today's events from Bastrop County, plus the full list of local Facebook groups and pages."
>
  <PageHead
    kicker="Community"
    title="Bastrop County Social"
    lede="Public posts from county pages, refreshed about every 15 minutes. The full list of groups and pages is below. A private group still has to approve you."
  />
  <div class="wrap">
    <section class="hub" aria-label="Live county posts">
      <div class="hub-main">
        <div class="hub-status">
          <p class="live-badge"><i></i> Live</p>
          <p class="meta">{updated ? `Updated ${updated}` : 'The next refresh fills this in.'}</p>
        </div>
        {posts.length > 0 ? (
          <div class="filter-row" id="lane-filters" role="toolbar" aria-label="Filter posts by source">
            {laneFilters.map((lane) => (
              <button type="button" class="chip" data-lane={lane.id} aria-pressed={lane.id === 'all' ? 'true' : 'false'}>{lane.label}</button>
            ))}
          </div>
        ) : (
          <p class="meta">Facebook is quiet on this pass. County news, today's events, and the page timelines below are still live.</p>
        )}
        {posts.length > 0 ? (
          <div class="feed-list" id="feed-list">
            {posts.map((post) => (
              <article class="post-card" data-lane={post.lane}>
                <header>
                  <span class:list={['avatar', post.lane]} aria-hidden="true">{sourceInitial(post.sourceName)}</span>
                  <div>
                    <strong>{post.sourceName}</strong>
                    <p class="meta">{laneLabel[post.lane]} · <time datetime={post.published}>{relativeTime(post.published, nowMs)}</time></p>
                  </div>
                </header>
                {post.text && <p class="excerpt">{post.text}</p>}
                {post.image && <img src={post.image} alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()" />}
                <p class="more"><a href={post.url} {...offsiteAttrs(post.url)}>Open the post</a></p>
              </article>
            ))}
          </div>
        ) : (
          <div class="feed-list">
            {stories.map((story) => (
              <article class="post-card">
                <header>
                  <span class="avatar news" aria-hidden="true">{sourceInitial(story.place || 'B')}</span>
                  <div>
                    <strong>{story.place || 'Bastrop County'}</strong>
                    <p class="meta">From the desk · {story.when}</p>
                  </div>
                </header>
                <h3><a href={story.href}>{story.title}</a></h3>
                {story.summary && <p class="excerpt">{story.summary}</p>}
              </article>
            ))}
          </div>
        )}
        <p class="meta" id="feed-empty" hidden>No posts in this lane right now.</p>
      </div>
      <aside class="hub-side">
        <div class="section-head">
          <h2>{eventsAreToday ? 'Happening today' : 'Coming up'}</h2>
          <a href="/events">Calendar</a>
        </div>
        {todayEvents.length > 0 ? (
          <ul class="side-list">
            {todayEvents.map((event) => (
              <li>
                <a href={event.href} {...offsiteAttrs(event.href)}>
                  <strong>{event.title}</strong>
                  <em>{event.when}</em>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="meta">Today's list is on the <a class="text-link" href="/events">calendar</a>.</p>
        )}
        {posts.length > 0 && stories.length > 0 && (
          <>
            <div class="section-head">
              <h2>From the desk</h2>
              <a href="/news">News</a>
            </div>
            <ul class="side-list">
              {stories.slice(0, 3).map((story) => (
                <li>
                  <a href={story.href}>
                    <strong>{story.title}</strong>
                    <em>{story.place} · {story.when}</em>
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}
      </aside>
    </section>

    {videos.length > 0 && (
      <section class="section" aria-label="Latest videos">
        <div class="section-head">
          <div>
            <p class="kicker">Watch</p>
            <h2>Latest videos</h2>
          </div>
          <a href="/videos">All videos</a>
        </div>
        <div class="video-row">
          {videos.map((video) => (
            <a class="video-card" href={video.url} {...offsiteAttrs(video.url)}>
              <img src={video.thumb} alt="" loading="lazy" />
              <strong>{video.title}</strong>
              <em>{video.channelName} · {relativeTime(video.published, nowMs)}</em>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="section" aria-label="Facebook page timelines">
      <div class="section-head">
        <div>
          <p class="kicker">On Facebook</p>
          <h2>Page timelines</h2>
          <p class="meta">Official timelines from three public pages whose posts the Facebook plugin actually shows.</p>
        </div>
      </div>
      <div class="plugin-row">
        {pluginPages.map((page) => {
          const plugPost = posts.find((item) => item.sourceId === page.sourceId);
          return (
            <div class="timeline-slot" data-timeline>
              <iframe
                title={`${page.name} on Facebook`}
                src={pluginSrc(page.href)}
                width="500"
                height="560"
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin"
              />
              <div class="timeline-fallback" data-timeline-fallback hidden>
                <p class="kicker">{page.name}</p>
                {plugPost ? (
                  <>
                    <p class="excerpt">{plugPost.text}</p>
                    <p class="meta">{relativeTime(plugPost.published, nowMs)}</p>
                  </>
                ) : (
                  <p>The Facebook timeline did not load in this browser.</p>
                )}
                <p class="more"><a href={page.href} {...offsiteAttrs(page.href)}>See posts on Facebook</a></p>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <div class="site-banner">
      <HomeBanner />
    </div>

    <section class="section" id="directory">
      <div class="section-head">
        <div>
          <p class="kicker">Directory</p>
          <h2>Groups and pages</h2>
          <p class="meta">{total} Facebook rooms and pages. Member counts are approximate.</p>
        </div>
      </div>
      <label class="search" for="directory-q">
        <span class="sr">Search groups and pages</span>
        <input id="directory-q" type="search" placeholder="Search groups and pages" autocomplete="off" />
      </label>
      <div class="filter-row" id="directory-filters" role="toolbar" aria-label="Filter the directory">
        <button type="button" class="chip" data-shelf="all" aria-pressed="true">All</button>
        {shelves.map((shelf) => (
          <button type="button" class="chip" data-shelf={shelf.id} aria-pressed="false">{shelf.title}</button>
        ))}
      </div>

      {groups.map((shelf) => (
        <section class="directory-shelf" id={shelf.id} data-directory-shelf={shelf.id}>
          <div class="section-head">
            <div>
              <h2>{shelf.title}</h2>
              <p class="meta">{shelf.intro}</p>
            </div>
            <p class="meta">{shelf.items.length} groups</p>
          </div>
          <ul class="directory">
            {shelf.items.map((item) => (
              <li data-directory-item data-search={item.search}>
                <a href={item.href} {...offsiteAttrs(item.href)}>
                  <strong>{item.name}</strong>
                  <em>{item.card.type}{item.card.members ? ` · ${item.card.members}` : ''}</em>
                  {item.card.note && <span class="note">{item.card.note}</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}

      <div class="section-head" id="pages" data-pages-head>
        <div>
          <p class="kicker">Follow</p>
          <h2>Pages</h2>
          <p class="meta">These are Facebook pages, not groups you request to join.</p>
        </div>
      </div>

      {pages.map((shelf) => (
        <section class="directory-shelf" id={shelf.id} data-directory-shelf={shelf.id} data-page-shelf>
          <div class="section-head">
            <div>
              <h2>{shelf.title}</h2>
              <p class="meta">{shelf.intro}</p>
            </div>
            <p class="meta">{shelf.items.length} pages</p>
          </div>
          <ul class="directory">
            {shelf.items.map((item) => (
              <li data-directory-item data-search={item.search}>
                <a href={item.href} {...offsiteAttrs(item.href)}>
                  <strong>{item.name}</strong>
                  <em>{item.card.type}{item.card.members ? ` · ${item.card.members}` : ''}</em>
                  {item.card.note && <span class="note">{item.card.note}</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </section>

    <p class="disclaimer">
      Names, privacy, and member counts come from <a href={directorySource}>this community list</a>.
      Counts change, and a private group may not let you in. Bastropia does not run these groups or pages, and a name here is not an endorsement.
      Official business — a burn ban, a polling place, a 911 call — still belongs on the county, the city, or the emergency line.
      Live posts are public Facebook pages only. Private groups are listed, not read. The feed refreshes about every 15 minutes.
    </p>
  </div>
</BaseLayout>

<script>
  const laneButtons = document.querySelectorAll<HTMLButtonElement>('#lane-filters [data-lane]');
  const feedCards = document.querySelectorAll<HTMLElement>('#feed-list [data-lane]');
  const feedEmpty = document.querySelector<HTMLElement>('#feed-empty');
  laneButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const lane = button.dataset.lane || 'all';
      laneButtons.forEach((chip) => chip.setAttribute('aria-pressed', chip === button ? 'true' : 'false'));
      let shown = 0;
      feedCards.forEach((card) => {
        const match = lane === 'all' || card.dataset.lane === lane;
        card.hidden = !match;
        if (match) shown += 1;
      });
      if (feedEmpty) feedEmpty.hidden = shown > 0;
    });
  });

  const query = document.querySelector<HTMLInputElement>('#directory-q');
  const shelfButtons = document.querySelectorAll<HTMLButtonElement>('#directory-filters [data-shelf]');
  const shelfSections = document.querySelectorAll<HTMLElement>('[data-directory-shelf]');
  const pagesHead = document.querySelector<HTMLElement>('[data-pages-head]');
  let shelf = 'all';

  function applyDirectory() {
    const needle = (query?.value ?? '').trim().toLowerCase();
    let pageShown = false;
    shelfSections.forEach((section) => {
      const id = section.dataset.directoryShelf || '';
      let shown = 0;
      section.querySelectorAll<HTMLElement>('[data-directory-item]').forEach((item) => {
        const haystack = item.dataset.search || '';
        const match = (shelf === 'all' || shelf === id) && (!needle || haystack.includes(needle));
        item.hidden = !match;
        if (match) shown += 1;
      });
      section.hidden = shown === 0;
      if (shown > 0 && section.hasAttribute('data-page-shelf')) pageShown = true;
    });
    if (pagesHead) pagesHead.hidden = !pageShown;
  }

  shelfButtons.forEach((button) => {
    button.addEventListener('click', () => {
      shelf = button.dataset.shelf || 'all';
      shelfButtons.forEach((chip) => chip.setAttribute('aria-pressed', chip === button ? 'true' : 'false'));
      applyDirectory();
    });
  });
  query?.addEventListener('input', applyDirectory);

  document.querySelectorAll<HTMLElement>('[data-timeline]').forEach((slot) => {
    const frame = slot.querySelector('iframe');
    const fallback = slot.querySelector<HTMLElement>('[data-timeline-fallback]');
    if (!frame || !fallback) return;
    const reveal = () => {
      frame.hidden = true;
      fallback.hidden = false;
    };
    frame.addEventListener('error', reveal);
    frame.addEventListener('load', () => {
      let doc: Document | null = null;
      try {
        doc = frame.contentDocument;
      } catch {
        return;
      }
      // Chrome returns null for a cross-origin Facebook plugin. That is a loaded embed.
      if (!doc) return;
      const text = (doc.body?.innerText || '').replace(/\s+/g, ' ').trim();
      if (!text || text.length < 80 || /log into facebook|refused to connect|something went wrong/i.test(text)) reveal();
    });
  });
</script>

<style>
  .hub {
    display: grid;
    gap: 1.6rem;
    margin-top: 0.4rem;
  }
  .hub-status { display: flex; flex-wrap: wrap; gap: 0.35rem 0.9rem; align-items: center; }
  .live-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--stop);
  }
  .live-badge i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--stop);
    box-shadow: 0 0 0 0 rgba(163, 48, 15, 0.45);
    animation: live-pulse 1.6s ease-out infinite;
  }
  @keyframes live-pulse {
    0% { box-shadow: 0 0 0 0 rgba(163, 48, 15, 0.45); }
    100% { box-shadow: 0 0 0 0.55rem rgba(163, 48, 15, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .live-badge i { animation: none; }
  }
  .hub-status .meta { margin: 0; }
  .feed-list { display: grid; gap: 0.75rem; margin-top: 0.8rem; }
  .post-card {
    background: var(--card);
    border: 1px solid var(--line);
    padding: 0.85rem 0.95rem 0.8rem;
    display: grid;
    gap: 0.45rem;
  }
  .post-card header { display: flex; gap: 0.7rem; align-items: center; }
  .post-card header .meta { margin: 0; }
  .post-card strong { font-family: var(--serif); font-weight: 600; font-size: 1.15rem; line-height: 1.15; }
  .post-card h3 { font-size: 1.25rem; }
  .post-card h3 a { text-decoration: none; }
  .post-card h3 a:hover { text-decoration: underline; text-underline-offset: 0.08em; }
  .avatar {
    width: 2.2rem;
    height: 2.2rem;
    flex: none;
    display: grid;
    place-items: center;
    color: #fff;
    font-weight: 700;
    background: var(--pine);
  }
  .avatar.safety { background: var(--stop); }
  .avatar.news { background: var(--river-deep); }
  .avatar.community { background: var(--sun-deep); }
  .excerpt {
    margin: 0;
    white-space: pre-wrap;
    display: -webkit-box;
    -webkit-line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post-card img {
    width: 100%;
    max-height: 280px;
    object-fit: cover;
    border-bottom: 4px solid var(--river);
  }
  .hub-side .section-head { margin-top: 0.2rem; }
  .hub-side .section-head + .section-head { margin-top: 1.4rem; }
  .side-list a { display: block; padding: 0.6rem 0; border-top: 1px solid var(--line); text-decoration: none; }
  .side-list strong { display: block; font-family: var(--serif); font-weight: 600; font-size: 1.12rem; line-height: 1.2; }
  .side-list a:hover strong { text-decoration: underline; text-underline-offset: 0.08em; }
  .side-list em { display: block; font-style: normal; color: var(--ink-soft); font-size: 0.88rem; }
  .video-row {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    padding-bottom: 0.35rem;
    scroll-snap-type: x mandatory;
  }
  .video-card {
    flex: 0 0 15rem;
    scroll-snap-align: start;
    text-decoration: none;
    display: grid;
    gap: 0.3rem;
  }
  .video-card img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-bottom: 4px solid var(--river); }
  .video-card strong { font-family: var(--serif); font-weight: 600; font-size: 1.05rem; line-height: 1.2; }
  .video-card em { font-style: normal; color: var(--ink-soft); font-size: 0.85rem; }
  .plugin-row { display: grid; gap: 0.8rem; margin-top: 0.6rem; }
  .timeline-slot { min-width: 0; background: #fff; border: 1px solid var(--line); }
  .timeline-slot iframe { display: block; width: 100%; height: 560px; border: 0; background: #fff; }
  .timeline-fallback { padding: 0.85rem 0.95rem 0.9rem; display: grid; gap: 0.45rem; background: var(--card); }
  .timeline-fallback .excerpt { -webkit-line-clamp: 8; }
  .directory-shelf { margin-top: 1.6rem; }
  [hidden] { display: none !important; }
  button.chip { appearance: none; border-radius: 0; }
  #directory-filters { margin-top: 0.8rem; }
  .search { margin-top: 0.8rem; }
  @media (min-width: 900px) {
    .hub { grid-template-columns: minmax(0, 1.7fr) minmax(16rem, 0.8fr); align-items: start; }
    .plugin-row { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .video-row { scroll-snap-type: none; }
  }
</style>
