---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import HomeBanner from '../components/HomeBanner.astro';
import { directoryShelves, directorySource } from '../data/facebookDirectory';
import { getBastropiaGroupPosts } from '../lib/facebookGroup';
import { offsiteAttrs } from '../lib/links';
import { facebookPage } from '../data/site';
import { TZ } from '../lib/time';

const posted = (date: Date) =>
  new Intl.DateTimeFormat('en-US', {
    timeZone: TZ,
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    hour: 'numeric',
    minute: '2-digit',
  }).format(date);

const pagePosts = await getBastropiaGroupPosts();

const pageIds = new Set(['news-pages', 'official', 'parties', 'nonprofits', 'places']);
const groups = directoryShelves.filter((shelf) => !pageIds.has(shelf.id));
const pages = directoryShelves.filter((shelf) => pageIds.has(shelf.id));
const total = directoryShelves.reduce((count, shelf) => count + shelf.items.length, 0);
---

<BaseLayout
  title="Social"
  description="Public Facebook groups and pages for Bastrop County — rooms to join and pages to follow."
>
  <PageHead
    kicker="Community"
    title="Social"
    lede="Public Facebook groups and pages around Bastrop County. A private group has to approve you before you can read it."
  />
  <div class="wrap">
    <section class="section" id="bastropia-page">
      <div class="section-head">
        <div>
          <p class="kicker">The page</p>
          <h2>From the Bastropia page</h2>
          <p class="meta">Public posts from the Bastropia Facebook page, newest first.</p>
        </div>
        <a href={facebookPage} {...offsiteAttrs(facebookPage)}>Open the page</a>
      </div>
      {pagePosts.length > 0 ? (
        <div class="group-posts">
          {pagePosts.map((post) => (
            <article>
              <p class="kicker">{post.author} · {posted(post.published)}</p>
              {post.text.split(/\n+/).filter(Boolean).map((paragraph) => <p>{paragraph}</p>)}
              <p class="more"><a href={post.url} {...offsiteAttrs(post.url)}>Read it on the page</a></p>
            </article>
          ))}
        </div>
      ) : (
        <p>The latest posts are on the <a class="text-link" href={facebookPage} {...offsiteAttrs(facebookPage)}>Bastropia Facebook page</a>.</p>
      )}
    </section>

    <div class="site-banner">
      <HomeBanner />
    </div>

    <p class="meta" id="directory">{total} Facebook rooms and pages. Member counts are approximate.</p>
    <nav class="filters" aria-label="Jump to a category">
      <div>
        <p class="kicker">Groups to join</p>
        <div class="filter-row">
          {groups.map((shelf) => (
            <a class="chip" href={`#${shelf.id}`}>{shelf.title}</a>
          ))}
        </div>
      </div>
      <div>
        <p class="kicker">Pages to follow</p>
        <div class="filter-row">
          {pages.map((shelf) => (
            <a class="chip" href={`#${shelf.id}`}>{shelf.title}</a>
          ))}
        </div>
      </div>
    </nav>

    {groups.map((shelf) => (
      <section class="section" id={shelf.id}>
        <div class="section-head">
          <div>
            <h2>{shelf.title}</h2>
            <p class="meta">{shelf.intro}</p>
          </div>
          <p class="meta">{shelf.items.length} groups</p>
        </div>
        <ul class="directory">
          {shelf.items.map((item) => (
            <li>
              <a href={item.href} rel="noopener">
                <strong>{item.name}</strong>
                <em>{item.detail}</em>
                {item.note && <span class="note">{item.note}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <div class="section-head" id="pages">
      <div>
        <p class="kicker">Follow</p>
        <h2>Pages</h2>
        <p class="meta">These are Facebook pages, not groups you request to join.</p>
      </div>
    </div>

    {pages.map((shelf) => (
      <section class="section" id={shelf.id}>
        <div class="section-head">
          <div>
            <h2>{shelf.title}</h2>
            <p class="meta">{shelf.intro}</p>
          </div>
          <p class="meta">{shelf.items.length} pages</p>
        </div>
        <ul class="directory">
          {shelf.items.map((item) => (
            <li>
              <a href={item.href} rel="noopener">
                <strong>{item.name}</strong>
                <em>{item.detail}</em>
                {item.note && <span class="note">{item.note}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <p class="disclaimer">
      Names, privacy, and member counts come from <a href={directorySource}>this community list</a>.
      Counts change, and a private group may not let you in. Bastropia does not run these groups or pages, and a name here is not an endorsement.
      Official business — a burn ban, a polling place, a 911 call — still belongs on the county, the city, or the emergency line.
    </p>
  </div>
</BaseLayout>

<style>
  .group-posts { display: grid; gap: 1.4rem; margin-top: 0.8rem; }
  .group-posts article { border-top: 3px solid var(--river); padding-top: 0.7rem; }
  .group-posts p { margin: 0.35rem 0 0; max-width: 42rem; }
  .group-posts .kicker { margin-top: 0; }
</style>
