---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { directoryShelves, directorySource } from '../data/facebookDirectory';
import { cities } from '../data/taxonomy';
import { formatMedium } from '../lib/time';

const pageIds = new Set(['news-pages', 'official', 'parties', 'nonprofits', 'places']);
const groups = directoryShelves.filter((shelf) => !pageIds.has(shelf.id));
const pages = directoryShelves.filter((shelf) => pageIds.has(shelf.id));
const total = directoryShelves.reduce((count, shelf) => count + shelf.items.length, 0);
const highlights = (await getCollection('social')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const towns = cities.filter((city) => city !== 'Countywide' && highlights.some((item) => item.data.city === city));
const topics = [...new Set(highlights.map((item) => item.data.topic).filter((topic): topic is string => Boolean(topic)))];
---

<BaseLayout
  title="Social"
  description="What neighbors are talking about in public Bastrop County groups, and the directory of groups and pages."
>
  <PageHead
    kicker="Community"
    title="Social"
    lede="A short read of public posts, then the directory. Each highlight opens the post it came from."
  />
  <div class="wrap">
    <section class="section" id="highlights" style="margin-top:0;">
      <div class="section-head">
        <h2>From public groups</h2>
        <a href="#directory">All groups</a>
      </div>
      {highlights.length === 0 ? (
        <p class="meta">No public posts are summarized yet. <a class="text-link" href="#directory">The group directory is below.</a></p>
      ) : (
        <div id="social-highlights">
          <label class="city-pick">
            <span class="sr">Town</span>
            <select id="social-city">
              <option value="">All county</option>
              {towns.map((city) => <option value={city}>{city}</option>)}
            </select>
          </label>
          <div class="filter-row" id="social-topics">
            <button class="chip" type="button" data-topic="" aria-current="true">All</button>
            {topics.map((topic) => <button class="chip" type="button" data-topic={topic}>{topic}</button>)}
          </div>
          <div class="news-list">
            {highlights.map((item) => (
              <article class="story-card" data-social data-city={item.data.city ?? ''} data-topic={item.data.topic ?? ''}>
                <a href={item.data.sourceUrl ?? item.data.groupUrl} rel="noopener">
                  <p class="kicker">{item.data.group} · {formatMedium(item.data.pubDate)}</p>
                  <h3>{item.data.title}</h3>
                  <p class="meta">{item.data.summary}</p>
                </a>
              </article>
            ))}
          </div>
          <p class="meta" id="social-none" hidden>Nothing in that town. <a class="text-link" href="#directory">See the groups</a>.</p>
          <script is:inline>
            (function () {
              const root = document.querySelector('#social-highlights');
              if (!root) return;
              const select = root.querySelector('#social-city');
              const cards = root.querySelectorAll('[data-social]');
              const empty = document.querySelector('#social-none');
              const topicButtons = root.querySelectorAll('[data-topic]');
              const key = 'bastropia-city';
              let topic = '';
              const known = new Set([...select.options].map((option) => option.value));
              let city = '';
              try { city = localStorage.getItem(key) || ''; } catch (error) { city = ''; }
              if (!known.has(city)) city = '';
              const apply = () => {
                select.value = city;
                let shown = 0;
                cards.forEach((card) => {
                  const cardCity = card.getAttribute('data-city') || '';
                  const cardTopic = card.getAttribute('data-topic') || '';
                  const cityOk = !city || cardCity === city || cardCity === 'Countywide';
                  const topicOk = !topic || cardTopic === topic;
                  const on = cityOk && topicOk;
                  card.hidden = !on;
                  if (on) shown += 1;
                });
                if (empty) empty.hidden = shown > 0;
              };
              apply();
              select.addEventListener('change', () => {
                city = select.value;
                try { localStorage.setItem(key, city); } catch (error) { /* private browsing */ }
                apply();
              });
              topicButtons.forEach((button) => {
                button.addEventListener('click', () => {
                  topic = button.getAttribute('data-topic') || '';
                  topicButtons.forEach((other) => other.removeAttribute('aria-current'));
                  button.setAttribute('aria-current', 'true');
                  apply();
                });
              });
            })();
          </script>
        </div>
      )}
      <p class="disclaimer">Summaries are from public Facebook groups and Pages only. Bastropia does not speak for these groups.</p>
    </section>

    <p class="meta" id="directory">{total} Facebook rooms and pages. A private group has to approve you before you can read it. Member counts are approximate.</p>
    <nav class="filters" aria-label="Jump to a category">
      <div>
        <p class="kicker">Groups to join</p>
        <div class="filter-row">
          {groups.map((shelf) => (
            <a class="chip" href={`#${shelf.id}`}>{shelf.title}</a>
          ))}
        </div>
      </div>
      <div>
        <p class="kicker">Pages to follow</p>
        <div class="filter-row">
          {pages.map((shelf) => (
            <a class="chip" href={`#${shelf.id}`}>{shelf.title}</a>
          ))}
        </div>
      </div>
    </nav>

    {groups.map((shelf) => (
      <section class="section" id={shelf.id}>
        <div class="section-head">
          <div>
            <h2>{shelf.title}</h2>
            <p class="meta">{shelf.intro}</p>
          </div>
          <p class="meta">{shelf.items.length} groups</p>
        </div>
        <ul class="directory">
          {shelf.items.map((item) => (
            <li>
              <a href={item.href} rel="noopener">
                <strong>{item.name}</strong>
                <em>{item.detail}</em>
                {item.note && <span class="note">{item.note}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <div class="section-head" id="pages">
      <div>
        <p class="kicker">Follow</p>
        <h2>Pages</h2>
        <p class="meta">These are Facebook pages, not groups you request to join.</p>
      </div>
    </div>

    {pages.map((shelf) => (
      <section class="section" id={shelf.id}>
        <div class="section-head">
          <div>
            <h2>{shelf.title}</h2>
            <p class="meta">{shelf.intro}</p>
          </div>
          <p class="meta">{shelf.items.length} pages</p>
        </div>
        <ul class="directory">
          {shelf.items.map((item) => (
            <li>
              <a href={item.href} rel="noopener">
                <strong>{item.name}</strong>
                <em>{item.detail}</em>
                {item.note && <span class="note">{item.note}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <p class="disclaimer">
      Names, privacy, and member counts come from <a href={directorySource}>this community list</a>.
      Counts change, and a private group may not let you in. Bastropia does not run these groups or pages, and a name here is not an endorsement.
      Official business — a burn ban, a polling place, a 911 call — still belongs on the county, the city, or the emergency line.
    </p>
  </div>
</BaseLayout>
