---
export const prerender = false;

import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import AdSlot from '../components/AdSlot.astro';
import { filterEvents } from '../lib/events';
import { eventKey, labelFromKey, monthGrid, monthTitle } from '../lib/time';

const events = await getCollection('events');
const today = eventKey(new Date());
const [todayYear, todayMonth] = today.split('-').map(Number);
const requested = Astro.url.searchParams.get('month');
const match = requested?.match(/^(\d{4})-(\d{2})$/);
const year = match ? Number(match[1]) : todayYear;
const month = match ? Number(match[2]) : todayMonth;
const title = monthTitle(year, month);
const cells = monthGrid(year, month);
const counts = new Map<string, number>();
for (const event of events) {
  const key = eventKey(event.data.start);
  counts.set(key, (counts.get(key) ?? 0) + 1);
}
const monthKey = `${year}-${String(month).padStart(2, '0')}`;
const monthEvents = filterEvents(events, { when: 'all' }).filter((event) => eventKey(event.data.start).startsWith(monthKey));
const previous = month === 1 ? `${year - 1}-12` : `${year}-${String(month - 1).padStart(2, '0')}`;
const next = month === 12 ? `${year + 1}-01` : `${year}-${String(month + 1).padStart(2, '0')}`;
const weekdays = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
---

<BaseLayout title="Calendar" description="A month view of what’s listed in Bastrop County.">
  <PageHead kicker="Month" title={title} lede="Pick a day. The number on it is how many listings the desk has, not how busy the town will be." />
  <div class="wrap">
    <div class="cluster" style="margin-top:0;">
      <a class="button button-ghost" href={`/calendar?month=${previous}`}>Previous</a>
      <a class="button button-ghost" href="/calendar">This month</a>
      <a class="button button-ghost" href={`/calendar?month=${next}`}>Next</a>
    </div>
    <div class="calendar" style="margin-top:1rem;">
      {weekdays.map((day) => <p class="dow">{day}</p>)}
      {cells.map((cell) => cell ? (
        <a class:list={[{ 'is-today': cell === today, has: counts.has(cell) }]} href={`/events?date=${cell}`}>
          <strong>{Number(cell.slice(-2))}</strong>
          {counts.has(cell) && <span>{counts.get(cell)}</span>}
        </a>
      ) : <p></p>)}
    </div>
    <section class="section">
      <h2>Listed in {title}</h2>
      <div class="card-list" style="margin-top:0.8rem;">
        {monthEvents.map((event) => (
          <a class="text-link" href={`/events/${event.id}`}>{labelFromKey(eventKey(event.data.start))} — {event.data.title}</a>
        ))}
        {!monthEvents.length && <p>Nothing is filed for this month yet.</p>}
      </div>
    </section>
    <AdSlot placement="calendar-sponsor" />
  </div>
</BaseLayout>
