---
export const prerender = false;

import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import { getExternalNews, latestHeadlines } from '../../lib/externalNews';
import { offsiteAttrs } from '../../lib/links';
import { linkList } from '../../lib/schema';
import { formatMedium } from '../../lib/time';

const stories = await getCollection('news');
const headlines = latestHeadlines(stories, await getExternalNews(24, 6));
---

<BaseLayout
  title="News"
  description="County desk notes on burn bans, public meetings, and what’s happening in Bastrop County."
  extra={[linkList('Bastropia news', stories.map((story) => ({ name: story.data.title, path: `/news/${story.id}` })))]}
>
  <PageHead kicker="Desk" title="News from Bastrop County" lede="Short briefings with a link back to the public source. This is a community desk, not a city hall feed." />
  <div class="wrap">
    <div class="news-list">
      {headlines.map((story) => (
        <article class="story-card">
          <a href={story.href} {...offsiteAttrs(story.href)}>
            <p class="kicker">{story.label} · {formatMedium(story.date)}</p>
            <h3>{story.title}</h3>
            {story.summary && <p class="meta">{story.summary}</p>}
          </a>
        </article>
      ))}
    </div>
    <p class="disclaimer">
      Headlines open on the site that published them. Bastropia does not write or edit them.
      FOX 7 Austin is pulled from its Bastrop County tag. Bastrop EDC news comes from its media-center feed. Both refresh about every ten minutes.
      The Statesman and KVUE block this server, so their stories are not listed here. The Bastrop Advertiser and the Smithville Times do not offer a feed.
      Rosanky, Tahitian Village, and The Colony have no paper of their own, so a story is marked with that place when a headline names it.
      A Community Impact headline about The Colony is marked Sponsored.
    </p>
  </div>
</BaseLayout>
