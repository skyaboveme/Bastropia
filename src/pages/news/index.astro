---
export const prerender = false;

import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getExternalNews, latestHeadlines } from '../../lib/externalNews';
import { linkList } from '../../lib/schema';
import { formatMedium } from '../../lib/time';

const stories = await getCollection('news');
const headlines = latestHeadlines(stories, await getExternalNews(24));
---

<BaseLayout
  title="News"
  description="County desk notes on burn bans, public meetings, and what’s happening in Bastrop County."
  extra={[linkList('Bastropia news', stories.map((story) => ({ name: story.data.title, path: `/news/${story.id}` })))]}
>
  <PageHead kicker="Desk" title="News from Bastrop County" lede="Short briefings with a link back to the public source. This is a community desk, not a city hall feed." />
  <div class="wrap">
    <div class="split">
      <div class="news-list">
        {headlines.map((story) => (
          <article class="story-card">
            <a href={story.href} rel={story.external ? 'noopener' : undefined}>
              <p class="kicker">{story.label} · {formatMedium(story.date)}</p>
              <h3>{story.title}</h3>
              {story.summary && <p class="meta">{story.summary}</p>}
            </a>
          </article>
        ))}
      </div>
      <AdSlot placement="news-rail" />
    </div>
    <p class="disclaimer">Headlines from Community Impact and KXAN open on their sites. Bastropia does not write or edit them.</p>
  </div>
</BaseLayout>
