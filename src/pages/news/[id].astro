---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MoreFromBastrop from '../../components/MoreFromBastrop.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import PlaceName from '../../components/PlaceName.astro';
import StoryGlance from '../../components/StoryGlance.astro';
import { authorBySlug, editorSlug, storyAuthor } from '../../data/authors';
import { listEvents } from '../../lib/eventSource';
import { filterEvents } from '../../lib/events';
import { imageSize } from '../../lib/imageSize';
import { relatedStories } from '../../lib/relatedStories';
import { newsNode } from '../../lib/schema';
import { formatLong } from '../../lib/time';

export async function getStaticPaths() {
  const stories = await getCollection('news');
  return stories.map((story) => ({ params: { id: story.id }, props: { story } }));
}

const { story } = Astro.props;
const { Content } = await render(story);
const [stories, { events }] = await Promise.all([getCollection('news'), listEvents()]);
const related = relatedStories(
  story.id,
  stories.map((item) => ({
    id: item.id,
    title: item.data.title,
    description: item.data.description,
    place: item.data.place,
    pubDate: item.data.pubDate,
    tags: item.data.tags,
  })),
);
const upcoming = filterEvents(events, { when: 'upcoming' }).slice(0, 3);
const photo = story.data.image ? imageSize(story.data.image) : undefined;
const writer = storyAuthor(story.id, story.data.author);
const editor = authorBySlug(editorSlug);
---

<BaseLayout
  title={story.data.title}
  description={story.data.description}
  image={story.data.image}
  imageAlt={story.data.imageAlt}
  pageType="NewsArticle"
  published={story.data.pubDate}
  modified={story.data.updated ?? story.data.pubDate}
  authorPath={`/authors/${writer.slug}`}
  section={story.data.place}
  extra={[newsNode(story, photo)]}
>
  <article class="wrap story">
    <header class="page-head story-top">
      <p class="kicker"><PlaceName name={story.data.place} /></p>
      <h1>{story.data.title}</h1>
      <p class="story-byline">
        By <a href={`/authors/${writer.slug}`}>{writer.name}</a>
        {editor && writer.slug !== editor.slug && (
          <> · Edited by <a href={`/authors/${editor.slug}`}>{editor.name}</a></>
        )}
      </p>
      <p class="story-dates">
        <time datetime={story.data.pubDate.toISOString()}>Published {formatLong(story.data.pubDate)}</time>
        {story.data.updated && (
          <> · <time datetime={story.data.updated.toISOString()}>Updated {formatLong(story.data.updated)}</time></>
        )}
      </p>
      <p class="lede">{story.data.description}</p>
    </header>
    {story.data.image && (
      <figure class="story-photo story-hero">
        <img
          class="event-photo"
          src={story.data.image}
          alt={story.data.imageAlt ?? story.data.title}
          width={photo?.width}
          height={photo?.height}
          decoding="async"
        />
        {story.data.imageCredit && <figcaption class="photo-credit">{story.data.imageCredit}</figcaption>}
      </figure>
    )}
    <StoryGlance stats={story.data.stats} keyFacts={story.data.keyFacts} />
    <div class="prose story-body">
      <Content />
      {story.data.sourceUrl && (
        <p class="story-credit">Source: <a href={story.data.sourceUrl}>{story.data.sourceLabel ?? 'Public source'}</a></p>
      )}
    </div>
    <MoreFromBastrop stories={related} events={upcoming} />
    <NewsletterSignup />
  </article>
</BaseLayout>

<script>
  const glanceLabels = new Set(['whats next', 'what happens next', 'timeline', 'at a glance']);

  function sectionLabel(element: Element): string {
    return (element.textContent || '').trim().toLowerCase().replace(/['’]/g, '');
  }

  function markStorySections() {
    const root = document.querySelector('.story-body');
    if (!root) return;
    const headings = root.querySelectorAll(':scope > p, :scope > h2, :scope > h3');
    headings.forEach((heading) => {
      const strong = heading.querySelector(':scope > strong');
      const text = (heading.textContent || '').trim();
      const onlyStrong = strong && text === (strong.textContent || '').trim();
      if (heading.tagName === 'P' && !onlyStrong) return;
      if (heading.tagName === 'P') heading.classList.add('story-subhead');
      const label = sectionLabel(heading);
      const next = heading.nextElementSibling;
      if (!next || (next.tagName !== 'UL' && next.tagName !== 'OL')) return;
      if (label === 'sources') next.classList.add('story-sources');
      else if (glanceLabels.has(label)) next.classList.add('story-timeline');
    });
    root.querySelectorAll('table').forEach((table) => {
      if (table.parentElement?.classList.contains('story-table')) return;
      const wrap = document.createElement('div');
      wrap.className = 'story-table';
      wrap.tabIndex = 0;
      table.replaceWith(wrap);
      wrap.appendChild(table);
    });
  }

  markStorySections();
</script>
