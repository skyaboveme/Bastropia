---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import FormError from '../components/FormError.astro';
import { placements } from '../data/commerce';
import { money } from '../lib/format';
import { addDays, eventKey } from '../lib/time';

const selected = Astro.url.searchParams.get('placement');
const start = addDays(eventKey(new Date()), 7);
const offers = Object.fromEntries(placements.map((item) => [item.id, { rate: item.rate, unit: item.unit }]));
const defaultRate = placements.find((item) => item.id === 'home-banner')?.rate ?? placements[0].rate;
---

<BaseLayout
  title="Advertise"
  description="Reach Bastrop County neighbors where they already look for weekends, news, and local plans. Reserve a labeled placement on Bastropia."
  banner={false}
>
  <PageHead
    kicker="Advertise with Bastropia"
    title="Show up where the county already looks"
    lede="New neighbors are moving in. They need a Saturday plan, a reliable trade, a place to eat after the game. Put your name on the desk they open first."
  />
  <div class="wrap advertise">
    <section class="ad-stats" aria-label="Bastrop County at a glance">
      <p>
        <strong>~119,000</strong>
        <span>residents in 2025</span>
      </p>
      <p>
        <strong>+21%</strong>
        <span>growth since 2020</span>
      </p>
      <p>
        <strong>Countywide</strong>
        <span>Bastrop to Smithville</span>
      </p>
    </section>

    <div class="prose ad-pitch">
      <p>
        Census estimates put Bastrop County among the fastest-growing places in the country. People are moving east of
        Austin for space and a town they can still name — and they still need a plumber, a landscaper, a church, a clinic,
        and a table for Friday night.
      </p>
      <p>
        They live on their phones. They check burn bans, weekend plans, scores, and meetings the way they used to flip a
        paper. Facebook groups are loud. Highway boards talk to cars that already passed. Bastropia is the quiet county
        desk they return to on purpose.
      </p>
    </div>

    <section class="ad-benefits" aria-label="Why advertise here">
      <h2>Why it works</h2>
      <div class="ad-benefit-grid">
        <article>
          <h3>Local intent</h3>
          <p>People land here for events, news, weather, and scores — then see your name next to the reason they came.</p>
        </article>
        <article>
          <h3>A growing market</h3>
          <p>New residents do not have a favorite HVAC tech or florist yet. The business that shows up first often keeps them.</p>
        </article>
        <article>
          <h3>Countywide without waste</h3>
          <p>One placement covers Bastrop, Elgin, Smithville, Cedar Creek, and the towns in between — not a metro buy priced for downtown Austin.</p>
        </article>
        <article>
          <h3>Trust that lasts</h3>
          <p>Ads are labeled Sponsored and stay off burn-ban and emergency pages. Readers can tell the desk from the sponsor.</p>
        </article>
        <article>
          <h3>Simple creative</h3>
          <p>Run of Site, Events, and Weekend banners share a clear 1200×500 frame. No agency stack required.</p>
        </article>
        <article>
          <h3>You own the click</h3>
          <p>Every ad opens your site, Eventbrite, or booking page. We invoice after you reserve. It goes live after payment.</p>
        </article>
      </div>
    </section>

    <section class="section ad-book" id="placements">
      <div class="section-head">
        <div>
          <p class="kicker">Reserve a spot</p>
          <h2>Pick a banner</h2>
        </div>
      </div>
      <p class="ad-book-lede">Tell us where you want to show up and when to start. We confirm the dates are open and send the invoice.</p>
      <FormError />
      <form id="ad-form" class="form" action="/api/intake" method="post">
        <input type="hidden" name="type" value="ad" />
        <input type="hidden" name="from" value="/advertise" />
        <input class="hp" type="text" name="company_website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="place-grid ad-places">
          {placements.map((placement) => (
            <label class="choice">
              <input type="radio" name="placement" value={placement.id} required checked={selected ? selected === placement.id : placement.id === 'home-banner'} />
              <p class="kicker">{placement.page} · {money(placement.rate)} / {placement.unit}</p>
              <h3>{placement.name}</h3>
              <p class="meta">{placement.where}</p>
              <p class="ad-place-detail">{placement.detail}</p>
            </label>
          ))}
        </div>
        <div class="fields">
          <label class="field">
            <span id="ad-span">Months</span>
            <input name="count" type="number" min="1" max="12" value="1" required />
          </label>
          <label class="field">
            <span>Start date</span>
            <input name="start" type="date" value={start} required />
          </label>
          <label class="field">
            <span>Business name</span>
            <input name="business" required maxlength="80" />
          </label>
          <label class="field">
            <span>Contact name</span>
            <input name="contact" required maxlength="80" autocomplete="name" />
          </label>
          <label class="field">
            <span>Email</span>
            <input name="email" type="email" required autocomplete="email" />
          </label>
          <label class="field">
            <span>Phone</span>
            <input name="phone" type="tel" autocomplete="tel" />
          </label>
          <label class="field wide">
            <span>Website the ad should open</span>
            <input name="website" type="url" required placeholder="https://" />
          </label>
          <label class="field wide">
            <span>Ad line, up to 90 characters</span>
            <input name="line" required maxlength="90" placeholder="Saturday produce on Main Street" />
          </label>
          <label class="field wide">
            <span>Notes</span>
            <textarea name="notes" rows="4" maxlength="1200" placeholder="Anything the desk should know. Political ads need the paid-for line in this box."></textarea>
          </label>
        </div>
        <p class="price-line">Estimated total <strong id="ad-total">{money(defaultRate)}</strong></p>
        <label>
          <input type="checkbox" name="terms" value="yes" required /> The ad will say Sponsored. It will not imitate the county, a city, or an emergency notice. I understand this reservation is invoiced by the desk and is not charged on this form.
        </label>
        <button class="button" type="submit">Reserve this placement</button>
      </form>
    </section>

    <p class="disclaimer">
      Population figures are U.S. Census Bureau county estimates (about 118,900 residents in 2025; roughly 21% growth from 2020 to 2025).
      Bastropia does not sell personal data. Ads are labeled and kept off emergency pages.
    </p>
  </div>
</BaseLayout>

<style>
  .advertise { padding-bottom: 2rem; }
  .ad-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 0 0 1.6rem;
    padding: 1rem 0 1.15rem;
    border-top: 4px solid var(--ink);
    border-bottom: 1px solid var(--line);
  }
  .ad-stats p { margin: 0; display: grid; gap: 0.15rem; }
  .ad-stats strong {
    font-family: var(--serif);
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    font-weight: 600;
    line-height: 1.05;
    color: var(--river-deep);
  }
  .ad-stats span {
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  .ad-pitch { max-width: 44rem; }
  .ad-benefits { margin-top: 2rem; }
  .ad-benefits > h2 {
    font-size: clamp(1.7rem, 3vw, 2.2rem);
    margin: 0 0 0.85rem;
    padding-top: 0.55rem;
    border-top: 4px solid var(--ink);
  }
  .ad-benefit-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.1rem 1.4rem;
  }
  .ad-benefit-grid article {
    padding-top: 0.7rem;
    border-top: 1px solid var(--line);
  }
  .ad-benefit-grid h3 {
    font-family: var(--serif);
    font-size: 1.35rem;
    font-weight: 600;
    margin: 0 0 0.35rem;
  }
  .ad-benefit-grid p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.45;
  }
  .ad-book { margin-top: 2.4rem; }
  .ad-book-lede {
    margin: 0 0 1rem;
    max-width: 40rem;
    color: var(--ink-soft);
  }
  .ad-places { grid-template-columns: repeat(3, 1fr); }
  .ad-places .choice h3 {
    font-family: var(--serif);
    font-size: 1.55rem;
    font-weight: 600;
    margin: 0.2rem 0 0.35rem;
  }
  .ad-place-detail { margin: 0.45rem 0 0; font-size: 0.98rem; line-height: 1.4; }
  .advertise .disclaimer { margin-top: 1.6rem; }
  @media (max-width: 900px) {
    .ad-stats,
    .ad-benefit-grid,
    .ad-places { grid-template-columns: 1fr; }
  }
</style>

<script define:vars={{ offers }}>
  const form = document.querySelector('#ad-form');
  const total = document.querySelector('#ad-total');
  const span = document.querySelector('#ad-span');
  const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
  const update = () => {
    if (!(form instanceof HTMLFormElement) || !total) return;
    const data = new FormData(form);
    const offer = offers[String(data.get('placement'))] || { rate: 0, unit: 'month' };
    const count = Math.min(12, Math.max(1, Number(data.get('count')) || 1));
    if (span) span.textContent = offer.unit === 'weekend' ? 'Weekends' : 'Months';
    total.textContent = money.format(offer.rate * count);
  };
  form?.addEventListener('input', update);
  update();
</script>
