function weekdayOf(key: string) {
  const [year, month, day] = key.split('-').map(Number);
  return new Date(Date.UTC(year, month - 1, day, 18)).getUTCDay();
}

function onDay(offer: Offer, key: string) {
  return offer.days.includes(weekdayOf(key)) && (!offer.from || key >= offer.from) && (!offer.until || key <= offer.until);
}

function groupsOn(key: string) {
  return places
    .map((place) => ({ place, offers: place.offers.filter((offer) => onDay(offer, key)) }))
    .filter((group) => group.offers.length > 0);
}

const todayKey = chicagoParts(new Date()).key;
const tomorrowKey = addDays(todayKey, 1);
const upcoming = [
  { when: 'Today', key: todayKey, groups: groupsOn(todayKey) },
  { when: 'Tomorrow', key: tomorrowKey, groups: groupsOn(tomorrowKey) },
].filter((day) => day.groups.length > 0);

const cities = ['Bastrop', 'Elgin', 'Smithville'];

