---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { directoryEntries, type DirectoryEntry } from '../data/directory';
import { listLiveBusinesses, toDirectoryEntry } from '../lib/businessDb';
import { addDays, chicagoParts, labelFromKey } from '../lib/time';
import { eatDayGroups, eatPlaces as places, offerOnDay as onDay, offerText, type EatPlace as Place, type Offer } from '../data/eatsSpecials';
import { eatDealList } from '../lib/schema';

const foodCategories = new Set([
  'Restaurants',
  'Food Trucks',
  'Bakeries / Baked Goods',
  'Coffee / Beverage Shops',
  'Wineries / Wine Shops / Breweries',
]);

const countyTowns = ['Bastrop', 'Elgin', 'Smithville', 'Cedar Creek', 'McDade', 'Paige', 'Rosanky'];

function norm(value: string) {
  return value
    .toLowerCase()
    .replace(/&/g, ' and ')
    .replace(/[^a-z0-9]+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}

function samePlace(a: string, b: string) {
  const left = norm(a);
  const right = norm(b);
  return left === right || left.startsWith(`${right} `) || right.startsWith(`${left} `);
}


function isFood(entry: DirectoryEntry) {
  if (foodCategories.has(entry.category)) return true;
  if (entry.category === 'Catering' && /chick-fil-a|southside/i.test(entry.name)) return true;
  if (entry.source === 'listed' && /restaurant|food|cafe|coffee|bakery|brew|winery|grill|bbq|bar|pizza|kitchen|diner|eatery/i.test(`${entry.category} ${entry.name}`)) return true;
  return false;
}

function inCounty(entry: DirectoryEntry) {
  return !`${entry.place} ${entry.town || ''}`.toLowerCase().includes('cedar park');
}

function townLabel(entry: DirectoryEntry) {
  if (entry.town && countyTowns.includes(entry.town)) return entry.town;
  const blob = entry.place.toLowerCase();
  for (const town of countyTowns) {
    if (blob.includes(town.toLowerCase())) return town;
  }
  if (blob.includes('lost pines')) return 'Lost Pines';
  return entry.town || 'Bastrop County';
}

function mark(name: string) {
  const words = name
    .replace(/[^A-Za-z0-9' ]/g, ' ')
    .split(/\s+/)
    .filter((word) => word && !/^(the|and|of|a)$/i.test(word));
  return ((words[0]?.[0] || '') + (words[1]?.[0] || '')).toUpperCase();
}

function specialEntry(place: Place): DirectoryEntry {
  const digits = (place.phone || '').replace(/\D/g, '');
  return {
    id: `special:${norm(place.name)}`,
    name: place.name,
    category: 'Restaurant',
    place: place.where || place.city,
    town: place.city,
    phone: place.phone,
    phoneHref: digits.length === 10 ? `tel:+1${digits}` : undefined,
    website: place.href,
    href: place.href,
    summary: '',
    source: 'chamber',
  };
}

let listed: DirectoryEntry[] = [];
try {
  listed = (await listLiveBusinesses()).map(toDirectoryEntry);
} catch {
  listed = [];
}

const seen = new Set<string>();
const directoryFood = [...listed, ...directoryEntries].filter((entry) => {
  if (!isFood(entry) || !inCounty(entry)) return false;
  const key = norm(entry.name);
  if (seen.has(key)) return false;
  seen.add(key);
  return true;
});

for (const place of places) {
  if (directoryFood.some((entry) => samePlace(entry.name, place.name))) continue;
  directoryFood.push(specialEntry(place));
}

const todayKey = chicagoParts(new Date()).key;
const tomorrowKey = addDays(todayKey, 1);
const town = Astro.url.searchParams.get('town');
const q = (Astro.url.searchParams.get('q') || '').trim().toLowerCase();
const dayGroups = (key: string) => eatDayGroups(key, town);
const dayBoards = [
  { key: todayKey, kicker: 'Today', groups: dayGroups(todayKey) },
  { key: tomorrowKey, kicker: 'Tomorrow', groups: dayGroups(tomorrowKey) },
].filter((board) => board.groups.length > 0);

const rows = directoryFood
  .map((entry) => {
    const special = places.find((place) => samePlace(place.name, entry.name));
    return {
      entry,
      town: townLabel(entry),
      today: special?.offers.filter((offer) => onDay(offer, todayKey)) ?? [],
      tomorrow: special?.offers.filter((offer) => onDay(offer, tomorrowKey)) ?? [],
    };
  })
  .filter((row) => !town || row.town === town)
  .sort((a, b) => {
    const rank = (row: { today: Offer[] }) => (row.today.length ? 0 : 1);
    const byDeal = rank(a) - rank(b);
    if (byDeal !== 0) return byDeal;
    return a.entry.name.localeCompare(b.entry.name);
  });

const townOptions = [...new Set(directoryFood.map((entry) => townLabel(entry)))].sort((a, b) => a.localeCompare(b));


function eatHay(name: string, category: string, townName: string, place: string, offers: Offer[]) {
  return `${name} ${category} ${townName} ${place} ${offers.map(offerText).join(' ')}`.toLowerCase();
}

const shownCount = rows.filter((row) => {
  const hay = eatHay(row.entry.name, row.entry.category, row.town, row.entry.place, [...row.today, ...row.tomorrow]);
  return !q || hay.includes(q);
}).length;
const boardShown = (groups: { place: Place; offers: Offer[] }[]) =>
  groups.filter((group) => !q || eatHay(group.place.name, '', group.place.city, group.place.where || '', group.offers).includes(q)).length;

function eatHref(nextTown: string | null) {
  const params = new URLSearchParams();
  if (nextTown) params.set('town', nextTown);
  if (q) params.set('q', q);
  const search = params.toString();
  return search ? `/eats?${search}` : '/eats';
}
---

<BaseLayout
  title="Eats"
  description="Happy hours and specials posted by restaurants and bars in Bastrop County, from each place’s own site."
  extra={dayBoards.map((board) => eatDealList(`${board.kicker}'s happy hours and specials`, board.groups))}
>
  <PageHead
    kicker="Specials"
    title="Eats"
    lede="Happy hours and specials for today and tomorrow are up top. The list below is restaurants, cafes, bakeries, and bars from the directory. Confirm before you go."
  />
  <div class="wrap">
    {dayBoards.length > 0 && (
      <div class="day-pair">
        {dayBoards.map((board) => (
          <section class="today-board day-board" aria-label={`${board.kicker}'s happy hours and specials`} hidden={boardShown(board.groups) === 0}>
            <p class="kicker">{board.kicker}</p>
            <h2>{labelFromKey(board.key)}</h2>
            <ul class="deal-list">
              {board.groups.map((group) => (
                <li class="deal" data-q={eatHay(group.place.name, '', group.place.city, group.place.where || '', group.offers)} hidden={Boolean(q) && !eatHay(group.place.name, '', group.place.city, group.place.where || '', group.offers).includes(q)}>
                  {group.offers.map((offer) => (
                    <div class="deal-block">
                      <p class="deal-what">{offer.what}</p>
                      {offer.time && <p class="deal-time">{offer.time}</p>}
                      {offer.discount?.map((line) => <p class="deal-off">{line}</p>)}
                      {offer.note && <p class="deal-note">{offer.note}</p>}
                    </div>
                  ))}
                  <p class="deal-place">{group.place.name}, {group.place.city}</p>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    )}
    <section class="board" aria-label="Find a place">
      <form class="looking" method="get" action="/eats" role="search">
        <label class="looking-label" for="q">Looking for</label>
        <div class="looking-bar">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
            <path d="M16 16.5 20.5 21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
          <input id="q" type="search" name="q" value={q} placeholder="tacos, coffee, Elgin" autocomplete="off" enterkeyhint="search" />
          <button class="looking-clear" type="button" aria-label="Clear search" hidden={!q}>×</button>
          {town ? <input type="hidden" name="town" value={town} /> : null}
        </div>
      </form>
    </section>
    <div class="filters">
      <div class="filter-row">
        <span>Town</span>
        <a class="chip" href={eatHref(null)} aria-current={town ? undefined : 'true'}>All</a>
        {townOptions.map((item) => (
          <a class="chip" href={eatHref(item)} aria-current={town === item ? 'true' : undefined}>{item}</a>
        ))}
      </div>
    </div>
    <p class="meta" id="eats-count">{shownCount} {shownCount === 1 ? 'place' : 'places'}. Places with a special today are first. Times are Central.</p>
    <p id="eats-empty" hidden={shownCount > 0}>Nothing matches that search.</p>
    <ul class="eat-list">
        {rows.map((row) => {
          const external = row.entry.href.startsWith('http');
          const hay = eatHay(row.entry.name, row.entry.category, row.town, row.entry.place, [...row.today, ...row.tomorrow]);
          const matched = !q || hay.includes(q);
          return (
            <li class="eat-row" data-q={hay} hidden={!matched}>
              <span class="eat-mark" aria-hidden="true">{mark(row.entry.name)}</span>
              <div>
                <a class="eat-name" href={row.entry.href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>{row.entry.name}</a>
                <span class="eat-line">{row.entry.category} · {row.town}</span>
                {row.entry.place && row.entry.place !== row.town && <span class="eat-line">{row.entry.place}</span>}
              </div>
              {row.today.length > 0 && (
                <div class="eat-special">
                  <p class="kicker">Today</p>
                  {row.today.map((offer) => (
                    <div class="deal-block">
                      <p class="deal-what">{offer.what}</p>
                      {offer.time && <p class="deal-time">{offer.time}</p>}
                      {offer.discount?.map((line) => <p class="deal-off">{line}</p>)}
                      {offer.note && <p class="deal-note">{offer.note}</p>}
                    </div>
                  ))}
                </div>
              )}
              {row.tomorrow.length > 0 && (
                <div class="eat-special">
                  <p class="kicker">Tomorrow</p>
                  {row.tomorrow.map((offer) => (
                    <div class="deal-block">
                      <p class="deal-what">{offer.what}</p>
                      {offer.time && <p class="deal-time">{offer.time}</p>}
                      {offer.discount?.map((line) => <p class="deal-off">{line}</p>)}
                      {offer.note && <p class="deal-note">{offer.note}</p>}
                    </div>
                  ))}
                </div>
              )}
              {(row.entry.phone || row.entry.website) && (
                <p class="eat-actions">
                  {row.entry.phoneHref ? <a href={row.entry.phoneHref}>{row.entry.phone}</a> : row.entry.phone}
                  {row.entry.website && (
                    <a href={row.entry.website} target="_blank" rel="noopener noreferrer">Website</a>
                  )}
                </p>
              )}
            </li>
          );
        })}
      </ul>
    <p class="disclaimer">
      Specials were read from each restaurant’s own site on November 15 and 16, 2026. A row with no deal had none posted. Weekly boards can change. Casa Chapala and Chapala Fiestas & Grill are two different restaurants. Back 9 Bar closed January 20, 2026. Stem & Stone closed in late 2025 and is now Espadas de Brazil. Leo’s Italian Grill in Cedar Creek closed July 8, 2026, and is now Lupita’s Kitchen. Send a correction — <a class="text-link" href="/tips">reader tips</a>.
    </p>
    <script is:inline>
      (function () {
        var input = document.getElementById('q');
        var clearButton = document.querySelector('.looking-clear');
        var count = document.getElementById('eats-count');
        var empty = document.getElementById('eats-empty');
        var boards = Array.prototype.slice.call(document.querySelectorAll('.day-board'));
        if (!input || !count || !empty) return;
        var rows = Array.prototype.slice.call(document.querySelectorAll('.eat-row'));
        var chips = Array.prototype.slice.call(document.querySelectorAll('.filters a.chip'));
        var hit = function (needle, text) {
          if (!needle) return true;
          return (text || '').indexOf(needle) !== -1;
        };
        var apply = function () {
          var value = input.value.trim().toLowerCase();
          if (clearButton) clearButton.hidden = !value;
          var url = new URL(location.href);
          if (value) url.searchParams.set('q', value);
          else url.searchParams.delete('q');
          history.replaceState(null, '', url);
          chips.forEach(function (link) {
            var next = new URL(link.href);
            if (value) next.searchParams.set('q', value);
            else next.searchParams.delete('q');
            link.href = next.pathname + next.search;
          });
          var shown = 0;
          rows.forEach(function (row) {
            var on = hit(value, row.getAttribute('data-q'));
            row.hidden = !on;
            if (on) shown += 1;
          });
          boards.forEach(function (board) {
            var dealsOn = 0;
            Array.prototype.forEach.call(board.querySelectorAll('.deal'), function (deal) {
              var on = hit(value, deal.getAttribute('data-q'));
              deal.hidden = !on;
              if (on) dealsOn += 1;
            });
            board.hidden = dealsOn === 0;
          });
          count.textContent = shown + ' ' + (shown === 1 ? 'place' : 'places') + '. Places with a special today are first. Times are Central.';
          empty.hidden = shown !== 0;
        };
        input.addEventListener('input', apply);
        if (clearButton) {
          clearButton.addEventListener('click', function () {
            input.value = '';
            input.focus();
            apply();
          });
        }
      })();
    </script>
  </div>
</BaseLayout>

<style>
  .board {
    margin: 0.2rem 0 1.2rem;
    padding: 1.1rem 1.1rem 0.95rem;
    background: #fff;
    border: 1px solid var(--line);
    border-top: 8px solid var(--pine-deep);
  }
  .looking { margin: 0; }
  .looking-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .looking-bar {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    min-height: 4.8rem;
    padding: 0.25rem 0.55rem 0.25rem 1.2rem;
    background: var(--paper);
    border: 3px solid var(--ink);
    border-radius: 999px;
  }
  .looking-bar:focus-within {
    outline: 3px solid color-mix(in srgb, var(--river) 55%, white);
    outline-offset: 2px;
  }
  .looking-bar svg {
    width: 1.7rem;
    height: 1.7rem;
    flex: none;
    color: var(--ink);
  }
  .looking-bar input {
    flex: 1 1 auto;
    min-width: 0;
    border: 0;
    background: transparent;
    font: inherit;
    font-size: clamp(1.15rem, 2.4vw, 1.55rem);
    padding: 0.85rem 0;
    color: var(--ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .looking-bar input:focus { outline: none; }
  .looking-bar input::-webkit-search-cancel-button { display: none; }
  .looking-clear {
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    font-size: 1.45rem;
    line-height: 1;
    cursor: pointer;
  }
  .looking-clear:hover { background: var(--paper-2); }
  .looking-clear[hidden] { display: none; }
  .eat-row[hidden],
  .today-board[hidden],
  .deal[hidden] { display: none !important; }
  @media (max-width: 640px) {
    .board { padding: 0.85rem 0.75rem 0.75rem; }
  }
</style>
