---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { addDays, chicagoParts, labelFromKey } from '../lib/time';

type Deal = {
  place: string;
  city: string;
  text: string;
  days: number[];
  from?: string;
  until?: string;
};

const week = { from: '2026-11-16', until: '2026-11-22' };

const deals: Deal[] = [
  { place: 'Bastrop Beer Company', city: 'Bastrop', days: [2, 3, 4, 5], text: 'Happy hour 3:00–6:00 p.m. $1 off pints, domestic beer, and wines. 10% off all to-go craft beer.' },
  { place: 'Casa Chapala', city: 'Bastrop', days: [1, 2, 3, 4], text: 'Happy hour 11:00 a.m.–7:00 p.m. $4 draft pints, $6 Casa Rita, $3.50 cantina tacos, and $6 shareable plates.' },
  { place: 'Casa Chapala', city: 'Bastrop', days: [1], text: 'Kids eat free all day. Conditions were not posted. Lunch buffet $15.99, 11:00 a.m.–2:00 p.m., includes a drink.' },
  { place: 'Casa Chapala', city: 'Bastrop', days: [0, 1, 2, 3, 4, 5, 6], text: 'Patio Rita, any flavor, all day.' },
  { place: 'Casa Chapala', city: 'Bastrop', days: [0], text: 'Sunday brunch buffet, 9:00 a.m.–3:00 p.m.' },
  { place: 'Chapala Fiestas & Grill', city: 'Bastrop', days: [1], ...week, text: 'Happy hour all day, 11:00 a.m.–10:00 p.m. Prices not posted.' },
  { place: 'Chapala Fiestas & Grill', city: 'Bastrop', days: [2], ...week, text: 'Happy hour all day, listed as 11:00 p.m.–10:00 p.m. Call before you plan on it. Prices not posted.' },
  { place: 'Chapala Fiestas & Grill', city: 'Bastrop', days: [3], ...week, text: 'Margaritas, food, wine, and beer, 11:00 a.m.–10:00 p.m. Prices not posted.' },
  { place: 'Chapala Fiestas & Grill', city: 'Bastrop', days: [4], ...week, text: 'Happy hour all day, 11:00 a.m.–10:00 p.m. Prices not posted.' },
  { place: 'Chapala Fiestas & Grill', city: 'Bastrop', days: [5], ...week, text: 'Happy hour all day, 11:00 a.m.–11:00 p.m. Prices not posted.' },
  { place: 'Chapala Fiestas & Grill', city: 'Bastrop', days: [6], ...week, text: 'Happy hour all day, 10:00 a.m.–11:00 p.m. Prices not posted.' },
  { place: 'Chapala Fiestas & Grill', city: 'Bastrop', days: [0], ...week, text: 'Happy hour all day, 10:00 a.m.–9:00 p.m. Prices not posted.' },
  { place: "Chili's Grill & Bar", city: 'Bastrop', days: [1, 2, 3, 4, 5], text: 'Happy hour 3:00–6:00 p.m. $3 to $5 selected beers and house wine, $6 margarita of the month, $7 tequila classic margarita.' },
  { place: 'Film Alley Bastrop', city: 'Bastrop', days: [4], text: 'Happy hour 12:00–7:00 p.m. Half-price arcade, half-price bowling, and half-price domestic pints.' },
  { place: "Maxine's Cafe & Bakery", city: 'Bastrop', days: [1], ...week, text: 'Lunch special 11:00 a.m.–3:00 p.m. The dish name was not on the board.' },
  { place: "Maxine's Cafe & Bakery", city: 'Bastrop', days: [2], ...week, text: 'Loaded potato soup, 11:00 a.m.–3:00 p.m.' },
  { place: "Maxine's Cafe & Bakery", city: 'Bastrop', days: [3], ...week, text: 'Homestyle chili and cornbread, 11:00 a.m.–3:00 p.m.' },
  { place: "Maxine's Cafe & Bakery", city: 'Bastrop', days: [4], ...week, text: 'Personal chicken pot pie, 11:00 a.m.–3:00 p.m.' },
  { place: "Maxine's Cafe & Bakery", city: 'Bastrop', days: [5], ...week, text: 'Broccoli cheese soup served over rice, 11:00 a.m.–3:00 p.m. Breakfast until 5:00 p.m.' },
  { place: "Maxine's Cafe & Bakery", city: 'Bastrop', days: [6], ...week, text: 'Breakfast till 5:00 p.m., 7:00 a.m.–5:00 p.m.' },
  { place: "Maxine's Cafe & Bakery", city: 'Bastrop', days: [0], ...week, text: 'Breakfast all day, 7:00 a.m.–3:00 p.m.' },
  { place: 'Old Town Restaurant & Bar', city: 'Bastrop', days: [1], ...week, text: 'Catfish basket, 11:00 a.m.–10:00 p.m. Happy hour 3:00–7:00 p.m., $1 off all drinks.' },
  { place: 'Old Town Restaurant & Bar', city: 'Bastrop', days: [2], ...week, text: 'Chicken parmesan, 11:00 a.m.–10:00 p.m. Happy hour 3:00–7:00 p.m.: $3 Bud Light and Ziegenbock drafts, and $1 off all drinks.' },
  { place: 'Old Town Restaurant & Bar', city: 'Bastrop', days: [3], ...week, text: 'Chicken fried steak and $1 wings, 11:00 a.m.–10:00 p.m. Well Wednesday 3:00–7:00 p.m.: $4.50 well drinks and $1 off all.' },
  { place: 'Old Town Restaurant & Bar', city: 'Bastrop', days: [4], ...week, text: 'Meatloaf dinner, 11:00 a.m.–10:00 p.m. No happy hour is listed.' },
  { place: 'Old Town Restaurant & Bar', city: 'Bastrop', days: [5], ...week, text: 'New York strip, 11:00 a.m.–10:00 p.m. No happy hour is listed.' },
  { place: 'Piney Creek Chop House', city: 'Bastrop', days: [1, 2, 3, 4], text: 'Happy hour 5:00–7:00 p.m. $7 martinis and discounted appetizers.' },
  { place: "Lightnin' Bar", city: 'Elgin', days: [2, 3, 4, 5], text: 'Happy hour 2:00–6:00 p.m. Prices are not posted.' },
  { place: 'Smithville Brewing Company', city: 'Smithville', days: [3], text: '55 and older: 50% off an entree with the purchase of a beverage.' },
  { place: 'Smithville Brewing Company', city: 'Smithville', days: [4], text: '$5 pints and $2 off pizzas.' },
  { place: 'Smithville Brewing Company', city: 'Smithville', days: [0], text: 'Happy hour all day. $2 off appetizers and $1 off bottles and cans. Live music 4:00–6:00 p.m. Exclusions apply.' },
];

function weekdayOf(key: string) {
  const [year, month, day] = key.split('-').map(Number);
  return new Date(Date.UTC(year, month - 1, day, 18)).getUTCDay();
}

function dealsOn(key: string) {
  const day = weekdayOf(key);
  const rows = deals.filter((deal) => deal.days.includes(day) && (!deal.from || key >= deal.from) && (!deal.until || key <= deal.until));
  const grouped: { place: string; city: string; text: string }[] = [];
  for (const deal of rows) {
    const last = grouped.at(-1);
    if (last && last.place === deal.place) last.text = `${last.text} ${deal.text}`;
    else grouped.push({ place: deal.place, city: deal.city, text: deal.text });
  }
  return grouped;
}

const todayKey = chicagoParts(new Date()).key;
const tomorrowKey = addDays(todayKey, 1);
const upcoming = [
  { when: 'Today', key: todayKey, deals: dealsOn(todayKey) },
  { when: 'Tomorrow', key: tomorrowKey, deals: dealsOn(tomorrowKey) },
];

const checked = [
  {
    city: 'Bastrop',
    names:
      '602 Brewing Company, Iron Bridge Icehouse (the site says it is closed to the public), Copper Shot Distillery, Espadas de Brazil (a bar happy hour is mentioned, with no current times or prices), Roadhouse Bastrop, LongHorn Steakhouse (a national Prime Time deal was not confirmed at this store), Paw Paw’s Catfish House, Gracie’s, Anita’s, Billy’s Pit BBQ, Guadalajara, Las Cocinas, Costa Azul, Jalisco, Kyoto Sushi, Volcano Sushi, Numero 28, Bassano, Texas Grill, LAB C Food Kitchen, Southside Market, First Watch, Toasted Yolk, Crust Pizza Co., CC Wine & Co., Chestnut Grove Food Truck Court, and the Hyatt Lost Pines restaurants.',
  },
  {
    city: 'Elgin',
    names:
      'Southside Market & BBQ, Meyer’s Elgin Smokehouse, Jalisco, Morelia Mexican Grill, Millie’s on Main (a map listing flags a happy hour, and no times or deals were on the restaurant’s site), Napolis Italian Bistro II, Little Beijing, El Maguey, Chemn Cafe, and Valentina’s.',
  },
  {
    city: 'Smithville',
    names: 'Quinto Patio, El Mexicano Grill, and Serenity Star Comfort Cafe.',
  },
  {
    city: 'Cedar Creek and Wyldwood',
    names:
      'Lupita’s Kitchen Bar & Grill (1525 Highway 71 and 887 Highway 21), Jalisco Cedar Creek, Little Mac’s Smokehouse, and Benny’s Texas BBQ.',
  },
  {
    city: 'Paige, McDade, Red Rock, and Rosanky',
    names:
      'The Farmhouse Kitchen, Rising Sun Vineyard, Scales’ Cafe, The Fat Friar, Red Rock Steakhouse Saloon & Venue, and 5R Restaurant & Dancehall.',
  },
];
---

<BaseLayout
  title="Eats"
  description="Happy hours and specials posted by restaurants and bars in Bastrop County, from each place’s own site."
>
  <PageHead
    kicker="Specials"
    title="Eats"
    lede="Happy hours and specials posted on a restaurant or bar’s own site. Compiled November 15, 2026. The weekly boards were read again November 16. Confirm before you go. A kids-eat-free or senior deal often has conditions that are not on the page."
  />
  <div class="wrap">
    <section class="day-pair" aria-label="Today and tomorrow">
      {upcoming.map((day) => (
        <article class="detail-main">
          <p class="kicker">{day.when}</p>
          <h2>{labelFromKey(day.key)}</h2>
          {day.deals.length ? (
            <ul>
              {day.deals.map((deal) => (
                <li>
                  <strong>{deal.place}</strong>, {deal.city}. {deal.text}
                </li>
              ))}
            </ul>
          ) : (
            <p>Nothing posted for this day.</p>
          )}
        </article>
      ))}
    </section>
    <p class="meta">Times are Central. Casa Chapala and Chapala Fiestas & Grill are two different restaurants. Weekly boards are for November 16–22 and can change.</p>

    <h2>Bastrop</h2>
    <div class="card-list">
      <article class="detail-main">
        <p class="kicker">Beer bar · Official site</p>
        <h3>Bastrop Beer Company</h3>
        <p>1008 Main Street, Bastrop, TX 78602 · <a href="tel:+15125493722">512-549-3722</a></p>
        <p>Happy hour Tuesday–Friday, 3:00–6:00 p.m. $1 off pints, domestic beer, and wines. 10% off all to-go craft beer.</p>
        <p class="meta"><a href="https://bastropbeerco.com/">bastropbeerco.com</a></p>
      </article>

      <article class="detail-main">
        <p class="kicker">Mexican · Official menu, November 15</p>
        <h3>Casa Chapala</h3>
        <p>1800 Walnut Street, Bastrop</p>
        <p>Happy hour Monday–Thursday, 11:00 a.m.–7:00 p.m. The menu page listed $4 draft pints, a $6 Casa Rita, $3.50 cantina tacos, and $6 shareable plates.</p>
        <p>Kids eat free all day. The conditions were not posted. Lunch buffet $15.99, 11:00 a.m.–2:00 p.m., and it includes a drink.</p>
        <p>The same menu page also posts Patio Rita, any flavor, all day, and a Sunday brunch buffet from 9:00 a.m. to 3:00 p.m.</p>
        <p class="meta"><a href="https://bastrop.casachapala.com/food-menu">Casa Chapala Bastrop menu</a></p>
      </article>

      <article class="detail-main">
        <p class="kicker">Mexican · Official site · Prices not posted</p>
        <h3>Chapala Fiestas & Grill</h3>
        <p>An all-day happy hour is posted. The specials page does not list prices. This is the week of November 16, as written on the site.</p>
        <ul>
          <li>Monday, November 16: happy hour all day, 11:00 a.m.–10:00 p.m.</li>
          <li>Tuesday, November 17: happy hour all day, listed as 11:00 p.m.–10:00 p.m. That start time is what the page says. Call before you plan on it.</li>
          <li>Wednesday, November 18: margaritas, food, wine, and beer, 11:00 a.m.–10:00 p.m.</li>
          <li>Thursday, November 19: happy hour all day, 11:00 a.m.–10:00 p.m.</li>
          <li>Friday, November 20: happy hour all day, 11:00 a.m.–11:00 p.m.</li>
          <li>Saturday, November 21: happy hour all day, 10:00 a.m.–11:00 p.m.</li>
          <li>Sunday, November 22: happy hour all day, 10:00 a.m.–9:00 p.m.</li>
        </ul>
        <p class="meta"><a href="https://chapalafiestas.com/bastrop-chapala-fiestas-and-grill-happy-hours-specials">Chapala Fiestas specials</a></p>
      </article>

      <article class="detail-main">
        <p class="kicker">American · Official location page</p>
        <h3>Chili’s Grill & Bar</h3>
        <p>734 Highway 71, Bastrop, TX 78602 · <a href="tel:+15123322644">(512) 332-2644</a></p>
        <p>Happy hour Monday–Friday, 3:00–6:00 p.m.</p>
        <ul>
          <li>$3: Bud Light 16 oz, Miller Lite 16 oz, Coors Light 16 oz</li>
          <li>$4: Bud Light 22 oz, Modelo 16 oz, Miller Lite 22 oz, Coors Light 22 oz, Michelob Ultra 16 oz</li>
          <li>$5: Modelo 22 oz, house red and white wine, Michelob Ultra 22 oz</li>
          <li>$6: margarita of the month</li>
          <li>$7: tequila classic margarita</li>
        </ul>
        <p class="meta"><a href="https://www.chilis.com/locations/us/texas/bastrop/bastrop">Chili’s Bastrop</a></p>
      </article>

      <article class="detail-main">
        <p class="kicker">Bowling and arcade · Official promotion</p>
        <h3>Film Alley Bastrop</h3>
        <p>1600 Chestnut Street, Bastrop, TX 78602</p>
        <p>Thursdays, 12:00–7:00 p.m. Half-price arcade, half-price bowling, and half-price domestic pints.</p>
        <p class="meta"><a href="https://filmalley.com/events/71116-happy-hour/">Film Alley happy hour</a></p>
      </article>

      <article class="detail-main">
        <p class="kicker">Cafe · This week’s lunch board</p>
        <h3>Maxine’s Cafe & Bakery</h3>
        <p>No standing happy hour. Call <a href="tel:+15123030919">512-303-0919</a>. These are the specials posted for the week of November 16, and they can change.</p>
        <ul>
          <li>Monday, November 16, 11:00 a.m.–3:00 p.m. The dish name was not on the board. The November 15 read called that lunch Remix Monday.</li>
          <li>Tuesday: loaded potato soup, 11:00 a.m.–3:00 p.m.</li>
          <li>Wednesday: homestyle chili and cornbread, 11:00 a.m.–3:00 p.m.</li>
          <li>Thursday: personal chicken pot pie, 11:00 a.m.–3:00 p.m.</li>
          <li>Friday: broccoli cheese soup served over rice, 11:00 a.m.–3:00 p.m. Breakfast is served until 5:00 p.m.</li>
          <li>Saturday: breakfast till 5:00 p.m., 7:00 a.m.–5:00 p.m.</li>
          <li>Sunday: breakfast all day, 7:00 a.m.–3:00 p.m.</li>
        </ul>
        <p class="meta"><a href="https://maxinescafe.com/specials">Maxine’s specials</a></p>
      </article>

      <article class="detail-main">
        <p class="kicker">American · This week’s board</p>
        <h3>Old Town Restaurant & Bar</h3>
        <p>931 Main Street, Bastrop · <a href="tel:+15123211171">(512) 321-1171</a></p>
        <p>Dinner specials run 11:00 a.m.–10:00 p.m. Happy hour, where it is listed, is 3:00–7:00 p.m. This is the week of November 16, and it can change.</p>
        <ul>
          <li>Monday: catfish basket. Happy hour is $1 off all drinks.</li>
          <li>Tuesday: chicken parmesan. Happy hour is $3 Bud Light and Ziegenbock drafts, and $1 off all drinks.</li>
          <li>Wednesday: chicken fried steak and $1 wings. Well Wednesday is $4.50 well drinks and $1 off all.</li>
          <li>Thursday: meatloaf dinner. No happy hour is listed.</li>
          <li>Friday: New York strip. No happy hour is listed.</li>
        </ul>
        <p>Saturday and Sunday are not on the specials page.</p>
        <p class="meta"><a href="https://oldtownbastroptx.com/bastrop-old-town-restaurant-and-bar-happy-hours-specials">Old Town specials</a></p>
      </article>

      <article class="detail-main">
        <p class="kicker">Steakhouse · Official site</p>
        <h3>Piney Creek Chop House</h3>
        <p>703 Chestnut Street, Bastrop · <a href="tel:+15123212135">(512) 321-2135</a></p>
        <p>Monday–Thursday, 5:00–7:00 p.m. $7 martinis and discounted appetizers. Friday, Saturday, and Sunday are not on the specials page.</p>
        <p class="meta"><a href="https://pineycreektx.com/bastrop-downtown-bastrop-piney-creek-chop-house-happy-hours-specials">Piney Creek specials</a></p>
      </article>

      <article class="detail-main">
        <p class="kicker">New American · Hours posted, deals not posted</p>
        <h3>Store House Market & Eatery</h3>
        <p>Wednesday–Friday, 5:00–10:00 p.m. is posted. The deals for those hours are not.</p>
        <p class="meta"><a href="https://storehousebastrop.com/">storehousebastrop.com</a></p>
      </article>

      <article class="detail-main">
        <p class="kicker">Steakhouse · Prices did not display</p>
        <h3>Texas Roadhouse</h3>
        <p>The Bastrop location page names Early Dine and Wild West Wednesday. The prices did not display, so there is nothing to list until they do.</p>
        <p class="meta"><a href="https://www.texasroadhouse.com/locations/bastrop">Texas Roadhouse Bastrop</a></p>
      </article>
    </div>

    <h2>Elgin</h2>
    <div class="card-list">
      <article class="detail-main">
        <p class="kicker">Bar · Official site · Prices not posted</p>
        <h3>Lightnin’ Bar</h3>
        <p>109 Central Ave. Unit B, Elgin, TX 78621</p>
        <p>Happy hour Tuesday–Friday, 2:00–6:00 p.m. The site does not list the prices.</p>
        <p class="meta"><a href="https://www.lightninbartexas.com/">lightninbartexas.com</a></p>
      </article>
    </div>

    <h2>Smithville</h2>
    <div class="card-list">
      <article class="detail-main">
        <p class="kicker">Brewery · Official site</p>
        <h3>Smithville Brewing Company</h3>
        <ul>
          <li>Wednesday: 55 and older, 50% off an entree with the purchase of a beverage.</li>
          <li>Thursday: $5 pints and $2 off pizzas.</li>
          <li>Sunday: live music 4:00–6:00 p.m., and happy hour all day. $2 off appetizers and $1 off bottles and cans. Exclusions apply.</li>
        </ul>
        <p class="meta"><a href="https://www.smithvillebrewing.com/">smithvillebrewing.com</a></p>
      </article>
    </div>

    <h2>Checked, and nothing was posted</h2>
    <p>
      The November 15 pass looked at about 85 places. These had no advertised special or happy hour on their own sites that day. A Facebook or Instagram post can still be running. No standing deal was found in Cedar Creek, Paige, McDade, Red Rock, Rosanky, or Wyldwood.
    </p>
    {checked.map((group) => (
      <p>
        <strong>{group.city}.</strong> {group.names}
      </p>
    ))}
    <p>
      The same pass counted six more listings that came from a chamber page, Facebook, or an aggregator. Those rows were not in the printed directory, so they are not on this page.
    </p>
    <p class="disclaimer">
      Back 9 Bar closed January 20, 2026. Stem & Stone closed in late 2025 and is now Espadas de Brazil. Leo’s Italian Grill in Cedar Creek closed July 8, 2026, and is now Lupita’s Kitchen. Fore Fun Saloon is planned for the old Back 9 space and was not confirmed open. Send a correction if a board has changed — <a class="text-link" href="/tips">reader tips</a>.
    </p>
  </div>
</BaseLayout>
