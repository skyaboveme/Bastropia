---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { forecastTowns, getAlerts, getForecast, isTown, weatherLabel, type TownName } from '../lib/weather';
import { labelFromKey } from '../lib/time';

const requested = Astro.url.searchParams.get('town');
const town: TownName = isTown(requested) ? requested : 'Bastrop';
const forecast = await getForecast(town);
const alerts = await getAlerts();
---

<BaseLayout title="Weather" description="Current conditions and the week ahead for towns in Bastrop County, plus National Weather Service alerts.">
  <PageHead
    kicker="Sky"
    title={`${town} weather`}
    lede="Conditions at the county seat are not the conditions in Smithville or Cedar Creek. Pick the town you are actually standing in."
  />
  <div class="wrap">
    <div class="filter-row">
      {Object.keys(forecastTowns).map((name) => (
        <a class="chip" href={`/weather?town=${encodeURIComponent(name)}`} aria-current={name === town ? 'true' : undefined}>{name}</a>
      ))}
    </div>
    {forecast ? (
      <>
        <section class="notice" style="margin-top:1rem;">
          <p class="kicker" style="color: var(--river);">Right now</p>
          <h2>{forecast.temp}° and {weatherLabel(forecast.code).toLowerCase()}</h2>
          <p class="lede" style="color:#d5e4dc;">Feels like {forecast.feels}°. Humidity {forecast.humidity}%. Wind {forecast.wind} mph.</p>
        </section>
        <section class="section">
          <h2>Next seven days</h2>
          <div class="forecast" style="margin-top:0.8rem;">
            {forecast.daily.map((day) => (
              <article>
                <p class="kicker">{labelFromKey(day.date)}</p>
                <strong>{day.high}°</strong>
                <p class="meta">Low {day.low}°</p>
                <p class="meta">{weatherLabel(day.code)}</p>
                <p class="meta">{day.rain}% rain</p>
              </article>
            ))}
          </div>
        </section>
      </>
    ) : (
      <p class="lede">The forecast did not load. Try the <a class="text-link" href="https://www.weather.gov/ewx/">Austin/San Antonio weather office</a>.</p>
    )}
    <section class="section">
      <h2>Bastrop County alerts</h2>
      <div class="card-list" style="margin-top:0.8rem;">
        {alerts === null && <p>Alerts could not be loaded from the National Weather Service.</p>}
        {alerts && !alerts.length && <p>No active National Weather Service alerts for Bastrop County.</p>}
        {alerts?.map((alert) => (
          <article class="alert">
            <p class="kicker">{alert.severity}</p>
            <h3>{alert.event}</h3>
            <p>{alert.headline}</p>
          </article>
        ))}
      </div>
      <p class="meta" style="margin-top:0.8rem;"><a class="text-link" href="https://www.weather.gov/ewx/">National Weather Service, Austin/San Antonio</a></p>
    </section>
  </div>
</BaseLayout>
