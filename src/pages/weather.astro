---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import county from '../data/bastropCounty.json';
import { forecastTowns, getAlerts, getCountySpots, getForecast, isTown, rainAmount, weatherLabel, type TownName } from '../lib/weather';
import { labelFromKey } from '../lib/time';

const requested = Astro.url.searchParams.get('town');
const town: TownName = isTown(requested) ? requested : 'Bastrop';
const [forecast, alerts, spots] = await Promise.all([getForecast(town), getAlerts(), getCountySpots()]);
const mapData = JSON.stringify({
  county,
  selected: town,
  towns: spots,
});
---

<BaseLayout
  title={`${town} weather`}
  description={`Current conditions and the week ahead for ${town}, a radar map of Bastrop County, and National Weather Service alerts.`}
  canonicalPath={town === 'Bastrop' ? '/weather' : `/weather?town=${encodeURIComponent(town)}`}
>
  <PageHead
    kicker="Sky"
    title={`${town} weather`}
    lede="Conditions at the county seat are not the conditions in Smithville or Cedar Creek. Pick the town you are actually standing in."
  />
  <div class="wrap" data-banner-end>
    <div class="filter-row">
      {Object.keys(forecastTowns).map((name) => (
        <a class="chip" href={`/weather?town=${encodeURIComponent(name)}`} aria-current={name === town ? 'true' : undefined}>{name}</a>
      ))}
    </div>
    {forecast ? (
      <>
        <section class="notice" style="margin-top:1rem;">
          <p class="kicker" style="color: var(--river);">Right now</p>
          <h2>{forecast.temp}° and {weatherLabel(forecast.code).toLowerCase()}</h2>
          <p class="lede" style="color:#d5e4dc;">Feels like {forecast.feels}°. Humidity {forecast.humidity}%. Wind {forecast.wind} mph.</p>
        </section>
        <section class="section">
          <h2>Next seven days</h2>
          <div class="forecast" style="margin-top:0.8rem;">
            {forecast.daily.map((day) => (
              <article>
                <p class="kicker">{labelFromKey(day.date)}</p>
                <strong>{day.high}°</strong>
                <p class="meta">Low {day.low}°</p>
                <p class="meta">{weatherLabel(day.code)}</p>
                <p class="meta">{day.rain}% chance</p>
                <p class="meta">{rainAmount(day.inches)}</p>
              </article>
            ))}
          </div>
        </section>
      </>
    ) : (
      <p class="lede">The forecast did not load. Try the <a class="text-link" href="https://www.weather.gov/ewx/">Austin/San Antonio weather office</a>.</p>
    )}
    <section class="section" aria-label="Bastrop County weather map">
      <h2>Over the county</h2>
      <p class="map-note">Live radar on the Bastrop County line, with the temperature in each town.</p>
      <div id="county-map" class="county-map">The county map is loading.</div>
      <p class="meta map-credit">Radar from the National Weather Service. The outline is Bastrop County, Texas.</p>
      <script type="application/json" id="county-map-data" set:html={mapData} />
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" />
      <script is:inline src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"></script>
      <script is:inline>
        const mapEl = document.getElementById('county-map');
        const raw = document.getElementById('county-map-data');
        if (!mapEl || !raw || !window.L) {
          if (mapEl) mapEl.textContent = 'The county map did not load.';
        } else {
          const data = JSON.parse(raw.textContent || '{}');
          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          mapEl.textContent = '';
          const map = L.map(mapEl, {
            scrollWheelZoom: false,
            zoomAnimation: !reduce,
            fadeAnimation: !reduce,
          });
          map.setView([30.15, -97.32], 10);
          L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}', {
            maxZoom: 16,
            attribution: 'Tiles &copy; Esri',
          }).addTo(map);
          L.tileLayer('https://mesonet.agron.iastate.edu/cache/tile.py/1.0.0/nexrad-n0q-900913/{z}/{x}/{y}.png', {
            opacity: 0.72,
            attribution: 'Radar: NWS / Iowa Environmental Mesonet',
          }).addTo(map);
          const outline = L.geoJSON(data.county, {
            smoothFactor: 0,
            style: { color: '#0b3a4a', weight: 2.5, fillColor: '#0b3a4a', fillOpacity: 0.08, smoothFactor: 0 },
          }).addTo(map);
          const place = {
            Elgin: 'top',
            McDade: 'left',
            Paige: 'right',
            Bastrop: 'right',
            'Cedar Creek': 'left',
            Smithville: 'bottom',
          };
          for (const spot of data.towns || []) {
            const on = spot.town === data.selected;
            const marker = L.circleMarker([spot.latitude, spot.longitude], {
              radius: on ? 8 : 6,
              color: '#10281f',
              weight: 2,
              fillColor: on ? '#e2a31b' : '#fbfaf6',
              fillOpacity: 1,
            }).addTo(map);
            const weather = spot.temp == null ? '' : `${spot.temp}°${spot.label ? ` ${spot.label}` : ''}`;
            marker.bindTooltip([spot.town, weather].filter(Boolean).join(' · '), {
              permanent: true,
              direction: place[spot.town] || 'top',
              offset: place[spot.town] === 'bottom' ? [0, 8] : [0, -8],
              className: 'town-tip',
            });
          }
          map.fitBounds(outline.getBounds(), { padding: [36, 36] });
          map.setMaxBounds(outline.getBounds().pad(0.6));
        }
      </script>
    </section>
    <section class="section">
      <h2>Bastrop County alerts</h2>
      <div class="card-list" style="margin-top:0.8rem;">
        {alerts === null && <p>Alerts could not be loaded from the National Weather Service.</p>}
        {alerts && !alerts.length && <p>No active National Weather Service alerts for Bastrop County.</p>}
        {alerts?.map((alert) => (
          <article class="alert">
            <p class="kicker">{alert.severity}</p>
            <h3>{alert.event}</h3>
            <p>{alert.headline}</p>
          </article>
        ))}
      </div>
      <p class="meta" style="margin-top:0.8rem;"><a class="text-link" href="https://www.weather.gov/ewx/">National Weather Service, Austin/San Antonio</a></p>
    </section>
  </div>
</BaseLayout>

<style>
  .map-note { margin: 0.35rem 0 0; color: var(--ink-soft); }
  .county-map {
    height: min(32rem, 70vh);
    min-height: 22rem;
    margin-top: 0.75rem;
    border: 1px solid var(--line);
    background: var(--paper-2);
  }
  .map-credit { margin-top: 0.45rem; }
  :global(.town-tip) {
    background: #fbfaf6;
    border: 1px solid #10281f;
    color: #10281f;
    border-radius: 0;
    box-shadow: none;
    font-weight: 650;
    font-size: 0.78rem;
  }
  :global(.town-tip::before) { border-top-color: #10281f; }
</style>
