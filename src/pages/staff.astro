---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { authors } from '../data/authors';
---

<BaseLayout
  title="Staff"
  description="Masthead for Bastropia: editor Michael Smith and reporter Ben Caxton, the newsroom for Bastrop County."
>
  <PageHead
    kicker="Masthead"
    title="Who writes Bastropia"
    lede="Michael Smith is the editor. Ben Caxton is the reporter. A story names one of them."
  />
  <div class="wrap prose">
    <p>
      Bastropia is a community desk for Bastrop County, Texas. It collects the weekend, the burn ban, the weather, public meetings, and short news notes. It is not a government newsroom.
    </p>
    {authors.length > 0 ? (
      <>
        <h2>Reporters</h2>
        <ul>
          {authors.map((author) => (
            <li>
              <a href={`/authors/${author.slug}`}>{author.name}</a>
              {author.jobTitle ? `, ${author.jobTitle}` : ''}. {author.description}
            </li>
          ))}
        </ul>
      </>
    ) : (
      <p>No reporter is listed by name yet.</p>
    )}
    <p>
      The <a href="/editorial-policy">editorial policy</a> is how the newsroom reports. The <a href="/corrections-policy">corrections policy</a> says how a wrong fact gets fixed. <a href="/contact">Contact</a> is the newsroom email, the tip form, and the event form. There is no newsroom phone number on this page.
    </p>
    <p><a href="/about">About Bastropia</a> says what the site covers and what it does not.</p>
  </div>
</BaseLayout>
