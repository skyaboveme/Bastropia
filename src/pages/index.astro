---
export const prerender = false;

import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import ExternalNews from '../components/ExternalNews.astro';
import CountyFeeds from '../components/CountyFeeds.astro';
import { getExternalNews, latestHeadlines } from '../lib/externalNews';
import { offsiteAttrs } from '../lib/links';
import { siteDescription } from '../data/site';
import { electionDay } from '../data/vote';
import { townByName, townPath } from '../data/towns';
import { footballSchools, getFridayScores } from '../lib/fridayScores';
import { readTown, townCookie } from '../lib/townChoice';
import { eventNode, linkList, newsNode } from '../lib/schema';
import { categoryMeta, cities } from '../data/taxonomy';
import { streams } from '../data/streams';
import { capOrganizer, filterEvents, sortByDayThenTier, sortByTier } from '../lib/events';
import { activeUpgrades, resolveTier } from '../lib/intake';
import { eventKey, formatMedium, labelFromKey, thisWeekendKeys, whenLabel } from '../lib/time';
const now = new Date();
const today = eventKey(now);
const homeTown = readTown(Astro.cookies.get(townCookie)?.value);
const homePage = homeTown ? townByName(homeTown) : undefined;
const weekend = thisWeekendKeys(now);
const upgrades = await activeUpgrades(today);
const events = await getCollection('events');
const tierOf = (event: (typeof events)[number]) => resolveTier(event.id, event.data.tier, upgrades);
const todayEvents = capOrganizer(filterEvents(events, { when: 'today' }, now));
const weekendEvents = filterEvents(events, { when: 'weekend' }, now);
const upcoming = filterEvents(events, { when: 'upcoming' }, now);
const picks = capOrganizer(
  sortByTier(
    upcoming.filter((event) => eventKey(event.data.start) > weekend[weekend.length - 1] && event.data.category !== 'government'),
    tierOf,
  ),
).slice(0, 4);
const boosted = picks.some((event) => tierOf(event) !== 'community');
const byTime = <T extends { data: { pubDate: Date } }>(a: T, b: T) => b.data.pubDate.getTime() - a.data.pubDate.getTime();
const notices = (await getCollection('updates')).sort(byTime);
const news = await getCollection('news');
const [externalNews, scores] = await Promise.all([
  getExternalNews(20, 5),
  homePage?.football.length ? getFridayScores() : Promise.resolve([]),
]);
const homeScores = (homePage ? scores.filter((score) => homePage.football.includes(score.id)) : []).map((score) => ({
  ...score,
  mascot: footballSchools.find((school) => school.id === score.id)?.mascot ?? '',
}));
const headlines = latestHeadlines(news, externalNews);
const shownEvents = new Set([...todayEvents, ...weekendEvents, ...picks].map((event) => event.id));
const hiddenStories = new Set(['/news/burn-ban-clear']);
if (shownEvents.has('boo-bash')) hiddenStories.add('/news/boo-bash-halloween');
let pageHeadlines = headlines.filter((story) => !hiddenStories.has(story.href));
if (today <= electionDay) {
  const election = pageHeadlines.find((story) => story.href === '/news/election-day-tuesday');
  if (election) pageHeadlines = [election, ...pageHeadlines.filter((story) => story.href !== election.href)];
}
if (today === '2026-11-05') {
  const careAVan = pageHeadlines.find((story) => story.href === '/news/care-a-van-lost-pines-elementary-nov-5-2026');
  if (careAVan) pageHeadlines = [careAVan, ...pageHeadlines.filter((story) => story.href !== careAVan.href)];
}
const lead = pageHeadlines[0];
const secondary = pageHeadlines.slice(1, 3);
const briefs = pageHeadlines.slice(3, 7);
const shown = new Set(pageHeadlines.slice(0, 7).map((story) => story.href));
const unused = externalNews.filter((story) => !shown.has(story.link));
const seenSources = new Set(externalNews.filter((story) => shown.has(story.link)).map((story) => story.source.id));
const around = [];
for (const story of unused) {
  if (seenSources.has(story.source.id)) continue;
  around.push(story);
  seenSources.add(story.source.id);
  if (around.length === 4) break;
}
for (const story of unused) {
  if (around.length === 4) break;
  if (around.some((item) => item.link === story.link)) continue;
  around.push(story);
}
const featuredCities = [
  ...cities.filter((city) => city !== 'Countywide'),
  ...[...new Set(pageHeadlines.map((story) => story.place))].filter(
    (place) => place !== 'Countywide' && !cities.includes(place as (typeof cities)[number]),
  ),
];
const featuredNews = [
  { city: '', items: pageHeadlines.slice(0, 4) },
  ...featuredCities.map((city) => ({ city, items: pageHeadlines.filter((story) => story.place === city).slice(0, 4) })),
];
const townCounts = cities
  .filter((city) => city !== 'Countywide')
  .map((city) => ({ city, count: upcoming.filter((event) => event.data.city === city).length }));
const weekendShown = weekend.flatMap((day) =>
  capOrganizer(weekendEvents.filter((event) => eventKey(event.data.start) === day)),
);
const listed = [...todayEvents, ...weekendShown, ...picks].filter(
  (event, index, all) => all.findIndex((item) => item.id === event.id) === index,
);
const deskStories = pageHeadlines
  .slice(0, 7)
  .filter((story) => !story.external)
  .map((story) => news.find((item) => `/news/${item.id}` === story.href))
  .filter((story) => story !== undefined);
---

<BaseLayout
  title="Bastropia"
  description={siteDescription}
  extra={[
    linkList('Events on the front page', listed.map((event) => ({ name: event.data.title, path: `/events/${event.id}` }))),
    ...listed.map((event) => eventNode(event)),
    ...deskStories.map((story) => newsNode(story)),
  ]}
>
  <div class="wrap home-stack">
    <section class="front" aria-label="Front page">
      <div class="col col-lead">
        {lead && (
          <article class="story-lead">
            <p class="kicker">{lead.label} · {formatMedium(lead.date)}</p>
            <h1><a href={lead.href} {...offsiteAttrs(lead.href)}>{lead.title}</a></h1>
            {lead.summary && <p class="dek">{lead.summary}</p>}
            <p class="more"><a href={lead.href} {...offsiteAttrs(lead.href)}>Read the story</a></p>
          </article>
        )}
        <div class="story-pair">
          {secondary.map((story) => (
            <article class="story-sub">
              <p class="kicker">{story.label} · {formatMedium(story.date)}</p>
              <h2><a href={story.href} {...offsiteAttrs(story.href)}>{story.title}</a></h2>
              {story.summary && <p class="dek">{story.summary}</p>}
            </article>
          ))}
        </div>
      </div>

      <aside class="col col-left" aria-label="More headlines">
        <h2 class="col-title">More headlines</h2>
        {briefs.map((story) => (
          <article class="brief">
            <p class="kicker">{story.label} · {formatMedium(story.date)}</p>
            <h3><a href={story.href} {...offsiteAttrs(story.href)}>{story.title}</a></h3>
          </article>
        ))}
        {notices.filter((notice) => notice.id !== 'outdoor-burning-status').slice(0, 3).map((notice) => (
          <article class="brief">
            <p class="kicker">Public notice · {notice.data.agency}</p>
            <h3><a href={`/government/${notice.id}`}>{notice.data.title}</a></h3>
          </article>
        ))}
        <p class="more"><a href="/news">All news</a></p>
      </aside>

      <aside class="col col-right" aria-label="Today in the county">
        <label class="city-pick">
          <span class="sr">Your town</span>
          <select id="home-town">
            <option value="">All county</option>
            {townCounts.map((item) => <option value={item.city} selected={item.city === homeTown}>{item.city}</option>)}
          </select>
        </label>
        <h2 class="col-title">{homeTown ? `Today in ${homeTown}` : 'Today in Bastrop County'}</h2>
        {(homeTown ? todayEvents.filter((event) => event.data.city === homeTown) : todayEvents).length ? (
          <ul class="agenda">
            {(homeTown ? todayEvents.filter((event) => event.data.city === homeTown) : todayEvents).map((event) => (
              <li class={`tier-${tierOf(event)}`}>
                <a href={`/events/${event.id}`}>
                  <span class="when">{whenLabel(event.data.schedule, event.data.start, event.data.end)}</span>
                  <strong>{event.data.title}</strong>
                  <span class="where">{event.data.city}</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="meta">{homeTown ? `Nothing is listed in ${homeTown} today.` : 'Nothing is listed for today.'} <a class="text-link" href="/submit">Add something</a>.</p>
        )}
        <p class="more"><a href={homeTown ? townPath(homeTown) : '/events?when=today'}>{homeTown ? `This week in ${homeTown}` : 'Full agenda'}</a></p>
        {homeTown && homePage?.football.length ? (
          <div>
            <h2 class="col-title">{homeTown} football</h2>
            {homeScores.length ? (
              <ul class="agenda">
                {homeScores.map((score) => (
                  <li>
                    <a href="/scores">
                      <span class="when">{score.next?.when ?? score.last?.when ?? score.when}</span>
                      <strong>
                        {score.next
                          ? `${score.next.side === 'Away' ? '@' : 'vs'} ${score.next.opponent}`
                          : `${score.school} ${score.schoolScore}–${score.opponentScore}`}
                      </strong>
                      <span class="where">
                        {score.last
                          ? `${score.last.result === 'won' ? 'W' : score.last.result === 'lost' ? 'L' : 'T'} ${score.last.schoolScore}–${score.last.opponentScore} ${score.last.opponent}`
                          : 'Upcoming'}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="meta">The latest final is not on the school page right now.</p>
            )}
          </div>
        ) : null}

        <div class="wx" id="featured-news">
          <h2 class="col-title">Featured news by city</h2>
          <label class="city-pick">
            <span class="sr">City</span>
            <select id="featured-city">
              <option value="">All county</option>
              {featuredCities.map((city) => <option value={city}>{city}</option>)}
            </select>
          </label>
          {featuredNews.map((panel) => (
            <div data-city-panel={panel.city} hidden={panel.city !== homeTown}>
              {panel.items.length ? (
                <ul class="featured-news">
                  {panel.items.map((story) => (
                    <li>
                      <a href={story.href} {...offsiteAttrs(story.href)}>
                        <em>{story.label}</em>
                        <strong>{story.title}</strong>
                      </a>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="meta">No recent headline names {panel.city}.</p>
              )}
            </div>
          ))}
          <script is:inline>
            (function () {
              const key = 'bastropia-city';
              const select = document.querySelector('#featured-city');
              const panels = document.querySelectorAll('[data-city-panel]');
              if (!select || !panels.length) return;
              const known = new Set([...select.options].map((option) => option.value));
              let saved = '';
              try {
                saved = localStorage.getItem(key) || '';
              } catch (error) {
                saved = '';
              }
              if (!known.has(saved)) saved = '';
              const show = (city) => {
                select.value = city;
                panels.forEach((panel) => {
                  panel.hidden = panel.getAttribute('data-city-panel') !== city;
                });
              };
              show(saved);
              const remember = (city) => {
                try { localStorage.setItem(key, city); } catch (error) { /* private browsing */ }
                document.cookie = city
                  ? key + '=' + encodeURIComponent(city) + '; path=/; max-age=31536000; SameSite=Lax'
                  : key + '=; path=/; max-age=0; SameSite=Lax';
                location.reload();
              };
              const homeTown = document.querySelector('#home-town');
              if (homeTown) {
                homeTown.value = saved;
                homeTown.addEventListener('change', () => remember(homeTown.value));
              }
              select.addEventListener('change', () => remember(select.value));
            })();
          </script>
        </div>
      </aside>
    </section>

    <div class="home-around">
      <ExternalNews items={around} allNews />
    </div>

    <section class="section home-weekend">
      <div class="section-head">
        <h2>This weekend</h2>
        <a href="/this-weekend">Friday to Sunday</a>
      </div>
      <div class="weekend-grid">
        {weekend.map((day) => {
          const items = sortByDayThenTier(
            weekendEvents.filter((event) => eventKey(event.data.start) === day && (!homeTown || event.data.city === homeTown)),
            tierOf,
          );
          return (
            <section class="day-card">
              <p class="kicker">{labelFromKey(day)}</p>
              {capOrganizer(items).map((event) => <EventCard event={event} tier={tierOf(event)} compact />)}
              {!items.length && <p class="meta">Nothing listed.</p>}
            </section>
          );
        })}
      </div>
    </section>

    <section class="section split">
      <div>
        <div class="section-head">
          <h2>{boosted ? 'Featured events' : 'Coming up'}</h2>
          <a href="/upgrade">Upgrade a listing</a>
        </div>
        <div class="card-list">
          {picks.map((event) => <EventCard event={event} tier={tierOf(event)} />)}
          {!picks.length && <p class="meta">Nothing further out is listed yet.</p>}
        </div>
      </div>
      <div>
        <div class="section-head">
          <h2>By town</h2>
          <a href="/events">All events</a>
        </div>
        <ul class="towns">
          {townCounts.map((item) => (
            <li>
              <a href={townPath(item.city)}>
                <span>{item.city}</span>
                <em>{item.count ? `${item.count} upcoming` : 'No public calendar yet'}</em>
              </a>
            </li>
          ))}
        </ul>
        <p class="meta topics">
          {Object.entries(categoryMeta).map(([id, item]) => (
            <a class="text-link" href={`/events?category=${id}`}>{item.label}</a>
          ))}
        </p>
      </div>
    </section>

    <section class="section split">
      <div>
        <div class="section-head">
          <h2>Government and public notices</h2>
          <a href="/government">Services and contacts</a>
        </div>
        <div class="news-list">
          {notices.slice(0, 4).map((notice) => (
            <article class="update-card">
              <a href={`/government/${notice.id}`}>
                <p class="kicker">{notice.data.agency} · {formatMedium(notice.data.pubDate)}</p>
                <h3>{notice.data.title}</h3>
                <p class="meta">{notice.data.description}</p>
              </a>
            </article>
          ))}
        </div>
      </div>
      <div>
        <div class="section-head">
          <h2>Live and meetings</h2>
          <a href="/videos">Videos</a>
        </div>
        <div class="stream-list">
          {streams.slice(0, 4).map((stream) => {
            const next = stream.dates?.find((date) => date >= today);
            return (
              <article class="stream">
                <p class="kicker">{stream.host}{next === today ? ' · Meets today' : ''}</p>
                <h3><a href={stream.href}>{stream.name}</a></h3>
                <p class="meta">{next ? labelFromKey(next) : stream.schedule}</p>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <CountyFeeds allFeeds />

    <section class="band newsletter" id="newsletter">
      <div>
        <p class="kicker">Weekly</p>
        <h2>Sign up for our weekly newsletter</h2>
        <p class="dek">Be in the know about everything happening in Bastrop County.</p>
      </div>
      <form class="form" data-newsletter-form action="https://app.kit.com/forms/9966284/subscriptions" method="post">
        <label class="field">
          <span>Email</span>
          <input name="email_address" type="email" required autocomplete="email" />
        </label>
        <button class="button" type="submit">Sign up</button>
      </form>
    </section>
  </div>

  <dialog class="newsletter-pop" id="newsletter-pop" aria-labelledby="newsletter-pop-title">
    <button class="newsletter-dismiss" type="button" data-newsletter-dismiss aria-label="Close">×</button>
    <p class="kicker">Weekly</p>
    <h2 id="newsletter-pop-title">Sign up for our weekly newsletter</h2>
    <p class="dek">Be in the know about everything happening in Bastrop County.</p>
    <form class="form" data-newsletter-form action="https://app.kit.com/forms/9966284/subscriptions" method="post">
      <label class="field">
        <span>Email</span>
        <input name="email_address" type="email" required autocomplete="email" />
      </label>
      <button class="button" type="submit">Sign up</button>
    </form>
    <button class="newsletter-later" type="button" data-newsletter-dismiss>Not now</button>
  </dialog>

  <script is:inline>
    const storageKey = 'bastropia-newsletter';
    const dialog = document.querySelector('#newsletter-pop');
    const band = document.querySelector('#newsletter');
    let joined = false;
    let skip = location.hash === '#newsletter';

    const readChoice = () => {
      try {
        const raw = localStorage.getItem(storageKey);
        return raw ? JSON.parse(raw) : null;
      } catch {
        return null;
      }
    };

    const remember = (status) => {
      try {
        localStorage.setItem(storageKey, JSON.stringify({ status, at: Date.now() }));
      } catch {
        /* private browsing can block storage */
      }
    };

    const choice = readChoice();
    if (choice && choice.status === 'joined') skip = true;
    if (choice && choice.status === 'dismissed' && choice.at && Date.now() - choice.at < 14 * 24 * 60 * 60 * 1000) skip = true;

    document.querySelectorAll('[data-newsletter-form]').forEach((form) => {
      form.addEventListener('submit', () => {
        joined = true;
        remember('joined');
      });
    });

    const dismiss = () => {
      if (dialog && dialog.open) dialog.close();
    };

    document.querySelectorAll('[data-newsletter-dismiss]').forEach((button) => {
      button.addEventListener('click', dismiss);
    });

    if (dialog) {
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dismiss();
      });
      dialog.addEventListener('close', () => {
        if (!joined) remember('dismissed');
      });
    }

    if (band && 'IntersectionObserver' in window) {
      const seen = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) skip = true;
      }, { threshold: 0.45 });
      seen.observe(band);
    }

    window.setTimeout(() => {
      if (skip || !dialog || dialog.open || document.querySelector('dialog[open]')) return;
      dialog.showModal();
    }, 6000);
  </script>
</BaseLayout>
