---
export const prerender = false;

import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import AdSlot from '../components/AdSlot.astro';
import ExternalNews from '../components/ExternalNews.astro';
import VideoSection from '../components/VideoSection.astro';
import { getExternalNews } from '../lib/externalNews';
import { burnBan } from '../data/burnBan';
import { siteDescription } from '../data/site';
import { categoryMeta, cities } from '../data/taxonomy';
import { streams } from '../data/streams';
import { filterEvents, sortByTier } from '../lib/events';
import { activeUpgrades, resolveTier } from '../lib/intake';
import { eventKey, formatMedium, labelFromKey, thisWeekendKeys, whenLabel } from '../lib/time';
import { getForecast, weatherLabel } from '../lib/weather';

const now = new Date();
const today = eventKey(now);
const weekend = thisWeekendKeys(now);
const upgrades = await activeUpgrades(today);
const events = await getCollection('events');
const tierOf = (event: (typeof events)[number]) => resolveTier(event.id, event.data.tier, upgrades);
const todayEvents = filterEvents(events, { when: 'today' }, now);
const weekendEvents = filterEvents(events, { when: 'weekend' }, now);
const upcoming = filterEvents(events, { when: 'upcoming' }, now);
const picks = sortByTier(
  upcoming.filter((event) => eventKey(event.data.start) > weekend[2] && event.data.category !== 'government'),
  tierOf,
).slice(0, 4);
const boosted = picks.some((event) => tierOf(event) !== 'community');
const byTime = <T extends { data: { pubDate: Date } }>(a: T, b: T) => b.data.pubDate.getTime() - a.data.pubDate.getTime();
const news = (await getCollection('news')).sort(byTime);
const notices = (await getCollection('updates')).sort(byTime);
const lead = news[0];
const secondary = news.slice(1, 3);
const briefs = news.slice(3);
const [forecast, externalNews] = await Promise.all([getForecast('Bastrop'), getExternalNews(4, 2)]);
const townCounts = cities
  .filter((city) => city !== 'Countywide')
  .map((city) => ({ city, count: upcoming.filter((event) => event.data.city === city).length }));
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Bastropia',
  url: 'https://bastropia.com/',
  description: siteDescription,
}).replace(/</g, '\\u003c');
---

<BaseLayout title="Bastropia" description={siteDescription}>
  <script slot="head" type="application/ld+json" set:html={jsonLd} />
  <div class="wrap">
    <figure class="hero-photo">
      <img src="/images/bastrop-aerial.jpg" alt="Aerial view of downtown Bastrop, the river bridge, and the surrounding pines" width="1024" height="682" fetchpriority="high" />
    </figure>
    <section class="front" aria-label="Front page">
      <div class="col col-lead">
        {lead && (
          <article class="story-lead">
            <p class="kicker">{lead.data.place} · {formatMedium(lead.data.pubDate)}</p>
            <h1><a href={`/news/${lead.id}`}>{lead.data.title}</a></h1>
            <p class="dek">{lead.data.description}</p>
            <p class="more"><a href={`/news/${lead.id}`}>Read the story</a></p>
          </article>
        )}
        <div class="story-pair">
          {secondary.map((story) => (
            <article class="story-sub">
              <p class="kicker">{story.data.place} · {formatMedium(story.data.pubDate)}</p>
              <h2><a href={`/news/${story.id}`}>{story.data.title}</a></h2>
              <p class="dek">{story.data.description}</p>
            </article>
          ))}
        </div>
      </div>

      <aside class="col col-left" aria-label="More headlines">
        <h2 class="col-title">More headlines</h2>
        {briefs.map((story) => (
          <article class="brief">
            <p class="kicker">{story.data.place}</p>
            <h3><a href={`/news/${story.id}`}>{story.data.title}</a></h3>
          </article>
        ))}
        {notices.slice(0, 3).map((notice) => (
          <article class="brief">
            <p class="kicker">Public notice · {notice.data.agency}</p>
            <h3><a href={`/government/${notice.id}`}>{notice.data.title}</a></h3>
          </article>
        ))}
        <p class="more"><a href="/news">All news</a></p>
      </aside>

      <aside class="col col-right" aria-label="Today in the county">
        <h2 class="col-title">Today in Bastrop County</h2>
        {todayEvents.length ? (
          <ul class="agenda">
            {todayEvents.map((event) => (
              <li class={`tier-${tierOf(event)}`}>
                <a href={`/events/${event.id}`}>
                  <span class="when">{whenLabel(event.data.schedule, event.data.start, event.data.end)}</span>
                  <strong>{event.data.title}</strong>
                  <span class="where">{event.data.city}</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="meta">Nothing is listed for today. <a class="text-link" href="/submit">Add something</a>.</p>
        )}
        <p class="more"><a href="/events?when=today">Full agenda</a></p>

        <div class="wx">
          <h2 class="col-title">Weather</h2>
          {forecast ? (
            <>
              <a class="wx-now" href="/weather">
                <strong>{forecast.temp}°</strong>
                <span>{weatherLabel(forecast.code)} in Bastrop<br />Feels {forecast.feels}°, wind {forecast.wind} mph</span>
              </a>
              <ul class="wx-days">
                {forecast.daily.slice(1, 4).map((day) => (
                  <li>
                    <span>{labelFromKey(day.date).split(',')[0]}</span>
                    <strong>{day.high}° / {day.low}°</strong>
                  </li>
                ))}
              </ul>
            </>
          ) : (
            <p class="meta"><a class="text-link" href="/weather">Open the county forecast</a></p>
          )}
        </div>

        <div class="wx">
          <h2 class="col-title">Burn ban</h2>
          <a class="status-line" href="/burn-ban">
            <strong class={burnBan.inEffect ? 'is-stop' : 'is-ok'}>{burnBan.inEffect ? 'In effect' : 'None listed'}</strong>
            <span>Checked {formatMedium(new Date(`${burnBan.checked}T12:00:00`))}</span>
          </a>
        </div>
      </aside>
    </section>

    <ExternalNews items={externalNews} allNews />

    <section class="section">
      <div class="section-head">
        <h2>This weekend</h2>
        <a href="/this-weekend">Friday to Sunday</a>
      </div>
      <div class="weekend-grid">
        {weekend.map((day) => {
          const items = weekendEvents.filter((event) => eventKey(event.data.start) === day);
          return (
            <section class="day-card">
              <p class="kicker">{labelFromKey(day)}</p>
              {items.map((event) => <EventCard event={event} tier={tierOf(event)} compact />)}
              {!items.length && <p class="meta">Nothing listed.</p>}
            </section>
          );
        })}
      </div>
    </section>

    <AdSlot placement="river-banner" />

    <section class="section split">
      <div>
        <div class="section-head">
          <h2>{boosted ? 'Featured events' : 'Coming up'}</h2>
          <a href="/upgrade">Upgrade a listing</a>
        </div>
        <div class="card-list">
          {picks.map((event) => <EventCard event={event} tier={tierOf(event)} />)}
          {!picks.length && <p class="meta">Nothing further out is listed yet.</p>}
        </div>
      </div>
      <div>
        <div class="section-head">
          <h2>By town</h2>
          <a href="/events">All events</a>
        </div>
        <ul class="towns">
          {townCounts.map((item) => (
            <li>
              <a href={`/events?city=${encodeURIComponent(item.city)}`}>
                <span>{item.city}</span>
                <em>{item.count} upcoming</em>
              </a>
            </li>
          ))}
        </ul>
        <p class="meta topics">
          {Object.entries(categoryMeta).map(([id, item]) => (
            <a class="text-link" href={`/events?category=${id}`}>{item.label}</a>
          ))}
        </p>
      </div>
    </section>

    <section class="section split">
      <div>
        <div class="section-head">
          <h2>Government and public notices</h2>
          <a href="/government">Services and contacts</a>
        </div>
        <div class="news-list">
          {notices.slice(0, 4).map((notice) => (
            <article class="update-card">
              <a href={`/government/${notice.id}`}>
                <p class="kicker">{notice.data.agency} · {formatMedium(notice.data.pubDate)}</p>
                <h3>{notice.data.title}</h3>
                <p class="meta">{notice.data.description}</p>
              </a>
            </article>
          ))}
        </div>
      </div>
      <div>
        <div class="section-head">
          <h2>Live and meetings</h2>
          <a href="/live">All</a>
        </div>
        <div class="stream-list">
          {streams.slice(0, 4).map((stream) => {
            const next = stream.dates?.find((date) => date >= today);
            return (
              <article class="stream">
                <p class="kicker">{stream.host}{next === today ? ' · Meets today' : ''}</p>
                <h3><a href={stream.href}>{stream.name}</a></h3>
                <p class="meta">{next ? labelFromKey(next) : stream.schedule}</p>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <VideoSection heading="Watch" allVideos />

    <section class="band" id="newsletter">
      <div>
        <p class="kicker">Your event. Your business.</p>
        <h2>Free to list. Louder if you need it.</h2>
        <p class="dek">Community listings are reviewed and published at no charge. Spotlight, Featured, and Lost Pines pin a listing higher. Ads are sold by the week and always labeled.</p>
        <div class="cluster">
          <a class="button" href="/submit">Submit a listing</a>
          <a class="button button-light" href="/upgrade">Upgrade prices</a>
          <a class="button button-light" href="/advertise">Buy an ad</a>
        </div>
      </div>
      <form class="form" action="/api/intake" method="post">
        <input type="hidden" name="type" value="newsletter" />
        <input type="hidden" name="from" value="/" />
        <h3>The county, in your inbox</h3>
        <label class="field">
          <span>Email</span>
          <input name="email" type="email" required autocomplete="email" />
        </label>
        <label class="field">
          <span>How often</span>
          <select name="cadence">
            <option value="weekly">Weekly, before the weekend</option>
            <option value="daily">Daily</option>
          </select>
        </label>
        <button class="button" type="submit">Get the list</button>
      </form>
    </section>
  </div>
</BaseLayout>
