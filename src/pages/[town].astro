---
export const prerender = false;

import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import EventCard from '../components/EventCard.astro';
import { townBySlug } from '../data/towns';
import { districtsFor, notesForTown, schoolWeekChecked } from '../data/schoolWeek';
import { youtubeChannels, channelPage } from '../data/youtubeChannels';
import { footballSchools, getFridayScores } from '../lib/fridayScores';
import { getExternalNews } from '../lib/externalNews';
import { phoneHref } from '../lib/format';
import { eventKey, formatMedium, labelFromKey } from '../lib/time';
import { getForecast, weatherLabel } from '../lib/weather';
import { activeUpgrades, resolveTier } from '../lib/intake';

const town = townBySlug(Astro.params.town ?? '');
if (!town) Astro.response.status = 404;

const now = new Date();
const today = eventKey(now);
const weekEnd = eventKey(new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000));
const forecast = town ? await getForecast(town.weather) : null;
const events = town ? await getCollection('events') : [];
const upgrades = town ? await activeUpgrades(today) : [];
const tierOf = (event: (typeof events)[number]) => resolveTier(event.id, event.data.tier, upgrades);
const weekEvents = events
  .filter((event) => {
    const key = eventKey(event.data.start);
    return event.data.city === town?.name && key >= today && key <= weekEnd;
  })
  .sort((a, b) => a.data.start.getTime() - b.data.start.getTime())
  .slice(0, 8);
const localNews = town
  ? (await getCollection('news'))
      .filter((story) => story.data.place === town.name)
      .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
      .slice(0, 4)
  : [];
const wires = town ? (await getExternalNews(16, 4)).filter((story) => story.place === town.name).slice(0, 4) : [];
const notes = town ? notesForTown(town.name, today) : [];
const districts = town ? districtsFor(town.name) : [];
const channels = youtubeChannels.filter((channel) => town?.channels?.includes(channel.id));
const scores = town && town.football.length ? await getFridayScores() : [];
const townScores = scores.filter((score) => town?.football.includes(score.id));
const schools = footballSchools.filter((school) => town?.football?.includes(school.id));
---

{!town ? (
  <BaseLayout title="Page not found" description="That page is not on the Bastropia desk." noindex>
    <PageHead kicker="404" title="Nothing is filed there" lede="The town pages are Bastrop, Elgin, Smithville, Cedar Creek, McDade, and Paige." />
  </BaseLayout>
) : (
  <BaseLayout
    title={`This week in ${town.name}`}
    description={`${town.lede} Bastrop County, Texas.`}
  >
    <PageHead kicker="Town" title={`This week in ${town.name}`} lede={town.lede} />
    <div class="wrap">
      <p class="cluster">
        <button class="button button-dark" type="button" id="use-town" data-town={town.name}>Use {town.name} on the front page</button>
        <a class="button button-ghost" href="/">Front page</a>
        <a class="button button-ghost" href={`/events?city=${encodeURIComponent(town.name)}`}>All {town.name} events</a>
      </p>

      {forecast && (
        <section class="notice" style="margin-top:1rem;">
          <p class="kicker" style="color: var(--river);">Right now</p>
          <h2>{forecast.temp}° and {weatherLabel(forecast.code).toLowerCase()}</h2>
          <p class="lede" style="color:#d5e4dc;">Feels like {forecast.feels}°. Wind {forecast.wind} mph.</p>
          <p class="more"><a href={`/weather?town=${encodeURIComponent(town.name)}`}>Week ahead</a></p>
        </section>
      )}

      <section class="section">
        <div class="section-head">
          <h2>School week</h2>
          <span class="meta">Checked {formatMedium(new Date(`${schoolWeekChecked}T12:00:00-06:00`))}</span>
        </div>
        {town.name === 'Paige' && (
          <p>A Paige address can sit in Bastrop ISD, McDade ISD, or Smithville ISD. This page does not pick a calendar for the whole town.</p>
        )}
        {town.name === 'McDade' && !notes.length && (
          <p>No November date was on the McDade ISD pages checked November 3. The office number and site are below.</p>
        )}
        {notes.length > 0 && (
          <ul class="agenda">
            {notes.map((note) => (
              <li>
                <a href={note.sourceUrl} rel="noopener">
                  <span class="when">{note.endDate ? `${labelFromKey(note.date)} – ${labelFromKey(note.endDate)}` : labelFromKey(note.date)}</span>
                  <strong>{note.title}</strong>
                  <span class="where">{note.detail}</span>
                </a>
              </li>
            ))}
          </ul>
        )}
        <div class="service-grid" style="margin-top:1rem;">
          {districts.map((district) => (
            <article class="service" style="padding: 0.9rem 1rem;">
              <h3>{district.name}</h3>
              <p class="cluster">
                <a class="button button-dark" href={phoneHref(district.phone)}>{district.phone}</a>
                <a class="button button-ghost" href={district.href}>Calendar</a>
              </p>
            </article>
          ))}
        </div>
        {schools.map((school) => {
          const score = townScores.find((item) => item.id === school.id);
          return (
            <p class="meta">
              {score
                ? `${school.school} ${score.result === 'won' ? 'beat' : score.result === 'lost' ? 'lost to' : 'tied'} ${score.opponent}, ${score.schoolScore}–${score.opponentScore}, ${score.when}.`
                : `${school.school}’s latest final is not on the school page right now.`}
              {' '}
              <a class="text-link" href="/scores">Scoreboard</a>
            </p>
          );
        })}
      </section>

      <section class="section">
        <div class="section-head">
          <h2>This week</h2>
          <a href={`/events?city=${encodeURIComponent(town.name)}`}>All listings</a>
        </div>
        <div class="card-list">
          {weekEvents.map((event) => <EventCard event={event} tier={tierOf(event)} />)}
          {!weekEvents.length && <p class="meta">Nothing is listed in {town.name} for the next seven days.</p>}
        </div>
      </section>

      <section class="section split">
        <div>
          <div class="section-head">
            <h2>Headlines</h2>
            <a href="/news">All news</a>
          </div>
          <div class="news-list">
            {localNews.map((story) => (
              <article class="brief">
                <p class="kicker">{formatMedium(story.data.pubDate)}</p>
                <h3><a href={`/news/${story.id}`}>{story.data.title}</a></h3>
              </article>
            ))}
            {wires.map((story) => (
              <article class="brief">
                <p class="kicker">{story.source.name}</p>
                <h3><a href={story.link} rel="noopener">{story.title}</a></h3>
              </article>
            ))}
            {!localNews.length && !wires.length && <p class="meta">No recent headline names {town.name}.</p>}
          </div>
        </div>
        <div>
          <div class="section-head">
            <h2>Channels</h2>
            <a href="/videos">Videos</a>
          </div>
          {channels.length ? (
            <ul class="stream-list">
              {channels.map((channel) => (
                <li class="stream">
                  <h3><a href={channelPage(channel)} rel="noopener">{channel.name}</a></h3>
                  <p class="meta">{channel.note}</p>
                </li>
              ))}
            </ul>
          ) : (
            <p class="meta">No local channel is listed for {town.name}. <a class="text-link" href="/phone-numbers">Phone numbers</a></p>
          )}
          <p class="more"><a href="/phone-numbers">Sheriff, tax office, library, schools</a></p>
        </div>
      </section>
    </div>
    <script is:inline>
      (function () {
        const button = document.querySelector('#use-town');
        if (!button) return;
        const key = 'bastropia-city';
        const town = button.getAttribute('data-town') || '';
        const mark = () => {
          let saved = '';
          try { saved = localStorage.getItem(key) || ''; } catch (error) { saved = ''; }
          if (saved === town) button.textContent = town + ' is the front page';
        };
        mark();
        button.addEventListener('click', () => {
          try { localStorage.setItem(key, town); } catch (error) { /* private browsing */ }
          document.cookie = key + '=' + encodeURIComponent(town) + '; path=/; max-age=31536000; SameSite=Lax';
          button.textContent = town + ' is the front page';
        });
      })();
    </script>
  </BaseLayout>
)}
