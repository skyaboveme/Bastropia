---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { electionDay, electionHours } from '../data/vote';
import { electionNightIsLive } from '../lib/electionNight';
import { eventKey } from '../lib/time';
import { getElectionBoard, racesByCategory, resultsEnr, resultsHome, resultsOffice } from '../lib/electionResults';
import { electionsChannel, channelPage } from '../data/youtubeChannels';
import { channelVideos } from '../lib/youtubeLatest';

if (electionNightIsLive()) return Astro.redirect('/election-night', 302);

const board = await getElectionBoard();
const refresh = Boolean(board?.votesReported || eventKey(new Date()) === electionDay);
const groups = board ? racesByCategory(board.races) : [];
const cameras = await channelVideos(electionsChannel, 6);
const camera = cameras[0];
const description = board
  ? `${board.status} Race-by-race totals for Bastrop County.`
  : 'Race-by-race results for Bastrop County, from the county elections office.';
---

<BaseLayout title="Election results" description={description}>
  <PageHead
    kicker="November 3, 2026"
    title="Election results"
    lede={board?.status ?? 'The county election-night report did not load. The links below are the elections office.'}
  />
  <div class="wrap">
    <div id="results-board">
    <p class="meta">
      These totals are the county election-night report at
      <a class="text-link" href={resultsEnr}>results.enr.clarityelections.com/TX/Bastrop</a>.
      {board && <a class="text-link" href={board.sourceUrl}>November 3 results</a>}.
      The elections office also posts a reconciliation on its
      <a class="text-link" href={resultsHome}>results page</a>.
      Polls are open {electionHours}.
      {board?.updated ? ` The office file says ${board.updated}.` : ''}
      {board && board.precincts > 0 ? ` Precincts reporting: ${board.reporting} of ${board.precincts}.` : ''}
    </p>

    {groups.map((group) => (
      <section class="section">
        <div class="section-head">
          <h2>{group.name}</h2>
        </div>
        <div class="race-grid">
          {group.races.map((race) => (
            <article class="race">
              <h3>{race.name}</h3>
              {race.name.startsWith('Bastrop County Special Election, JOP') && (
                <p>
                  The legal sale of all alcoholic beverages including mixed beverages.
                  <a class="text-link" href="https://www.bastropvotes.org/wp-content/uploads/2026/08/Complete_with_Docusign_Order_a_Special_Elect.pdf">County order</a>
                </p>
              )}
              <p class="meta">
                {race.votes.toLocaleString('en-US')} {race.votes === 1 ? 'vote' : 'votes'}
                {race.precincts > 0 ? ` · ${race.precinctsReporting} of ${race.precincts} precincts` : ''}
              </p>
              <ol>
                {race.choices.map((choice) => (
                  <li>
                    <span class="race-who">
                      <strong>{choice.name}</strong>
                      {choice.party && <em>{choice.party}</em>}
                    </span>
                    <span class="race-count">
                      {board?.votesReported ? <b style={`width:${Math.max(choice.percent, choice.votes ? 2 : 0)}%`} /> : null}
                      <span>{choice.votes.toLocaleString('en-US')}{board?.votesReported ? ` · ${choice.percent}%` : ''}</span>
                    </span>
                  </li>
                ))}
              </ol>
            </article>
          ))}
        </div>
      </section>
    ))}

    <p class="disclaimer">
      Bastrop County Elections, 804 Pecan St., Bastrop.
      <a class="text-link" href={`tel:${resultsOffice.phone.replaceAll('-', '')}`}>{resultsOffice.phone}</a>.
      <a class="text-link" href={resultsEnr}>County election list</a>.
      {board && <a class="text-link" href={board.sourceUrl}>This election</a>}.
      <a class="text-link" href="/go-vote">Polling places</a>.
    </p>
    </div>

    <section class="section" aria-labelledby="count-camera">
      <div class="section-head">
        <h2 id="count-camera">Central count</h2>
        <a href={channelPage(electionsChannel)} rel="noopener">Bastrop County Elections</a>
      </div>
      {camera ? (
        <div class="video-layout" data-election-videos>
          <div class="video-main">
            <div class="video-stage" data-feed-stage>
              <a class="video-thumb" href={camera.href} data-youtube={camera.videoId} data-title={camera.title}>
                <img src={camera.thumb} alt="" width="480" height="270" />
                <span class="video-play" aria-hidden="true"></span>
                <span class="sr">Play: {camera.title}</span>
              </a>
            </div>
            <h3 data-feed-title><a href={camera.href} rel="noopener">{camera.title}</a></h3>
            <p class="meta" data-feed-note>{camera.when || 'Bastrop County Elections'}</p>
          </div>
          <ul class="video-list">
            {cameras.map((video) => (
              <li>
                <a
                  class="video-item"
                  href={video.href}
                  data-feed-id={video.videoId}
                  data-title={video.title}
                  data-when={video.when}
                  data-youtube={video.videoId}
                  aria-current={video.videoId === camera.videoId ? 'true' : undefined}
                  rel="noopener"
                >
                  <img src={video.thumb} alt="" width="168" height="94" loading="lazy" />
                  <span>
                    <strong>{video.title}</strong>
                    {video.when && <em>{video.when}</em>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ) : (
        <p class="lede">
          The elections channel did not load.
          <a class="text-link" href={channelPage(electionsChannel)} rel="noopener">Open it on YouTube</a>.
        </p>
      )}
      <p class="disclaimer">The newest public video on the county elections channel, then earlier cameras. Playback is YouTube’s player.</p>
    </section>
    {refresh && (
      <script is:inline>
        async function refreshResults() {
          try {
            const response = await fetch(location.pathname, { headers: { accept: 'text/html' } });
            if (!response.ok) return;
            const doc = new DOMParser().parseFromString(await response.text(), 'text/html');
            const next = doc.querySelector('#results-board');
            const current = document.querySelector('#results-board');
            if (next && current) current.replaceWith(next);
          } catch {
            /* The camera stays up if the totals cannot be refreshed. */
          }
        }
        setInterval(refreshResults, 60000);
      </script>
    )}
    <script is:inline>
      document.querySelectorAll('[data-election-videos]').forEach((root) => {
        const stage = root.querySelector('[data-feed-stage]');
        const title = root.querySelector('[data-feed-title]');
        const note = root.querySelector('[data-feed-note]');
        if (!stage || !title || !note) return;
        const play = (id, name) => {
          const frame = document.createElement('iframe');
          frame.src = 'https://www.youtube-nocookie.com/embed/' + encodeURIComponent(id) + '?autoplay=1&rel=0';
          frame.title = name;
          frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
          frame.allowFullscreen = true;
          frame.referrerPolicy = 'strict-origin-when-cross-origin';
          stage.replaceChildren(frame);
        };
        stage.addEventListener('click', (event) => {
          const thumb = event.target.closest('.video-thumb');
          if (!thumb || !thumb.dataset.youtube) return;
          event.preventDefault();
          play(thumb.dataset.youtube, thumb.dataset.title || 'Video');
        });
        root.querySelectorAll('[data-feed-id]').forEach((item) => {
          item.addEventListener('click', (event) => {
            event.preventDefault();
            root.querySelectorAll('[data-feed-id]').forEach((other) => other.removeAttribute('aria-current'));
            item.setAttribute('aria-current', 'true');
            const name = item.dataset.title || 'Video';
            const link = document.createElement('a');
            link.href = item.href;
            link.rel = 'noopener';
            link.textContent = name;
            title.replaceChildren(link);
            note.textContent = item.dataset.when || 'Bastrop County Elections';
            play(item.dataset.youtube, name);
            stage.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
          });
        });
      });
    </script>
  </div>
</BaseLayout>

<style>
  .race-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem 1.4rem; }
  .race { border-top: 3px solid var(--ink); padding-top: 0.7rem; }
  .race h3 { font-size: 1.35rem; line-height: 1.15; }
  .race ol { list-style: none; margin: 0.4rem 0 0; padding: 0; }
  .race li { display: grid; gap: 0.15rem; padding: 0.45rem 0; border-top: 1px solid var(--line); }
  .race-who { display: flex; justify-content: space-between; gap: 0.6rem; }
  .race-who em { font-style: normal; color: var(--ink-soft); font-size: 0.82rem; }
  .race-count { display: grid; grid-template-columns: 1fr auto; gap: 0.6rem; align-items: center; color: var(--ink-soft); font-size: 0.88rem; }
  .race-count b { display: block; height: 0.35rem; background: var(--river); border-radius: 99px; }
  @media (max-width: 800px) { .race-grid { grid-template-columns: 1fr; } }
</style>
