---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import EventCredit from '../components/EventCredit.astro';
import EventPoster from '../components/EventPoster.astro';
import HomeBanner from '../components/HomeBanner.astro';
import WeekendBanner from '../components/WeekendBanner.astro';
import { eventHref, listEvents } from '../lib/eventSource';
import { cardImageUrl } from '../lib/eventPoster';
import { filterEvents, sortByDayThenTier } from '../lib/events';
import { activeUpgrades, resolveTier } from '../lib/intake';
import { eventKey, labelFromKey, thisWeekendKeys } from '../lib/time';

const now = new Date();
const days = thisWeekendKeys(now);
const upgrades = await activeUpgrades(eventKey(now));
const { events: all, source } = await listEvents();
const tierOf = (event: (typeof all)[number]) => resolveTier(event.id, event.data.tier, upgrades);
const events = sortByDayThenTier(filterEvents(all, { when: 'weekend' }, now), tierOf);
const span = days.length < 2 ? labelFromKey(days[0]) : `${labelFromKey(days[0])} through ${labelFromKey(days[days.length - 1])}`;
const groups: { key: string; label: string; banner: boolean; rows: typeof events }[] = [];
let count = 0;
const bannerAt = Math.min(5, events.length);
for (const event of events) {
  count += 1;
  const key = eventKey(event.data.start);
  let group = groups[groups.length - 1];
  if (!group || group.key !== key) {
    group = { key, label: labelFromKey(key), banner: false, rows: [] };
    groups.push(group);
  }
  group.rows.push(event);
  if (count === bannerAt) group.banner = true;
}
let posterIndex = 0;
function posterFlags(image?: string | null) {
  if (!cardImageUrl(image)) return { eager: false, priority: false };
  const index = posterIndex;
  posterIndex += 1;
  return { eager: index < 3, priority: index === 0 };
}
---

<BaseLayout
  title="This weekend"
  description="Friday, Saturday, and Sunday plans across Bastrop County."
>
  <PageHead
    kicker="Friday to Sunday"
    title="This weekend in the county"
    lede={`${span}. Events that have already ended are left off. If your plans are not here, the desk has not heard about them yet.`}
  />
  <div class="wrap">
    <EventCredit content="this-weekend" />
    {events.length ? (
      groups.map((group) => (
        <>
          <section class="event-day">
            <h2>{group.label}</h2>
            <div class="poster-grid">
              {group.rows.map((event) => {
                const flags = posterFlags(event.data.image);
                return (
                  <EventPoster
                    event={event}
                    tier={tierOf(event)}
                    href={eventHref(event, source)}
                    eager={flags.eager}
                    priority={flags.priority}
                  />
                );
              })}
            </div>
          </section>
          {group.banner && <WeekendBanner />}
        </>
      ))
    ) : (
      <p class="lede">Nothing is listed for this weekend. <a class="text-link" href="/submit">Submit a listing</a> if the desk has not heard about it yet.</p>
    )}
    <div class="site-banner">
      <HomeBanner />
    </div>
  </div>
</BaseLayout>
