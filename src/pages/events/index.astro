---
export const prerender = false;

import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import EventCard from '../../components/EventCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { categories, categoryMeta, cities } from '../../data/taxonomy';
import { filterEvents, sortByDayThenTier } from '../../lib/events';
import { activeUpgrades, resolveTier } from '../../lib/intake';
import { eventNode, linkList } from '../../lib/schema';
import { eventKey, labelFromKey, monthGrid, monthTitle } from '../../lib/time';

const params = Astro.url.searchParams;
const query = {
  when: params.get('when'),
  category: params.get('category'),
  city: params.get('city'),
  q: params.get('q'),
  date: params.get('date'),
};
const view = params.get('view') === 'month' ? 'month' : 'list';
const events = await getCollection('events');
const upgrades = await activeUpgrades(eventKey(new Date()));
const tierOf = (event: (typeof events)[number]) => resolveTier(event.id, event.data.tier, upgrades);
const visible = sortByDayThenTier(filterEvents(events, query), tierOf);
const today = eventKey(new Date());
const [todayYear, todayMonth] = today.split('-').map(Number);
const requested = params.get('month');
const monthMatch = requested?.match(/^(\d{4})-(\d{2})$/);
const year = monthMatch ? Number(monthMatch[1]) : todayYear;
const month = monthMatch ? Number(monthMatch[2]) : todayMonth;
const monthName = monthTitle(year, month);
const cells = monthGrid(year, month);
const counts = new Map<string, number>();
for (const event of events) {
  const key = eventKey(event.data.start);
  counts.set(key, (counts.get(key) ?? 0) + 1);
}
const monthKey = `${year}-${String(month).padStart(2, '0')}`;
const monthEvents = filterEvents(events, { when: 'all' }).filter((event) => eventKey(event.data.start).startsWith(monthKey));
const previous = month === 1 ? `${year - 1}-12` : `${year}-${String(month - 1).padStart(2, '0')}`;
const next = month === 12 ? `${year + 1}-01` : `${year}-${String(month + 1).padStart(2, '0')}`;
const weekdays = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const activeWhen = query.date ? '' : query.when || 'upcoming';
const filtered = Boolean(query.when || query.category || query.city || query.q || query.date);

function href(overrides: Record<string, string | null>) {
  const next = new URLSearchParams();
  const merged: Record<string, string | null> = {
    when: query.when,
    category: query.category,
    city: query.city,
    q: query.q,
    date: query.date,
    ...overrides,
  };
  for (const [key, value] of Object.entries(merged)) {
    if (value) next.set(key, value);
  }
  const search = next.toString();
  return search ? `/events?${search}` : '/events';
}
---

<BaseLayout
  title="Events"
  description="What’s happening in Bastrop County — filter by day, town, and the kind of plans you want."
  noindex={filtered}
  extra={[
    ...(filtered ? [] : [linkList('Events in Bastrop County', visible.slice(0, 30).map((event) => ({ name: event.data.title, path: `/events/${event.id}` })))]),
    ...visible.map((event) => eventNode(event)),
  ]}
>
  <PageHead
    kicker={view === 'month' ? 'Month' : 'Calendar'}
    title={view === 'month' ? monthName : 'Events in Bastrop County'}
    lede={view === 'month'
      ? 'Pick a day. The number on it is how many listings the desk has, not how busy the town will be.'
      : 'Festivals, meetings, markets, and ordinary Tuesday plans. Filter the list, or switch to the month.'}
  />
  <div class="wrap">
    <div class="filters">
      <div class="filter-row">
        <span>View</span>
        <a class="chip" href="/events" aria-current={view === 'list' ? 'true' : undefined}>List</a>
        <a class="chip" href={`/events?view=month&month=${monthKey}`} aria-current={view === 'month' ? 'true' : undefined}>Month</a>
      </div>
    </div>
    {view === 'month' ? (
      <>
        <div class="cluster" style="margin-top:0.6rem;">
          <a class="button button-ghost" href={`/events?view=month&month=${previous}`}>Previous</a>
          <a class="button button-ghost" href="/events?view=month">This month</a>
          <a class="button button-ghost" href={`/events?view=month&month=${next}`}>Next</a>
        </div>
        <div class="calendar" style="margin-top:1rem;">
          {weekdays.map((day) => <p class="dow">{day}</p>)}
          {cells.map((cell) => cell ? (
            <a class:list={[{ 'is-today': cell === today, has: counts.has(cell) }]} href={`/events?date=${cell}`}>
              <strong>{Number(cell.slice(-2))}</strong>
              {counts.has(cell) && <span>{counts.get(cell)}</span>}
            </a>
          ) : <p></p>)}
        </div>
        <section class="section">
          <h2>Listed in {monthName}</h2>
          <div class="card-list" style="margin-top:0.8rem;">
            {monthEvents.map((event) => (
              <a class="text-link" href={`/events/${event.id}`}>{labelFromKey(eventKey(event.data.start))} — {event.data.title}</a>
            ))}
            {!monthEvents.length && <p>Nothing is filed for this month yet.</p>}
          </div>
        </section>
        <AdSlot placement="calendar-sponsor" />
      </>
    ) : (
    <>
    <form class="search" action="/events" method="get">
      <label class="sr" for="event-q">Search events</label>
      <input id="event-q" name="q" type="search" value={query.q ?? ''} placeholder="Search listings" />
      {query.when && <input type="hidden" name="when" value={query.when} />}
      {query.category && <input type="hidden" name="category" value={query.category} />}
      {query.city && <input type="hidden" name="city" value={query.city} />}
      <button class="button" type="submit">Search</button>
    </form>
    <div class="filters">
      <div class="filter-row">
        <span>When</span>
        {[['upcoming', 'Upcoming'], ['today', 'Today'], ['tonight', 'Tonight'], ['weekend', 'This weekend'], ['all', 'All dates']].map(([id, label]) => (
          <a class="chip" href={href({ when: id, date: null })} aria-current={activeWhen === id ? 'true' : undefined}>{label}</a>
        ))}
      </div>
      <div class="filter-row">
        <span>What</span>
        <a class="chip" href={href({ category: null })} aria-current={query.category ? undefined : 'true'}>All</a>
        {categories.map((category) => (
          <a class="chip" href={href({ category })} aria-current={query.category === category ? 'true' : undefined}>{categoryMeta[category].label}</a>
        ))}
      </div>
      <div class="filter-row">
        <span>Where</span>
        <a class="chip" href={href({ city: null })} aria-current={query.city ? undefined : 'true'}>All</a>
        {cities.map((city) => (
          <a class="chip" href={href({ city })} aria-current={query.city === city ? 'true' : undefined}>{city}</a>
        ))}
      </div>
    </div>
    {query.date && <p class="lede">Showing {labelFromKey(query.date)}.</p>}
    {visible.length ? (
      <div class="card-list">
        {visible.map((event) => <EventCard event={event} tier={tierOf(event)} />)}
      </div>
    ) : (
      <p class="lede">Nothing matches. <a class="text-link" href="/submit">Submit a listing</a> or <a class="text-link" href="/events">clear the filters</a>.</p>
    )}
    </>
    )}
  </div>
</BaseLayout>
