---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import EventBanner from '../../components/EventBanner.astro';
import EventCredit from '../../components/EventCredit.astro';
import EventPoster from '../../components/EventPoster.astro';
import HomeBanner from '../../components/HomeBanner.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { categories, categoryMeta, cities } from '../../data/taxonomy';
import { eventHref, listEvents } from '../../lib/eventSource';
import { cardImageUrl } from '../../lib/eventPoster';
import {
  EVENT_SCHEMA_LIMIT,
  eventsInWindow,
  filterEvents,
  isClassListing,
  listWindow,
  sortByDayThenTier,
} from '../../lib/events';
import { activeUpgrades, resolveTier } from '../../lib/intake';
import { offsiteAttrs } from '../../lib/links';
import { eventNode, linkList } from '../../lib/schema';
import { addDays, eventKey, labelFromKey, monthGrid, monthTitle } from '../../lib/time';

const params = Astro.url.searchParams;
const query = {
  when: params.get('when'),
  category: params.get('category'),
  city: params.get('city'),
  q: params.get('q'),
  date: params.get('date'),
  classes: params.get('classes'),
};
const view = params.get('view') === 'month' ? 'month' : 'list';
const [{ events, source }, upgrades] = await Promise.all([
  listEvents(),
  activeUpgrades(eventKey(new Date())),
]);
const tierOf = (event: (typeof events)[number]) => resolveTier(event.id, event.data.tier, upgrades);
const visible = sortByDayThenTier(filterEvents(events, query), tierOf);
const classesOn = query.classes === '1' || query.classes === 'classes';
const today = eventKey(new Date());
const requestedPage = Number(params.get('page'));
const page = Number.isInteger(requestedPage) && requestedPage > 1 ? requestedPage : 1;
const narrow = Boolean(query.date) || query.when === 'today' || query.when === 'tonight' || query.when === 'weekend';
const windowed = view === 'list' && !narrow;
const anchor = query.when === 'all' && visible[0] ? eventKey(visible[0].data.start) : today;
const dateWindow = windowed ? listWindow(page, anchor) : null;
const shown = dateWindow ? eventsInWindow(visible, dateWindow.start, dateWindow.end) : visible;
const hasLater = dateWindow ? visible.some((event) => eventKey(event.data.start) >= dateWindow.end) : false;
const rangeLabel = dateWindow ? `${labelFromKey(dateWindow.start)} through ${labelFromKey(addDays(dateWindow.end, -1))}` : '';
const groups: {
  key: string;
  label: string;
  banner: boolean;
  rows: (typeof shown)[number][];
}[] = [];
if (view === 'list') {
  let count = 0;
  const bannerAt = Math.min(5, shown.length);
  for (const event of shown) {
    count += 1;
    const key = eventKey(event.data.start);
    let group = groups[groups.length - 1];
    if (!group || group.key !== key) {
      group = { key, label: labelFromKey(key), banner: false, rows: [] };
      groups.push(group);
    }
    group.rows.push(event);
    if (count === bannerAt) group.banner = true;
  }
}
const [todayYear, todayMonth] = today.split('-').map(Number);
const requested = params.get('month');
const monthMatch = requested?.match(/^(\d{4})-(\d{2})$/);
const year = monthMatch ? Number(monthMatch[1]) : todayYear;
const month = monthMatch ? Number(monthMatch[2]) : todayMonth;
const monthName = monthTitle(year, month);
const cells = monthGrid(year, month);
const counts = new Map<string, number>();
if (view === 'month') {
  for (const event of events) {
    if (isClassListing(event)) continue;
    const key = eventKey(event.data.start);
    counts.set(key, (counts.get(key) ?? 0) + 1);
  }
}
const monthKey = `${year}-${String(month).padStart(2, '0')}`;
const monthEvents = view === 'month'
  ? filterEvents(events, { when: 'all' }).filter((event) => eventKey(event.data.start).startsWith(monthKey))
  : [];
const monthBannerAt = Math.min(5, monthEvents.length);
const monthBefore = monthEvents.slice(0, monthBannerAt);
const monthAfter = monthEvents.slice(monthBannerAt);
const previous = month === 1 ? `${year - 1}-12` : `${year}-${String(month - 1).padStart(2, '0')}`;
const next = month === 12 ? `${year + 1}-01` : `${year}-${String(month + 1).padStart(2, '0')}`;
const weekdays = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const activeWhen = query.date ? '' : query.when || 'upcoming';
const filtered = Boolean(query.when || query.category || query.city || query.q || query.date || classesOn);
const schemaEvents = (view === 'month' ? monthEvents : shown).slice(0, EVENT_SCHEMA_LIMIT);
let posterIndex = 0;
function posterFlags(image?: string | null) {
  if (!cardImageUrl(image)) return { eager: false, priority: false };
  const index = posterIndex;
  posterIndex += 1;
  return { eager: index < 3, priority: index === 0 };
}

function href(overrides: Record<string, string | null>) {
  const next = new URLSearchParams();
  const merged: Record<string, string | null> = {
    when: query.when,
    category: query.category,
    city: query.city,
    q: query.q,
    date: query.date,
    classes: query.classes,
    page: page > 1 ? String(page) : null,
    ...overrides,
  };
  for (const [key, value] of Object.entries(merged)) {
    if (value) next.set(key, value);
  }
  const search = next.toString();
  return search ? `/events?${search}` : '/events';
}
---

<BaseLayout
  title="Bastrop County Events Calendar"
  description="Bastrop County events calendar — filter by day, town, and the kind of plans you want."
  noindex={filtered || page > 1}
  nofollow={false}
  extra={[
    ...(filtered || page > 1
      ? []
      : [
          linkList(
            'Bastrop County Events Calendar',
            schemaEvents.map((event) => ({ name: event.data.title, path: eventHref(event, source) })),
          ),
        ]),
    ...(source === 'bcc' || filtered || page > 1 ? [] : schemaEvents.map((event) => eventNode(event))),
  ]}
>
  <PageHead
    kicker={view === 'month' ? 'Month' : 'Calendar'}
    title={view === 'month' ? monthName : 'Bastrop County Events Calendar'}
    lede={view === 'month'
      ? 'Pick a day. The number on it is how many listings the desk has, not how busy the town will be.'
      : 'Festivals, meetings, markets, and ordinary Tuesday plans. Filter the list, or switch to the month.'}
  />
  <div class="wrap">
    <EventCredit content="events" />
    <div class="filters">
      <div class="filter-row">
        <span>View</span>
        <a class="chip" href="/events" aria-current={view === 'list' ? 'true' : undefined}>List</a>
        <a class="chip" href={`/events?view=month&month=${monthKey}`} aria-current={view === 'month' ? 'true' : undefined}>Month</a>
      </div>
    </div>
    {view === 'month' ? (
      <>
        <div class="cluster" style="margin-top:0.6rem;">
          <a class="button button-ghost" href={`/events?view=month&month=${previous}`}>Previous</a>
          <a class="button button-ghost" href="/events?view=month">This month</a>
          <a class="button button-ghost" href={`/events?view=month&month=${next}`}>Next</a>
        </div>
        <div class="calendar" style="margin-top:1rem;">
          {weekdays.map((day) => <p class="dow">{day}</p>)}
          {cells.map((cell) => cell ? (
            <a class:list={[{ 'is-today': cell === today, has: counts.has(cell) }]} href={`/events?date=${cell}`}>
              <strong>{Number(cell.slice(-2))}</strong>
              {counts.has(cell) && <span>{counts.get(cell)}</span>}
            </a>
          ) : <p></p>)}
        </div>
        <section class="section">
          <h2>Listed in {monthName}</h2>
          <div class="card-list" style="margin-top:0.8rem;">
            {monthBefore.map((event) => (
              <a class="text-link" href={eventHref(event, source)} {...offsiteAttrs(eventHref(event, source))}>{labelFromKey(eventKey(event.data.start))} — {event.data.title}</a>
            ))}
          </div>
          {monthEvents.length > 0 && <EventBanner />}
          <div class="card-list">
            {monthAfter.map((event) => (
              <a class="text-link" href={eventHref(event, source)} {...offsiteAttrs(eventHref(event, source))}>{labelFromKey(eventKey(event.data.start))} — {event.data.title}</a>
            ))}
            {!monthEvents.length && <p>Nothing is filed for this month yet.</p>}
          </div>
        </section>
      </>
    ) : (
    <>
    <form class="search" action="/events" method="get">
      <label class="sr" for="event-q">Search events</label>
      <input id="event-q" name="q" type="search" value={query.q ?? ''} placeholder="Search listings" />
      {query.when && <input type="hidden" name="when" value={query.when} />}
      {query.category && <input type="hidden" name="category" value={query.category} />}
      {query.city && <input type="hidden" name="city" value={query.city} />}
      <button class="button" type="submit">Search</button>
    </form>
    <div class="filters">
      <div class="filter-row">
        <span>When</span>
        {[['upcoming', 'Upcoming'], ['today', 'Today'], ['tonight', 'Tonight'], ['weekend', 'This weekend'], ['all', 'All dates']].map(([id, label]) => (
          <a class="chip" href={href({ when: id, date: null, page: null })} aria-current={activeWhen === id ? 'true' : undefined}>{label}</a>
        ))}
      </div>
      <div class="filter-row">
        <span>What</span>
        <a class="chip" href={href({ category: null, classes: null, page: null })} aria-current={!query.category && !classesOn ? 'true' : undefined}>All</a>
        <a class="chip" href={href({ classes: '1', category: null, page: null })} aria-current={classesOn ? 'true' : undefined}>Classes</a>
        {categories.map((category) => (
          <a class="chip" href={href({ category, classes: null, page: null })} aria-current={query.category === category ? 'true' : undefined}>{categoryMeta[category].label}</a>
        ))}
      </div>
      <div class="filter-row">
        <span>Where</span>
        <a class="chip" href={href({ city: null, page: null })} aria-current={query.city ? undefined : 'true'}>All</a>
        {cities.map((city) => (
          <a class="chip" href={href({ city, page: null })} aria-current={query.city === city ? 'true' : undefined}>{city}</a>
        ))}
      </div>
    </div>
    {query.date && <p class="lede">Showing {labelFromKey(query.date)}.</p>}
    {dateWindow && <p class="lede">{rangeLabel}.{hasLater ? ' Later dates are on the next page.' : ''}</p>}
    {classesOn && <p class="lede">Rec-center fitness and wellness classes. One-off events stay on the main calendar.</p>}
    {shown.length ? (
      <>
        {groups.map((group) => (
          <>
            <section class="event-day">
              <h2>{group.label}</h2>
              <div class="poster-grid">
                {group.rows.map((event) => {
                  const flags = posterFlags(event.data.image);
                  return (
                    <EventPoster
                      event={event}
                      tier={tierOf(event)}
                      href={eventHref(event, source)}
                      eager={flags.eager}
                      priority={flags.priority}
                    />
                  );
                })}
              </div>
            </section>
            {group.banner && <EventBanner />}
          </>
        ))}
        {(page > 1 || hasLater) && (
          <p class="cluster">
            {page > 1 && <a class="button button-ghost" href={href({ page: page > 2 ? String(page - 1) : null })}>Previous dates</a>}
            {hasLater && <a class="button" href={href({ page: String(page + 1) })}>Later dates</a>}
          </p>
        )}
      </>
    ) : (
      <p class="lede">
        Nothing matches.
        {hasLater && <> <a class="text-link" href={href({ page: String(page + 1) })}>Check later dates</a> or</>}
        {' '}<a class="text-link" href="/submit">Submit a listing</a> or <a class="text-link" href="/events">clear the filters</a>.
      </p>
    )}
    </>
    )}
    <div class="site-banner">
      <HomeBanner />
    </div>
    <NewsletterSignup />
  </div>
</BaseLayout>
