---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import { authors } from '../../data/authors';
---

<BaseLayout
  title="Authors"
  description="Author pages for Michael Smith, Bastropia editor, and Ben Caxton, Bastropia reporter."
>
  <PageHead
    kicker="Masthead"
    title="Authors"
    lede="Ben Caxton is the byline on a story. The daily roundup is Michael Smith. Either name links to the stories filed under it."
  />
  <div class="wrap prose">
    {authors.length > 0 ? (
      <ul>
        {authors.map((author) => (
          <li>
            <a href={`/authors/${author.slug}`}>{author.name}</a>
            {author.jobTitle ? `, ${author.jobTitle}` : ''}. {author.description}
          </li>
        ))}
      </ul>
    ) : (
      <p>No reporter is listed by name yet.</p>
    )}
    <p>The <a href="/staff">masthead</a> is the same list. The <a href="/editorial-policy">editorial policy</a> says how a story is reported, and the <a href="/corrections-policy">corrections policy</a> says how a wrong fact gets fixed.</p>
  </div>
</BaseLayout>
