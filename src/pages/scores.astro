---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { footballSchools, getFridayScores } from '../lib/fridayScores';
import { offsiteAttrs } from '../lib/links';

const scores = await getFridayScores();
const bySchool = new Map(scores.map((score) => [score.id, score]));
---

<BaseLayout
  title="Friday night scores"
  description="Next kickoff and latest final for Bastrop, Cedar Creek, Elgin, and Smithville football, from MaxPreps."
>
  <PageHead
    kicker="Football"
    title="Friday night scoreboard"
    lede="Bastrop, Cedar Creek, Elgin, and Smithville. Next game, opponent, and the last final MaxPreps has posted—including a Thursday kickoff."
  />
  <div class="wrap">
    <div class="score-grid">
      {footballSchools.map((school) => {
        const score = bySchool.get(school.id);
        const next = score?.next;
        const last = score?.last;
        return (
          <article class="score-card">
            <p class="kicker">{school.school} {school.mascot}</p>
            {next ? (
              <>
                <p class="score-label">Next</p>
                <h2>{next.side === 'Away' ? `@ ${next.opponent}` : `vs ${next.opponent}`}</h2>
                <p class="meta">{[next.when, next.kickoff, next.side].filter(Boolean).join(' · ')}</p>
              </>
            ) : (
              <>
                <p class="score-label">Next</p>
                <h2>—</h2>
                <p>No upcoming game is listed right now.</p>
              </>
            )}
            {last ? (
              <div class="score-last">
                <p class="score-label">Last</p>
                <p class="score-line">
                  <strong>{last.result === 'won' ? 'W' : last.result === 'lost' ? 'L' : 'T'} {last.schoolScore}–{last.opponentScore}</strong>
                  <span>
                    {last.result === 'won' ? 'Beat' : last.result === 'lost' ? 'Lost to' : 'Tied'} {last.opponent}
                  </span>
                </p>
                <p class="meta">{[last.when, last.kickoff, last.side].filter(Boolean).join(' · ')}</p>
              </div>
            ) : (
              <div class="score-last">
                <p class="score-label">Last</p>
                <p class="meta">The latest final is not on the school page right now.</p>
              </div>
            )}
            <p class="cluster">
              <a class="text-link" href={school.href} {...offsiteAttrs(school.href)}>MaxPreps</a>
              <a class="text-link" href={school.watch} {...offsiteAttrs(school.watch)}>Watch</a>
            </p>
          </article>
        );
      })}
    </div>
    <p class="disclaimer">
      Next games and scores come from each school’s MaxPreps page. Bastropia does not keep the official book.
      A week with no new final keeps the previous result until MaxPreps posts another.
    </p>
  </div>
</BaseLayout>

<style>
  .score-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .score-card { border-top: 4px solid var(--ink); padding-top: 0.7rem; }
  .score-label {
    margin: 0.55rem 0 0.1rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--river-deep);
  }
  .score-card > .score-label:first-of-type { margin-top: 0.15rem; }
  .score-card h2 { font-size: clamp(1.55rem, 2.8vw, 2.1rem); line-height: 1.15; margin: 0.15rem 0 0.2rem; }
  .score-last { margin-top: 0.35rem; padding-top: 0.45rem; border-top: 1px solid color-mix(in srgb, var(--ink) 14%, transparent); }
  .score-line { display: grid; gap: 0.1rem; margin: 0.15rem 0; }
  .score-line strong { font-family: var(--serif); font-size: 1.45rem; font-weight: 600; line-height: 1.1; }
  @media (max-width: 800px) { .score-grid { grid-template-columns: 1fr 1fr; } }
</style>
