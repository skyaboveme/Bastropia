---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { footballSchools, getFridayScores } from '../lib/fridayScores';

const scores = await getFridayScores();
const bySchool = new Map(scores.map((score) => [score.id, score]));
---

<BaseLayout
  title="Friday night scores"
  description="Latest final scores for Bastrop, Cedar Creek, Elgin, and Smithville football, from MaxPreps, through the playoffs."
>
  <PageHead
    kicker="Football"
    title="Friday night scoreboard"
    lede="Bastrop, Cedar Creek, Elgin, and Smithville. The latest final on each school’s MaxPreps page, including a Thursday game. The next round appears here when MaxPreps posts it."
  />
  <div class="wrap">
    <div class="score-grid">
      {footballSchools.map((school) => {
        const score = bySchool.get(school.id);
        return (
          <article class="score-card">
            <p class="kicker">{school.school} {school.mascot}</p>
            {score ? (
              <>
                <h2>{score.schoolScore}–{score.opponentScore}</h2>
                <p>{score.result === 'won' ? 'Beat' : score.result === 'lost' ? 'Lost to' : 'Tied'} {score.opponent}</p>
                <p class="meta">{score.when}{score.kickoff ? ` · ${score.kickoff}` : ''}{score.side ? ` · ${score.side}` : ''}{score.place ? ` · ${score.place}` : ''}</p>
              </>
            ) : (
              <>
                <h2>—</h2>
                <p>The latest final is not on the school page right now.</p>
              </>
            )}
            <p class="cluster">
              <a class="text-link" href={school.href}>MaxPreps</a>
              <a class="text-link" href={school.watch}>Watch</a>
            </p>
          </article>
        );
      })}
    </div>
    <p class="disclaimer">
      Scores are the latest final MaxPreps has posted for each school. Bastropia does not keep the official book.
      A Friday with no new game keeps the previous final until the next one is posted.
    </p>
  </div>
</BaseLayout>

<style>
  .score-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .score-card { border-top: 4px solid var(--ink); padding-top: 0.7rem; }
  .score-card h2 { font-size: clamp(2.4rem, 4vw, 3.4rem); line-height: 1; margin: 0.2rem 0; }
  @media (max-width: 800px) { .score-grid { grid-template-columns: 1fr 1fr; } }
</style>
