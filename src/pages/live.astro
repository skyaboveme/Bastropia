---
export const prerender = false;

import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { streams } from '../data/streams';
import { eventKey, labelFromKey, whenLabel } from '../lib/time';

const today = eventKey(new Date());
const streamsToday = (await getCollection('events')).filter(
  (event) => event.data.streamUrl && eventKey(event.data.start) >= today,
);
---

<BaseLayout title="Live" description="Public meeting links, event streams, and the Bastropia Facebook group.">
  <PageHead
    kicker="Live"
    title="Meetings, streams, and the group"
    lede="Bastropia points at public streams. It does not rebroadcast court or city meetings. Neighbor video lives in the Facebook group."
  />
  <div class="wrap">
    <div class="stream-list">
      {streams.map((stream) => {
        const next = stream.dates?.find((date) => date >= today);
        return (
          <article class="stream">
            <div style="padding: 1rem 1.05rem;">
              <p class="kicker">{stream.host}{next === today ? ' · Meets today' : ''}</p>
              <h3>{stream.name}</h3>
              <p class="meta">{stream.where}</p>
              <p class="meta">{next ? `Next date on the published schedule: ${labelFromKey(next)}.` : stream.schedule}</p>
              <p style="margin-top:0.6rem;">{stream.note}</p>
              <p class="cluster"><a class="button button-dark" href={stream.href}>{stream.hrefLabel}</a></p>
            </div>
          </article>
        );
      })}
    </div>
    <section class="section">
      <h2>Event streams</h2>
      <div class="card-list" style="margin-top:0.8rem;">
        {streamsToday.map((event) => (
          <article class="story-card">
            <a href={event.data.streamUrl}>
              <p class="kicker">{labelFromKey(eventKey(event.data.start))} · {whenLabel(event.data.schedule, event.data.start, event.data.end)}</p>
              <h3>{event.data.title}</h3>
              <p class="meta">Stream link submitted with the listing.</p>
            </a>
          </article>
        ))}
        {!streamsToday.length && <p class="lede">No upcoming listing includes a stream link. Add one when you <a class="text-link" href="/submit">submit an event</a>.</p>}
      </div>
    </section>
  </div>
</BaseLayout>
