---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import CountyFeeds from '../components/CountyFeeds.astro';
---

<BaseLayout title="Live" description="The newest video from Bastrop ISD, Elgin ISD, Smithville ISD, and the City of Bastrop, in one player.">
  <PageHead
    kicker="Live"
    title="Latest from local channels"
    lede="Pick a channel. The player loads the newest video that channel has posted."
  />
  <div class="wrap">
    <CountyFeeds heading="" />
  </div>
</BaseLayout>
