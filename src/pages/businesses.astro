---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import {
  businessCategories,
  businessesByCategory,
  businessesByTown,
  businessTowns,
  filterBusinesses,
} from '../data/businesses';

const params = Astro.url.searchParams;
const category = params.get('category');
const town = params.get('town');
const filtered = Boolean(category || town);
const visible = filterBusinesses({ category, town });
const byCategory = businessesByCategory(visible);
const byTown = businessesByTown(visible);
const categories = businessCategories();
const towns = businessTowns();

const title =
  category && town
    ? `${category} in ${town}`
    : category
      ? `${category} in Bastrop County`
      : town
        ? `Businesses in ${town}`
        : 'Bastrop County business directory';

const description =
  category && town
    ? `${category} businesses serving ${town} and nearby Bastrop County towns.`
    : 'Find local businesses in Bastrop County by category and town. Free directory listings, with paid landing pages for partners.';

function href(overrides: Record<string, string | null>) {
  const next = new URLSearchParams();
  const merged = { category, town, ...overrides };
  for (const [key, value] of Object.entries(merged)) {
    if (value) next.set(key, value);
  }
  const search = next.toString();
  return search ? `/businesses?${search}` : '/businesses';
}
---

<BaseLayout title={title} description={description} noindex={filtered} banner={false}>
  <PageHead
    kicker="Directory"
    title={title}
    lede="Browse by trade or town — heating in Smithville, landscaping in Rosanky, builders across the county. List your business free, or ask about a paid partner page."
  />
  <div class="wrap">
    <p class="cluster">
      <a class="button" href="/businesses/submit">List your business free</a>
      <a class="button button-ghost" href="/advertise">Paid partner pages</a>
    </p>

    <div class="filters">
      <div class="filter-row">
        <span>Category</span>
        <a class="chip" href={href({ category: null })} aria-current={!category ? 'true' : undefined}>All</a>
        {categories.map((item) => (
          <a class="chip" href={href({ category: item })} aria-current={category === item ? 'true' : undefined}>{item}</a>
        ))}
      </div>
      <div class="filter-row">
        <span>Town</span>
        <a class="chip" href={href({ town: null })} aria-current={!town ? 'true' : undefined}>All</a>
        {towns.map((item) => (
          <a class="chip" href={href({ town: item })} aria-current={town === item ? 'true' : undefined}>{item}</a>
        ))}
      </div>
    </div>

    {visible.length === 0 ? (
      <article class="detail-main">
        <h2 style="font-size:1.4rem;">Nothing matches that filter yet</h2>
        <p>The directory is young. <a class="text-link" href="/businesses/submit">Submit a business</a> for free, or clear the filters.</p>
      </article>
    ) : (
      <>
        <section class="section">
          <div class="section-head">
            <h2>By category</h2>
            <span class="meta">{visible.length} {visible.length === 1 ? 'listing' : 'listings'}</span>
          </div>
          <div class="card-list">
            {byCategory.map(([group, items]) => (
              <article class="detail-main">
                <p class="kicker">{group}</p>
                <h2 style="font-size:1.45rem;">{group}{town ? ` in ${town}` : ' in Bastrop County'}</h2>
                <ul class="plain-list">
                  {items.map((business) => (
                    <li>
                      <a class="text-link" href={`/${business.slug}`}>{business.name}</a>
                      <span class="meta"> · {business.place}</span>
                      <p>{business.summary}</p>
                    </li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </section>

        {!category && (
          <section class="section">
            <div class="section-head">
              <h2>By town</h2>
              <a href="/businesses/submit">Add yours</a>
            </div>
            <div class="card-list">
              {byTown.map((group) => (
                <article class="detail-main">
                  <p class="kicker">{group.town}</p>
                  <h2 style="font-size:1.45rem;">
                    <a class="text-link" href={href({ town: group.town, category: null })}>Businesses in {group.town}</a>
                  </h2>
                  <ul class="plain-list">
                    {group.businesses.map((business) => (
                      <li>
                        <a class="text-link" href={`/${business.slug}`}>{business.name}</a>
                        <span class="meta"> · {business.category}</span>
                      </li>
                    ))}
                  </ul>
                </article>
              ))}
            </div>
          </section>
        )}
      </>
    )}

    <section class="notice" style="margin-top:1.5rem;">
      <p class="kicker" style="color: var(--river);">Partners</p>
      <h2>Free listing. Paid pages when you want the full treatment.</h2>
      <p class="lede" style="color:#d5e4dc;">
        A free directory note puts your name, trade, town, and phone on the desk. Partner pages like String Prairie and Barron Homes get a branded landing, LocalBusiness schema, and a share image.
      </p>
      <p class="cluster">
        <a class="button" href="/businesses/submit">Submit free</a>
        <a class="button button-ghost" href="/advertise">Ask about a partner page</a>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .plain-list {
    display: grid;
    gap: 0.85rem;
    margin-top: 0.75rem;
  }
  .plain-list p {
    margin-top: 0.2rem;
    color: var(--ink-soft);
  }
</style>
