---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import {
  directoryByCategory,
  directoryByTown,
  directoryCategories,
  directoryEntries,
  directoryTownOptions,
  filterDirectory,
} from '../data/directory';
import { listLiveBusinesses, toDirectoryEntry } from '../lib/businessDb';

const params = Astro.url.searchParams;
const category = params.get('category');
const town = params.get('town');
const q = params.get('q');
const filtered = Boolean(category || town || q);
const listed = (await listLiveBusinesses()).map(toDirectoryEntry);
const visible = filterDirectory({ category, town, q }, [...listed, ...directoryEntries]);
const byCategory = directoryByCategory(visible);
const byTown = directoryByTown(visible);
const categories = directoryCategories();
const towns = directoryTownOptions();
const partnerCount = visible.filter((entry) => entry.source === 'partner').length;

const title =
  category && town
    ? `${category} in ${town}`
    : category
      ? `${category} in Bastrop County`
      : town
        ? `Businesses in ${town}`
        : q
          ? `Businesses matching “${q}”`
          : 'Bastrop County business directory';

const description =
  category && town
    ? `${category} businesses serving ${town} and nearby Bastrop County towns.`
    : 'Find Bastrop County businesses by category and town, including Bastrop Regional Chamber members. Free listings, with paid landing pages for partners.';

function href(overrides: Record<string, string | null>) {
  const next = new URLSearchParams();
  const merged = { category, town, q, ...overrides };
  for (const [key, value] of Object.entries(merged)) {
    if (value) next.set(key, value);
  }
  const search = next.toString();
  return search ? `/businesses?${search}` : '/businesses';
}
---

<BaseLayout title={title} description={description} noindex={filtered} banner={false}>
  <PageHead
    kicker="Directory"
    title={title}
    lede="Chamber members plus local partner pages — browse by trade or town, or search by name. List yours free, or ask about a paid landing page."
  />
  <div class="wrap">
    <p class="cluster">
      <a class="button" href="/businesses/submit">List your business free</a>
      <a class="button button-ghost" href="/advertise">Paid partner pages</a>
    </p>

    <form class="filters" method="get" action="/businesses">
      <div class="filter-row search-row">
        <label for="q">Search</label>
        <input id="q" type="search" name="q" value={q || ''} placeholder="Name, trade, or town" />
        {category ? <input type="hidden" name="category" value={category} /> : null}
        {town ? <input type="hidden" name="town" value={town} /> : null}
        <button class="button" type="submit">Search</button>
      </div>
      <div class="filter-row">
        <label for="category">Category</label>
        <select id="category" name="category" onchange="this.form.requestSubmit()">
          <option value="">All categories</option>
          {categories.map((item) => (
            <option value={item} selected={category === item}>{item}</option>
          ))}
        </select>
      </div>
      <div class="filter-row">
        <span>Town</span>
        <a class="chip" href={href({ town: null })} aria-current={!town ? 'true' : undefined}>All</a>
        {towns.map((item) => (
          <a class="chip" href={href({ town: item })} aria-current={town === item ? 'true' : undefined}>{item}</a>
        ))}
      </div>
      {filtered && (
        <p class="meta">
          <a class="text-link" href="/businesses">Clear filters</a>
        </p>
      )}
    </form>

    {visible.length === 0 ? (
      <article class="detail-main">
        <h2 style="font-size:1.4rem;">Nothing matches that filter yet</h2>
        <p>Try another search, or <a class="text-link" href="/businesses/submit">submit a business</a> for free.</p>
      </article>
    ) : (
      <>
        <section class="section">
          <div class="section-head">
            <h2>By category</h2>
            <span class="meta">
              {visible.length} {visible.length === 1 ? 'listing' : 'listings'}
              {partnerCount ? ` · ${partnerCount} partner${partnerCount === 1 ? '' : 's'}` : ''}
            </span>
          </div>
          <div class="card-list">
            {byCategory.map(([group, items]) => (
              <article class="detail-main">
                <p class="kicker">{group}</p>
                <h2 style="font-size:1.45rem;">{group}{town ? ` in ${town}` : ' in Bastrop County'}</h2>
                <ul class="plain-list">
                  {items.map((entry) => (
                    <li>
                      <a class="text-link" href={entry.href} target={entry.source === 'chamber' ? '_blank' : undefined} rel={entry.source === 'chamber' ? 'noopener noreferrer' : undefined}>{entry.name}</a>
                      {entry.source === 'partner' ? <span class="badge">Partner page</span> : null}
                      <span class="meta"> · {entry.place}</span>
                      {entry.phone ? (
                        <>
                          <span class="meta"> · </span>
                          {entry.phoneHref ? <a class="text-link" href={entry.phoneHref}>{entry.phone}</a> : <span class="meta">{entry.phone}</span>}
                        </>
                      ) : null}
                      <p>{entry.summary}</p>
                    </li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </section>

        {!category && !q && (
          <section class="section">
            <div class="section-head">
              <h2>By town</h2>
              <a href="/businesses/submit">Add yours</a>
            </div>
            <div class="card-list">
              {byTown.map((group) => (
                <article class="detail-main">
                  <p class="kicker">{group.town}</p>
                  <h2 style="font-size:1.45rem;">
                    <a class="text-link" href={href({ town: group.town, category: null })}>Businesses in {group.town}</a>
                  </h2>
                  <ul class="plain-list">
                    {group.businesses.map((entry) => (
                      <li>
                        <a class="text-link" href={entry.href} target={entry.source === 'chamber' ? '_blank' : undefined} rel={entry.source === 'chamber' ? 'noopener noreferrer' : undefined}>{entry.name}</a>
                        {entry.source === 'partner' ? <span class="badge">Partner page</span> : null}
                        <span class="meta"> · {entry.category}</span>
                      </li>
                    ))}
                  </ul>
                </article>
              ))}
            </div>
          </section>
        )}
      </>
    )}

    <section class="notice" style="margin-top:1.5rem;">
      <p class="kicker" style="color: var(--river);">Partners</p>
      <h2>Free listing. Paid pages when you want the full treatment.</h2>
      <p class="lede" style="color:#d5e4dc;">
        Chamber members appear from the public Bastrop Regional Chamber directory. A free Bastropia note puts your name, trade, town, and phone on the desk. Partner pages like String Prairie and Barron Homes get a branded landing, LocalBusiness schema, and a share image.
      </p>
      <p class="cluster">
        <a class="button" href="/businesses/submit">Submit free</a>
        <a class="button button-ghost" href="/advertise">Ask about a partner page</a>
        <a class="button button-ghost" href="https://business.bastropchamber.com/list" target="_blank" rel="noopener noreferrer">Chamber directory</a>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .plain-list {
    display: grid;
    gap: 0.85rem;
    margin-top: 0.75rem;
  }
  .plain-list p {
    margin-top: 0.2rem;
    color: var(--ink-soft);
  }
  .badge {
    display: inline-block;
    margin-left: 0.35rem;
    padding: 0.08rem 0.4rem;
    border: 1px solid color-mix(in srgb, var(--river) 35%, transparent);
    border-radius: 4px;
    color: var(--river);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    vertical-align: middle;
  }
  .search-row {
    align-items: center;
  }
  .search-row input[type='search'] {
    min-width: min(100%, 18rem);
    padding: 0.45rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--ink) 18%, transparent);
    border-radius: 6px;
    background: #fff;
    color: var(--ink);
  }
  .filters select {
    min-width: min(100%, 18rem);
    padding: 0.45rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--ink) 18%, transparent);
    border-radius: 6px;
    background: #fff;
    color: var(--ink);
  }
  .filters label {
    font-size: 0.85rem;
    color: var(--ink-soft);
  }
</style>
