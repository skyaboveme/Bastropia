---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHead from '../../../components/PageHead.astro';
import FormError from '../../../components/FormError.astro';
import { placements } from '../../../data/commerce';
import { cities } from '../../../data/taxonomy';
import { deskAuthorized, deskKeyConfigured } from '../../../lib/auth';
import { accountForBusiness, getBusiness, logoSrc, statsFor } from '../../../lib/businessDb';

const allowed = deskAuthorized(Astro.url.hostname, Astro.cookies.get('bastropia_desk')?.value);
const business = allowed ? await getBusiness(Astro.params.id ?? '') : null;
const account = business ? await accountForBusiness(business.id) : null;
const stats = business ? await statsFor(business.id) : [];
const bannerViews = stats.reduce((sum, day) => sum + (day.banner_views || 0), 0);
const listingViews = stats.reduce((sum, day) => sum + day.views, 0);
const towns = [...cities.filter((city) => city !== 'Countywide'), 'Bastrop County'] as string[];
if (business && !towns.includes(business.city)) towns.unshift(business.city);
const saved = Astro.url.searchParams.get('saved');
---

<BaseLayout title={business ? business.name : 'Listing'} description="Update a directory listing." noindex>
  <PageHead kicker="Publisher" title={business ? business.name : 'Listing'} lede={business ? `Public page: bastropia.com/${business.slug}` : 'That listing is not in the directory.'} />
  <div class="wrap">
    {!allowed && (
      <form class="form" action="/api/desk" method="post">
        <FormError />
        <input type="hidden" name="action" value="login" />
        <input type="hidden" name="next" value={Astro.url.pathname} />
        <label class="field"><span>Desk password</span><input name="password" type="password" required /></label>
        <button class="button" type="submit">Unlock</button>
      </form>
    )}
    {!allowed && !deskKeyConfigured() && <p>Set BASTROPIA_DESK_KEY before this page is public.</p>}
    {allowed && !business && <p>That listing is not in the directory. <a href="/desk/businesses">Back to listings</a></p>}
    {allowed && business && (
      <>
        <p class="cluster">
          <a class="button button-ghost" href="/desk/businesses">All listings</a>
          {business.status === 'live' && <a class="button button-ghost" href={`/${business.slug}`}>View page</a>}
        </p>
        {saved && <p>Saved. The public page is <a href={`/${business.slug}`}>bastropia.com/{business.slug}</a>.</p>}
        <p class="meta">Last 30 days · {listingViews} listing {listingViews === 1 ? 'view' : 'views'} · {bannerViews} banner {bannerViews === 1 ? 'view' : 'views'}.</p>
        <FormError />
        <form class="form" action="/api/desk-business" method="post" enctype="multipart/form-data">
          <input type="hidden" name="action" value="save" />
          <input type="hidden" name="id" value={business.id} />
          <div class="fields">
            <label class="field wide"><span>Name</span><input name="name" required value={business.name} /></label>
            <label class="field"><span>Page address</span><input name="slug" value={business.slug} /></label>
            <label class="field"><span>Category</span><input name="category" required value={business.category} /></label>
            <label class="field">
              <span>Directory tier</span>
              <select name="tier">
                <option value="" selected={!business.tier}>Free</option>
                <option value="featured" selected={business.tier === 'featured'}>Featured</option>
                <option value="spotlight" selected={business.tier === 'spotlight'}>Spotlight badge</option>
              </select>
            </label>
            <label class="field">
              <span>Town</span>
              <select name="city" required>
                {towns.map((city) => <option value={city} selected={city === business.city}>{city}</option>)}
              </select>
            </label>
            <label class="field"><span>Phone</span><input name="phone" value={business.phone} /></label>
            <label class="field"><span>Website</span><input name="website" value={business.website} /></label>
            <label class="field wide"><span>Address</span><input name="address" value={business.address} /></label>
            <label class="field wide"><span>Hours</span><input name="hours" value={business.hours} placeholder="Mon–Fri 8–5" /></label>
            <label class="field wide"><span>Daily special</span><input name="daily_special" value={business.daily_special} /></label>
            <label class="field wide"><span>Logo</span><input name="logo" type="file" accept="image/jpeg,image/png,image/webp" /></label>
            {business.logo_type && (
              <p class="field wide">
                <span>Current logo</span>
                <img src={logoSrc(business)} alt="" width="72" height="72" style="display:block;width:4.4rem;height:4.4rem;object-fit:cover;border-radius:0.4rem;margin-top:0.4rem;background:#fff;" />
                <label style="display:flex;gap:0.4rem;align-items:center;margin-top:0.45rem;"><input type="checkbox" name="remove_logo" value="yes" /> Remove logo</label>
              </p>
            )}
            <label class="field wide"><span>Banner image</span><input name="banner_url" type="url" value={business.banner_url} placeholder="https://…" /></label>
            <label class="field">
              <span>Banner placement</span>
              <select name="banner_placement">
                <option value="" selected={!business.banner_placement}>None</option>
                {placements.map((item) => <option value={item.id} selected={item.id === business.banner_placement}>{item.name}</option>)}
              </select>
            </label>
            {business.banner_url && (
              <p class="field wide">
                <span>Banner</span>
                <img src={business.banner_url} alt="" width="600" height="250" style="display:block;width:min(100%,36rem);height:auto;margin-top:0.4rem;" />
              </p>
            )}
            <label class="field"><span>Email</span><input name="email" type="email" value={business.email} /></label>
            <label class="field"><span>Contact name</span><input name="contact" value={business.contact} /></label>
            <label class="field wide"><span>Towns served</span><input name="areas" value={business.areas} /></label>
            <label class="field wide"><span>Details</span><textarea name="details" rows="5">{business.details}</textarea></label>
          </div>
          <button class="button" type="submit">Save listing</button>
        </form>
        <form class="cluster" action="/api/desk-business" method="post">
          <input type="hidden" name="id" value={business.id} />
          {business.status !== 'live' && <button class="button" name="action" value="live">Publish</button>}
          {business.status === 'live' && <button class="button button-ghost" name="action" value="hide">Hide</button>}
        </form>
        <form class="form" action="/api/desk-business" method="post">
          <input type="hidden" name="action" value="password" />
          <input type="hidden" name="id" value={business.id} />
          <label class="field"><span>Owner username</span><input name="username" required value={account?.username || ''} /></label>
          <label class="field"><span>New password</span><input name="password" type="text" required minlength="8" /></label>
          <button class="button button-ghost" type="submit">Set login</button>
        </form>
      </>
    )}
  </div>
</BaseLayout>
