---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import FormError from '../../components/FormError.astro';
import { cities } from '../../data/taxonomy';
import { deskAuthorized, deskKeyConfigured } from '../../lib/auth';
import { accountForBusiness, listBusinesses } from '../../lib/businessDb';

const allowed = deskAuthorized(Astro.url.hostname, Astro.cookies.get('bastropia_desk')?.value);
const rows = allowed ? await listBusinesses() : [];
const accounts = allowed
  ? await Promise.all(rows.map(async (row) => ({ id: row.id, account: await accountForBusiness(row.id) })))
  : [];
const usernameOf = new Map(accounts.map((item) => [item.id, item.account?.username ?? '']));
const towns = cities.filter((city) => city !== 'Countywide');
const saved = Astro.url.searchParams.get('saved');
---

<BaseLayout title="Business desk" description="Approve free listings and set business logins." noindex>
  <PageHead kicker="Publisher" title="Businesses" lede="Free listings stay pending until you publish them and give the owner a username and password." />
  <div class="wrap">
    {!allowed && (
      <form class="form" action="/api/desk" method="post">
        <FormError />
        <input type="hidden" name="action" value="login" />
        <input type="hidden" name="next" value="/desk/businesses" />
        <label class="field"><span>Desk password</span><input name="password" type="password" required /></label>
        <button class="button" type="submit">Unlock</button>
      </form>
    )}
    {!allowed && !deskKeyConfigured() && <p>Set BASTROPIA_DESK_KEY before this page is public.</p>}
    {allowed && (
      <>
        <p><a class="button button-ghost" href="/desk">Back to the desk</a></p>
        {saved && <p>Saved {saved}.</p>}
        <FormError />
        <section class="section">
          <h2>Add a business</h2>
          <form class="form" action="/api/desk-business" method="post">
            <input type="hidden" name="action" value="create" />
            <div class="fields">
              <label class="field wide"><span>Name</span><input name="name" required /></label>
              <label class="field"><span>Category</span><input name="category" required /></label>
              <label class="field"><span>Town</span><select name="city" required>{towns.map((city) => <option value={city}>{city}</option>)}</select></label>
              <label class="field"><span>Phone</span><input name="phone" required /></label>
              <label class="field"><span>Email</span><input name="email" type="email" required /></label>
              <label class="field"><span>Website</span><input name="website" /></label>
              <label class="field wide"><span>Details</span><textarea name="details" required minlength="20" rows="4"></textarea></label>
              <label class="field"><span>Username</span><input name="username" required minlength="3" /></label>
              <label class="field"><span>Password</span><input name="password" type="text" required minlength="8" autocomplete="new-password" /></label>
            </div>
            <button class="button" type="submit">Publish and create login</button>
          </form>
        </section>
        <section class="section">
          <h2>Listings</h2>
          {rows.map((row) => (
            <article class="detail-main">
              <p class="kicker">{row.status}{usernameOf.get(row.id) ? ` · ${usernameOf.get(row.id)}` : ' · no login'}</p>
              <h2>{row.name}</h2>
              <p>{row.category} · {row.city} · {row.phone} · {row.email}</p>
              <p>{row.details}</p>
              <form class="cluster" action="/api/desk-business" method="post">
                <input type="hidden" name="id" value={row.id} />
                <input type="hidden" name="name" value={row.name} />
                <input type="hidden" name="category" value={row.category} />
                <input type="hidden" name="city" value={row.city} />
                <input type="hidden" name="areas" value={row.areas} />
                <input type="hidden" name="phone" value={row.phone} />
                <input type="hidden" name="website" value={row.website} />
                <input type="hidden" name="email" value={row.email} />
                <input type="hidden" name="contact" value={row.contact} />
                <input type="hidden" name="address" value={row.address} />
                <input type="hidden" name="details" value={row.details} />
                {row.status !== 'live' && <button class="button" name="action" value="approve">Publish</button>}
                {row.status === 'live' && <button class="button button-ghost" name="action" value="hide">Hide</button>}
                {row.status === 'hidden' && <button class="button" name="action" value="live">Show again</button>}
              </form>
              <form class="form" action="/api/desk-business" method="post">
                <input type="hidden" name="action" value="password" />
                <input type="hidden" name="id" value={row.id} />
                <label class="field"><span>Username</span><input name="username" required value={usernameOf.get(row.id) || ''} /></label>
                <label class="field"><span>New password</span><input name="password" type="text" required minlength="8" /></label>
                <button class="button button-ghost" type="submit">Set login</button>
              </form>
            </article>
          ))}
          {!rows.length && <p>No business submissions yet.</p>}
        </section>
      </>
    )}
  </div>
</BaseLayout>
