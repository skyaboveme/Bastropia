---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import FormError from '../../components/FormError.astro';
import { cities } from '../../data/taxonomy';
import { deskAuthorized, deskKeyConfigured } from '../../lib/auth';
import { listBusinesses } from '../../lib/businessDb';

const allowed = deskAuthorized(Astro.url.hostname, Astro.cookies.get('bastropia_desk')?.value);
const rows = allowed ? await listBusinesses() : [];
const q = (Astro.url.searchParams.get('q') || '').trim().toLowerCase();
const matched = rows
  .filter((row) => !q || `${row.name} ${row.category} ${row.city} ${row.phone} ${row.slug}`.toLowerCase().includes(q))
  .sort((a, b) => a.name.localeCompare(b.name));
const shown = matched.slice(0, q ? 60 : 40);
const towns = [...cities.filter((city) => city !== 'Countywide'), 'Bastrop County'];
const saved = Astro.url.searchParams.get('saved');
---

<BaseLayout title="Business desk" description="Add and update directory listings." noindex>
  <PageHead
    kicker="Publisher"
    title="Directory"
    lede="Each live listing gets a page at bastropia.com/its-name. Hours and the daily special stay blank until you fill them in."
  />
  <div class="wrap">
    {!allowed && (
      <form class="form" action="/api/desk" method="post">
        <FormError />
        <input type="hidden" name="action" value="login" />
        <input type="hidden" name="next" value="/desk/businesses" />
        <label class="field"><span>Desk password</span><input name="password" type="password" required /></label>
        <button class="button" type="submit">Unlock</button>
      </form>
    )}
    {!allowed && !deskKeyConfigured() && <p>Set BASTROPIA_DESK_KEY before this page is public.</p>}
    {allowed && (
      <>
        <p><a class="button button-ghost" href="/desk">Back to the desk</a></p>
        {saved && <p>Saved.</p>}
        <FormError />
        <section class="section">
          <h2>Add a listing</h2>
          <form class="form" action="/api/desk-business" method="post">
            <input type="hidden" name="action" value="create" />
            <div class="fields">
              <label class="field wide"><span>Name</span><input name="name" required /></label>
              <label class="field"><span>Page address</span><input name="slug" placeholder="barronhomes" /></label>
              <label class="field"><span>Category</span><input name="category" required /></label>
              <label class="field"><span>Town</span><select name="city" required>{towns.map((city) => <option value={city}>{city}</option>)}</select></label>
              <label class="field"><span>Phone</span><input name="phone" /></label>
              <label class="field"><span>Website</span><input name="website" /></label>
              <label class="field wide"><span>Address</span><input name="address" /></label>
              <label class="field wide"><span>Hours</span><input name="hours" placeholder="Mon–Fri 8–5" /></label>
              <label class="field wide"><span>Daily special</span><input name="daily_special" /></label>
              <label class="field wide"><span>Details</span><textarea name="details" rows="4"></textarea></label>
              <label class="field"><span>Owner username</span><input name="username" minlength="3" /></label>
              <label class="field"><span>Owner password</span><input name="password" type="text" minlength="8" autocomplete="new-password" /></label>
            </div>
            <button class="button" type="submit">Publish listing</button>
          </form>
        </section>
        <section class="section">
          <h2>Listings</h2>
          <form class="form" method="get">
            <label class="field wide"><span>Find a listing</span><input name="q" value={q} placeholder="Name, town, or phone" /></label>
            <button class="button" type="submit">Search</button>
          </form>
          <p class="meta">{matched.length} listing{matched.length === 1 ? '' : 's'}{shown.length < matched.length ? ` · showing ${shown.length}` : ''}.</p>
          <ul class="biz-list">
            {shown.map((row) => (
              <li>
                <a href={`/desk/businesses/${row.id}`}>{row.name}</a>
                <span class="meta"> {row.status} · {row.category} · {row.city}{row.phone ? ` · ${row.phone}` : ''}</span>
              </li>
            ))}
          </ul>
          {!matched.length && <p>No listings match that search.</p>}
        </section>
      </>
    )}
  </div>
</BaseLayout>
