---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { businesses } from '../data/businesses';

const [events, news, social, updates] = await Promise.all([
  getCollection('events'),
  getCollection('news'),
  getCollection('social'),
  getCollection('updates'),
]);

const hubs = [
  '/',
  '/events',
  '/news',
  '/development',
  '/this-weekend',
  '/scores',
  '/results',
  '/videos',
  '/weather',
  '/government',
  '/government/court-decisions',
  '/new-here',
  '/groups',
  '/social',
  '/schools',
  '/alerts',
  '/roads',
  '/phone-numbers',
  '/burn-ban',
  '/calendar',
  '/about',
  '/advertise',
  '/businesses',
  '/submit',
  '/tips',
  '/upgrade',
  '/bastrop',
  '/elgin',
  '/smithville',
  '/cedar-creek',
  '/mcdade',
  '/paige',
];

const links = [
  ...hubs.map((path) => ({ href: path, label: path === '/' ? 'Front page' : path })),
  ...businesses.map((business) => ({ href: `/${business.slug}`, label: business.name })),
  ...news
    .slice()
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
    .map((story) => ({ href: `/news/${story.id}`, label: story.data.title })),
  ...social
    .slice()
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
    .map((item) => ({ href: `/social/${item.id}`, label: item.data.title })),
  ...updates.map((item) => ({ href: `/government/${item.id}`, label: item.data.title })),
  ...events
    .slice()
    .sort((a, b) => a.data.start.getTime() - b.data.start.getTime())
    .map((event) => ({ href: `/events/${event.id}`, label: event.data.title })),
];

const total = links.length;
---

<BaseLayout
  title="Sitemap"
  description="Every public Bastropia page in one list. Search engines should use /sitemap.xml."
>
  <article class="wrap">
    <header class="page-head" style="padding-left:0;padding-right:0;width:auto;">
      <p class="kicker">For people</p>
      <h1>Sitemap</h1>
      <p class="lede">
        {total} public pages. For Google Search Console, submit
        <a class="text-link" href="/sitemap.xml">bastropia.com/sitemap.xml</a>.
      </p>
    </header>
    <ul class="sitemap-list">
      {links.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
  </article>
</BaseLayout>

<style>
  .sitemap-list {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 1;
    gap: 2rem;
  }
  @media (min-width: 760px) {
    .sitemap-list { columns: 2; }
  }
  .sitemap-list li {
    break-inside: avoid;
    padding: 0.28rem 0;
    border-bottom: 1px solid var(--line);
  }
  .sitemap-list a {
    text-decoration: none;
    color: inherit;
  }
  .sitemap-list a:hover {
    text-decoration: underline;
    text-underline-offset: 0.1em;
  }
</style>
