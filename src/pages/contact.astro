---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { facebookGroup, newsroomEmail } from '../data/site';
import { offsiteAttrs } from '../lib/links';
---

<BaseLayout
  title="Contact"
  description="News tips, corrections, and advertising for Bastropia. Email news@bastropia.com. No phone or street address."
>
  <PageHead
    kicker="Newsroom"
    title="Contact the newsroom"
    lede={`Write ${newsroomEmail}. Bastropia does not publish a newsroom phone number or a street address.`}
  />
  <div class="wrap prose">
    <h2>News tips</h2>
    <p>
      Email <a href={`mailto:${newsroomEmail}`}>{newsroomEmail}</a> or use the <a href="/tips">tip form</a>. Say what you saw, where, and when. A photo can ride along. A person reads every note.
    </p>
    <h2>Corrections</h2>
    <p>
      Email <a href={`mailto:${newsroomEmail}`}>{newsroomEmail}</a> with the story link, the sentence that is wrong, and the public record that shows the right fact. The <a href="/corrections-policy">corrections policy</a> says how a fix is labeled.
    </p>
    <h2>Advertising</h2>
    <p>
      Email <a href={`mailto:${newsroomEmail}`}>{newsroomEmail}</a> or use the form on the <a href="/advertise">advertise</a> page. A paid placement is labeled. It is not a news story.
    </p>
    <p>
      The <a href={facebookGroup} {...offsiteAttrs(facebookGroup)}>Bastropia Facebook group</a> is public. It is not a private line to the newsroom.
    </p>
    <p>
      Bastropia is not Bastrop County, a city, or an emergency service. For a fire, a crime, or a medical emergency, call 911. Office numbers for the sheriff, the cities, and the schools are on the <a href="/phone-numbers">phone numbers</a> page.
    </p>
  </div>
</BaseLayout>
