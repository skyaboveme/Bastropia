---
export const prerender = false;

import '../styles/directory.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import DirectoryCard from '../components/DirectoryCard.astro';
import DirectoryPromo from '../components/DirectoryPromo.astro';
import { directoryTowns } from '../data/taxonomy';
import { composeDirectoryFeed, directoryInquireHref, directoryProductById, directoryToday, resolveDirectorySpotlight } from '../lib/directoryAds';
import { loadDirectoryEntries } from '../lib/directoryFeed';
import { directoryGridGroups, directoryMoreGroups, groupShort } from '../lib/directoryGroups';
import { directoryMatcher } from '../lib/directoryMatch';
import { money } from '../lib/format';
import { buildDirectoryView, directoryPageSize, entryToIndexRow, type DirectoryQueryState } from '../lib/directoryView';

const params = Astro.url.searchParams;
const rawQ = (params.get('q') || '').trim().slice(0, 80);
const parsed = directoryMatcher().parse(rawQ);
const requestedTown = params.get('town') || '';
const townValid = requestedTown === 'Countywide' || (directoryTowns as readonly string[]).includes(requestedTown);
const town = townValid ? requestedTown : parsed.town || '';
const category = (params.get('category') || '').trim().slice(0, 80);
const sub = (params.get('sub') || '').trim().slice(0, 80);
const sortParam = params.get('sort') || '';
const sort = sortParam === 'az' || sortParam === 'near' ? sortParam : '';
const wide = params.get('wide') === '1';
const page = Math.max(1, Number.parseInt(params.get('page') || '1', 10) || 1);
const q = parsed.town && (!townValid || parsed.town === town) ? parsed.text : rawQ;

const all = await loadDirectoryEntries();
const rows = all.map(entryToIndexRow);
const state: DirectoryQueryState = { q, town, category, sub, sort, wide };
const view = buildDirectoryView(rows, state, { limit: page * directoryPageSize() });
const filtered = view.mode === 'results';
const grid = directoryGridGroups();
const moreGroups = directoryMoreGroups();
const categoryLabel = groupShort(category) || category;
const townSource = townValid ? 'chip' : parsed.town ? 'query' : '';
const inputValue = townSource === 'query' ? rawQ : view.input;
const popular = [
  ['Plumber', 'plumber'],
  ['AC repair', 'ac repair'],
  ['Mexican food', 'mexican food'],
  ['Vet', 'vet'],
  ['Mechanic', 'mechanic'],
] as const;

function href(overrides: Partial<DirectoryQueryState> & { page?: number | null }) {
  const next = { ...state, ...overrides };
  const query = new URLSearchParams();
  if (next.q) query.set('q', next.q);
  if (next.town) query.set('town', next.town);
  if (next.category) query.set('category', next.category);
  if (next.sub) query.set('sub', next.sub);
  if (next.sort) query.set('sort', next.sort);
  if (next.wide) query.set('wide', '1');
  if (overrides.page && overrides.page > 1) query.set('page', String(overrides.page));
  const search = query.toString();
  return search ? `/directory?${search}` : '/directory';
}

const todayKey = directoryToday();
const adContext = { town, category };
const spotlight = filtered ? resolveDirectorySpotlight(adContext, todayKey) : null;
const feed = composeDirectoryFeed(view.matches, adContext, todayKey);
const countyFeed = view.matches.length === 0
  ? composeDirectoryFeed(view.countywide, adContext, todayKey)
  : view.countywide.map((card) => ({ kind: 'card' as const, card }));
const partners = all.filter((entry) => entry.source === 'partner');
const featuredProduct = directoryProductById('featured');
const featuredRate = featuredProduct?.price ? money(featuredProduct.price) : '';

const title = category && town && town !== 'Countywide'
  ? `${categoryLabel} in ${town}`
  : category
    ? `${categoryLabel} in Bastrop County`
    : town && town !== 'Countywide'
      ? `Businesses in ${town}`
      : q
        ? `Businesses matching “${q}”`
        : 'Find a local business';
const description = 'Find Bastrop County businesses by town and trade. Free listings, with phone numbers and directions.';
const canonicalParams = new URLSearchParams();
if (category) canonicalParams.set('category', category);
if (town) canonicalParams.set('town', town);
const canonicalPath = canonicalParams.toString() ? `/directory?${canonicalParams}` : '/directory';
const towns = directoryTowns.filter((name) => rows.some((row) => row.t === name));
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  noindex={Boolean(q) || page > 1}
  nofollow={false}
  stickyBar
>
  <div
    class="dir"
    id="directory-app"
    data-mode={view.mode}
    data-q={state.q}
    data-town={state.town}
    data-category={state.category}
    data-sub={state.sub}
    data-sort={state.sort}
    data-wide={state.wide ? '1' : '0'}
    data-town-source={townSource}
    data-page={String(page)}
    data-count={String(rows.length)}
  >
    <div class="dir-layout">
      <aside class="dir-side" aria-label="Filters">
        <h2>Town</h2>
        <a href={href({ town: '' })} aria-current={!town ? 'true' : undefined}>All towns</a>
        {towns.map((name) => (
          <a href={href({ town: name })} aria-current={town === name ? 'true' : undefined}>{name}</a>
        ))}
        <h2>Category</h2>
        <a href={href({ category: '', sub: '' })} aria-current={!category ? 'true' : undefined}>All categories</a>
        {grid.map((group) => (
          <a href={href({ category: group.id, sub: '' })} aria-current={category === group.id ? 'true' : undefined}>{group.short}</a>
        ))}
        {moreGroups.map((group) => (
          <a href={href({ category: group.id, sub: '' })} aria-current={category === group.id ? 'true' : undefined}>{group.short}</a>
        ))}
        <h2>Sort</h2>
        <a href={href({ sort: '' })} aria-current={!sort ? 'true' : undefined}>Relevance</a>
        <a href={href({ sort: 'az' })} aria-current={sort === 'az' ? 'true' : undefined}>A–Z</a>
        <a href={href({ sort: 'near' })} aria-current={sort === 'near' ? 'true' : undefined}>Nearest</a>
      </aside>

      <div class="dir-main">
        <div class="dir-dock" id="directory-dock">
          <form class="looking" method="get" action="/directory" role="search">
            <label class="sr" for="q">Search businesses</label>
            <div class="looking-bar">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
                <path d="M16 16.5 20.5 21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
              </svg>
              <input
                id="q"
                type="search"
                name="q"
                value={inputValue}
                placeholder="Plumber, tacos, dentist…"
                autocomplete="off"
                autocapitalize="none"
                autocorrect="off"
                spellcheck="false"
                enterkeyhint="search"
              />
              <button class="looking-clear" type="button" aria-label="Clear search" hidden={!view.input}>×</button>
              {town ? <input type="hidden" name="town" value={town} /> : null}
              {category ? <input type="hidden" name="category" value={category} /> : null}
              {sub ? <input type="hidden" name="sub" value={sub} /> : null}
              {sort ? <input type="hidden" name="sort" value={sort} /> : null}
            </div>
          </form>
          <div class="dir-filters" aria-label="Active filters">
            <span class:list={['dir-chip', town && 'is-on']} data-chip-wrap="town">
              <button type="button" data-chip="town" data-sheet-open>
                <span data-chip-label>{town ? `📍 ${town}` : 'Town'}</span>
              </button>
              <a class="dir-x" data-clear="town" href={href({ town: '' })} aria-label={town ? `Remove ${town} filter` : 'Remove town filter'} hidden={!town}>×</a>
            </span>
            <span class:list={['dir-chip', category && 'is-on']} data-chip-wrap="category">
              <button type="button" data-chip="category" data-sheet-open>
                <span data-chip-label>{category ? categoryLabel : 'Category'}</span>
              </button>
              <a class="dir-x" data-clear="category" href={href({ category: '', sub: '' })} aria-label={category ? `Remove ${categoryLabel} filter` : 'Remove category filter'} hidden={!category}>×</a>
            </span>
            <button type="button" class:list={['dir-chip', sort && 'is-on']} data-chip="sort" data-sheet-open>
              <span data-chip-label>{sort === 'near' ? 'Nearest' : sort === 'az' ? 'A–Z' : 'Sort'}</span>
            </button>
          </div>
          <div id="directory-recent" class="dir-recent" hidden></div>
        </div>

        <header class="dir-intro">
          <h1>Find a local business</h1>
          <p>{rows.length} businesses across Bastrop County</p>
        </header>

        <section class="dir-browse" aria-label="Browse">
          <div class="dir-towns" role="radiogroup" aria-label="Town">
            <a href={href({ town: '' })} aria-checked={!town ? 'true' : 'false'} role="radio">All towns</a>
            {towns.map((name) => (
              <a href={href({ town: name })} aria-checked={town === name ? 'true' : 'false'} role="radio">{name}</a>
            ))}
          </div>
          <h2 class="dir-kicker">Browse</h2>
          <ul class="dir-grid">
            {grid.map((group) => (
              <li>
                <a href={href({ category: group.id, sub: '' })}>
                  <CategoryIcon icon={group.icon} />
                  <span>{group.short}</span>
                </a>
              </li>
            ))}
          </ul>
          <h2 class="dir-kicker">Popular</h2>
          <div class="dir-popular">
            {popular.map(([label, fill]) => (
              <a href={href({ q: fill, town: '', category: '', sub: '' })} data-fill={fill}>{label}</a>
            ))}
          </div>
          {partners.length > 0 && (
            <div class="dir-partners">
              <h2 class="dir-kicker">Partners</h2>
              <ul>
                {partners.map((entry, index) => (
                  <li>
                    <a href={entry.href}>
                      {entry.logo ? <img src={entry.logo} alt="" width="96" height="96" loading="lazy" decoding="async" /> : null}
                      <strong>{entry.name}</strong>
                      <span class="badge badge-partner">Partner</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
          <p class="dir-claim">
            Is this your business? <a href={directoryInquireHref('featured')}>Claim it / Get Featured{featuredRate ? ` · ${featuredRate}/mo` : ''}</a>
          </p>
          <p class="dir-own"><span>Own a business here?</span> <a href="/directory/submit">List it free</a></p>
        </section>

        <section class="dir-results" id="directory-results" aria-label="Businesses">
          <h2 id="directory-heading">{filtered ? view.heading : 'All businesses'}</h2>
          <p id="directory-count" class="sr" aria-live="polite">{view.live}</p>
          <p id="directory-range" class="dir-range" hidden={!view.range}>{view.range}</p>
          <div id="directory-spotlight">
            {spotlight && <DirectoryPromo ad={spotlight} variant="tile" />}
          </div>
          <div id="directory-empty" hidden={!view.empty}>
            {view.empty && (
              <>
                <p class="dir-empty-title">
                  No matches for <strong>{view.empty.query ? `“${view.empty.query}”` : 'that filter'}</strong>
                  {view.empty.town && view.empty.town !== 'Countywide' ? <> in <strong>{view.empty.town}</strong></> : null}.
                </p>
                {view.empty.countyCount > 0 && (
                  <a href={href({ town: '' })}>{view.empty.countyCount} {view.empty.countyCount === 1 ? 'match' : 'matches'} in all of Bastrop County</a>
                )}
                {view.empty.suggestion && (
                  <p>Try <a href={href({ q: view.empty.suggestion.term, town: '' })}>{view.empty.suggestion.term}</a> ({view.empty.suggestion.count})</p>
                )}
                <div class="dir-empty-grid">
                  {view.empty.groups.map((group) => (
                    <a href={href({ q: '', town: '', category: group.id, sub: '' })}>
                      <CategoryIcon icon={group.icon} />
                      <span>{group.label}</span>
                    </a>
                  ))}
                </div>
                <p>Know a business we’re missing? <a href="/directory/submit">Tell us</a></p>
              </>
            )}
          </div>
          <div id="directory-list">
            {filtered && feed.length > 0 && (
              <ul class="biz-list">
                {feed.map((item) => item.kind === 'ad' ? <DirectoryPromo ad={item.ad} variant="card" /> : <DirectoryCard card={item.card} />)}
              </ul>
            )}
          </div>
          <div id="directory-county" hidden={view.countywideTotal === 0}>
            {view.countywideTotal > 0 && (
              <>
                {view.fallback ? (
                  <p class="dir-county-line">
                    {view.fallback.detail}
                    <a class="dir-see" href={href({ town: '' })}>{view.fallback.seeAll} →</a>
                  </p>
                ) : (
                  <p class="dir-county-line">{view.countywideTotal} more have no street address on file</p>
                )}
                {view.matches.length > 0 && !wide && !view.fallback ? (
                  <a class="dir-more" href={href({ wide: true })}>Show listings with no street address</a>
                ) : (
                  <ul class="biz-list">
                    {countyFeed.map((item) => item.kind === 'ad' ? <DirectoryPromo ad={item.ad} variant="card" /> : <DirectoryCard card={item.card} />)}
                  </ul>
                )}
              </>
            )}
          </div>
          <p class="dir-pager">
            {page > 1 && <a class="dir-more" href={href({ page: page - 1 })}>Previous</a>}
            <a class="dir-more" id="directory-more" href={href({ page: page + 1 })} hidden={view.matches.length >= view.total}>Show 24 more</a>
          </p>
          {filtered && !view.empty && <p class="dir-missing">Missing a business? <a href="/directory/submit">Add it free</a></p>}
        </section>
      </div>
    </div>

    <details class="dir-extra">
      <summary>Partner pages</summary>
      <p>A free listing puts your name, trade, town, and phone on this directory. A partner page adds a branded landing page.</p>
      <p class="dir-extra-links">
        <a href="/directory/submit">List your business free</a>
        <a href="/advertise">Ask about a partner page</a>
      </p>
    </details>

    <button type="button" id="directory-top" class="dir-fab" hidden>Top</button>

    <dialog id="directory-sheet" aria-labelledby="directory-sheet-title">
      <div class="dir-grab" aria-hidden="true"></div>
      <div class="dir-sheet-head">
        <h2 id="directory-sheet-title">Filters</h2>
        <button type="button" data-sheet-reset>Reset</button>
      </div>
      <div class="dir-sheet-body">
        <p class="dir-kicker">Town</p>
        <div class="dir-sheet-towns" data-sheet-towns></div>
        <p class="dir-kicker">Category</p>
        <div data-sheet-cats></div>
        <p class="dir-kicker">More</p>
        <div data-sheet-more></div>
        <div hidden>
          <p class="dir-kicker">Within this category</p>
          <div class="dir-sheet-towns" data-sheet-subs></div>
        </div>
        <p class="dir-kicker">Sort</p>
        <div class="dir-sheet-sort">
          <button type="button" data-sort="" class={!sort ? 'is-on' : undefined} aria-pressed={!sort ? 'true' : 'false'}>Relevance</button>
          <button type="button" data-sort="az" class={sort === 'az' ? 'is-on' : undefined} aria-pressed={sort === 'az' ? 'true' : 'false'}>A–Z</button>
          <button type="button" data-sort="near" class={sort === 'near' ? 'is-on' : undefined} aria-pressed={sort === 'near' ? 'true' : 'false'}>Nearest</button>
        </div>
      </div>
      <button type="button" class="dir-apply" data-sheet-apply>Show places</button>
    </dialog>
  </div>
  <script>
    import { bootDirectory } from '../scripts/directoryPage.ts';
    bootDirectory();
  </script>
</BaseLayout>
