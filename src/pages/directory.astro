---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import HomeBanner from '../components/HomeBanner.astro';
import PageHead from '../components/PageHead.astro';
import { categoryIcon, categoryIconSvg } from '../data/categoryIcons';
import {
  directoryByCategory,
  directoryEntries,
  directoryTownOptions,
  filterDirectory,
  type DirectoryEntry,
} from '../data/directory';
import { listLiveBusinesses, toDirectoryEntry } from '../lib/businessDb';

const params = Astro.url.searchParams;
const category = params.get('category');
const town = params.get('town');
const q = params.get('q');
const filtered = Boolean(category || town || q);
const showResults = Boolean(category || (q && q.trim()));
const listed = (await listLiveBusinesses()).map(toDirectoryEntry);
const nameKey = (name: string) => name.toLowerCase().replace(/&/g, ' and ').replace(/[^a-z0-9]+/g, ' ').replace(/\s+/g, ' ').trim();
const listedNames = new Set(listed.map((entry) => nameKey(entry.name)));
const staticEntries = directoryEntries.filter((entry) => entry.source === 'partner' || !listedNames.has(nameKey(entry.name)));
const all = [...listed, ...staticEntries];
const inTown = filterDirectory({ town }, all);
const visible = filterDirectory({ category, town, q }, all).sort((a, b) => {
  const rank = (entry: DirectoryEntry) => (entry.source === 'partner' ? 0 : 1);
  return rank(a) - rank(b) || a.name.localeCompare(b.name);
});
const categories = directoryByCategory(inTown)
  .map(([name, items]) => ({ name, count: items.length, icon: categoryIcon(name) }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
const towns = directoryTownOptions(all);

const title =
  category && town
    ? `${category} in ${town}`
    : category
      ? `${category} in Bastrop County`
      : town
        ? `Businesses in ${town}`
        : q
          ? `Businesses matching “${q}”`
          : 'Bastrop County business directory';

const description =
  category && town
    ? `${category} businesses serving ${town} and nearby Bastrop County towns.`
    : 'Find Bastrop County businesses by category and town, including Bastrop Regional Chamber members. Free listings, with paid landing pages for partners.';

function href(overrides: Record<string, string | null>) {
  const next = new URLSearchParams();
  const merged = { category, town, q, ...overrides };
  for (const [key, value] of Object.entries(merged)) {
    if (value) next.set(key, value);
  }
  const search = next.toString();
  return search ? `/directory?${search}` : '/directory';
}

function external(url: string) {
  return url.startsWith('http');
}

const searchRows = inTown
  .map((entry) => ({
    n: entry.name,
    c: entry.category,
    t: entry.town || '',
    p: entry.place && entry.place !== entry.town && entry.place !== 'Bastrop County' ? entry.place : '',
    h: entry.href,
    ph: entry.phone || '',
    pt: entry.phoneHref || '',
    w: entry.website || '',
    hr: entry.hours || '',
    ds: entry.dailySpecial || '',
    su: entry.source === 'chamber' ? '' : entry.summary || '',
    pr: entry.source === 'partner' ? 1 : 0,
    i: categoryIcon(entry.category),
    q: `${entry.name} ${entry.category} ${entry.place} ${entry.summary}`.toLowerCase(),
  }))
  .sort((a, b) => Number(b.pr) - Number(a.pr) || a.n.localeCompare(b.n));
const searchIcons = Object.fromEntries(
  [...new Set(searchRows.map((row) => row.i))].map((key) => [key, categoryIconSvg[key] || categoryIconSvg.store]),
);
const searchIndex = JSON.stringify({ rows: searchRows, icons: searchIcons }).replace(/</g, '\\u003c');
---

<BaseLayout title={title} description={description} noindex={filtered} nofollow={false}>
  <PageHead
    kicker="Directory"
    title={title}
    lede="Chamber members and local listings. Search for what you need, or pick a category."
  />
  <div class="wrap">
    <form class="looking" method="get" action="/directory" role="search">
      <label class="looking-label" for="q">Looking for</label>
      <div class="looking-bar">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
          <path d="M16 16.5 20.5 21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
        <input id="q" type="search" name="q" value={q || ''} placeholder="plumber, dentist, coffee" autocomplete="off" enterkeyhint="search" />
        <button class="looking-clear" type="button" aria-label="Clear search" hidden={!q}>×</button>
        {category ? <input type="hidden" name="category" value={category} /> : null}
        {town ? <input type="hidden" name="town" value={town} /> : null}
      </div>
    </form>
    <p class="looking-note">
      <a class="text-link" href="/directory/submit">List your business free</a>
      <span aria-hidden="true"> · </span>
      <a class="text-link" href="/advertise">Paid partner pages</a>
    </p>

    <div class="filter-row town-row">
      <span>Town</span>
      <a class="chip" href={href({ town: null })} aria-current={!town ? 'true' : undefined}>All</a>
      {towns.map((item) => (
        <a class="chip" href={href({ town: item })} aria-current={town === item ? 'true' : undefined}>{item}</a>
      ))}
    </div>
    {filtered && (
      <p class="meta">
        <a class="text-link" href="/directory">Clear filters</a>
      </p>
    )}

    <section class="section" id="directory-results" hidden={!showResults} data-category={category || ''} aria-label="Matching businesses">
      {category && (
        <div class="cat-current">
          <span class="cat-mark" aria-hidden="true">
            <CategoryIcon icon={categoryIcon(category)} large />
          </span>
          <div>
            <h2>{category}{town ? ` in ${town}` : ''}</h2>
            <a class="text-link" href={href({ category: null, q: null })}>All categories</a>
          </div>
        </div>
      )}
      <p class="meta" id="directory-count" aria-live="polite">
        {showResults ? `${visible.length} ${visible.length === 1 ? 'business' : 'businesses'}${town ? ` in ${town}` : ''}.` : ''}
      </p>
      <div id="directory-list">
        {showResults && visible.length === 0 ? (
          <p>Nothing matches that search. Try another word, or <a class="text-link" href="/directory/submit">submit a business</a>.</p>
        ) : showResults ? (
          <ul class="biz-list">
            {visible.map((entry) => (
              <li class="biz-row">
                <span class="biz-mark" aria-hidden="true">
                  <CategoryIcon icon={categoryIcon(entry.category)} large />
                </span>
                <div>
                  <a class="biz-name" href={entry.href} target={external(entry.href) ? '_blank' : undefined} rel={external(entry.href) ? 'noopener noreferrer' : undefined}>{entry.name}</a>
                  {entry.source === 'partner' ? <span class="badge">Partner page</span> : null}
                  <span class="biz-line">{entry.category} · {entry.town || 'Bastrop County'}</span>
                  {entry.place && entry.place !== entry.town && entry.place !== 'Bastrop County' && <span class="biz-line">{entry.place}</span>}
                  {entry.hours && <span class="biz-line">{entry.hours}</span>}
                  {entry.dailySpecial && <span class="biz-line">Daily special: {entry.dailySpecial}</span>}
                  {entry.source !== 'chamber' && entry.summary && <p class="biz-summary">{entry.summary}</p>}
                </div>
                {(entry.phone || entry.website) && (
                  <p class="biz-actions">
                    {entry.phoneHref ? <a href={entry.phoneHref}>{entry.phone}</a> : entry.phone}
                    {entry.website && (
                      <a href={entry.website} target="_blank" rel="noopener noreferrer">Website</a>
                    )}
                  </p>
                )}
              </li>
            ))}
          </ul>
        ) : null}
      </div>
    </section>
    <section class="section" id="directory-browse" hidden={showResults} aria-label="Categories">
      <p class="meta">
        {inTown.length} {inTown.length === 1 ? 'business' : 'businesses'}
        {town ? ` in ${town}` : ' in Bastrop County'}. Pick a category.
      </p>
      <ul class="cat-grid">
        {categories.map((item) => (
          <li>
            <a href={href({ category: item.name, q: null })}>
              <span class="cat-mark" aria-hidden="true">
                <CategoryIcon icon={item.icon} />
              </span>
              <span class="cat-name">{item.name}</span>
              <span class="cat-count">{item.count}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <div class="site-banner">
      <HomeBanner />
    </div>
    <template id="directory-row">
      <li class="biz-row">
        <span class="biz-mark" aria-hidden="true"><span class="cat-svg"></span></span>
        <div>
          <a class="biz-name"></a>
          <span class="badge">Partner page</span>
          <span class="biz-line" data-line="meta"></span>
          <span class="biz-line" data-line="place"></span>
          <span class="biz-line" data-line="hours"></span>
          <span class="biz-line" data-line="special"></span>
          <p class="biz-summary"></p>
        </div>
        <p class="biz-actions">
          <a data-act="phone"></a>
          <a data-act="site" target="_blank" rel="noopener noreferrer">Website</a>
        </p>
      </li>
    </template>
    <script id="directory-index" type="application/json" is:inline set:html={searchIndex}></script>
    <script is:inline>
      const indexNode = document.getElementById('directory-index');
      const input = document.getElementById('q');
      const clearButton = document.querySelector('.looking-clear');
      const results = document.getElementById('directory-results');
      const browse = document.getElementById('directory-browse');
      const listHost = document.getElementById('directory-list');
      const count = document.getElementById('directory-count');
      if (indexNode && input && results && listHost && count) {
        const data = JSON.parse(indexNode.textContent || '{"rows":[],"icons":{}}');
        const rows = data.rows || [];
        const icons = data.icons || {};
        const category = results.getAttribute('data-category') || '';
        const townLabel = new URL(location.href).searchParams.get('town') || '';
        const cap = 40;
        const hit = (row, needle) => {
          if (!needle) return true;
          const stem = needle.replace(/(ers|er|ists|ist|ing|s)$/i, '');
          const words = row.q.split(/[^a-z0-9]+/);
          return row.q.includes(needle) || (stem.length >= 4 && stem !== needle && words.some((word) => word.startsWith(stem)));
        };
        const template = document.getElementById('directory-row');
        const fillLine = (node, text) => {
          if (!text) {
            node.remove();
            return;
          }
          node.textContent = text;
        };
        const paint = (matches) => {
          browse && (browse.hidden = true);
          results.hidden = false;
          const shown = matches.slice(0, cap);
          const place = townLabel ? ' in ' + townLabel : '';
          count.textContent = shown.length < matches.length
            ? 'Showing ' + shown.length + ' of ' + matches.length + ' businesses' + place + '.'
            : matches.length + ' ' + (matches.length === 1 ? 'business' : 'businesses') + place + '.';
          listHost.replaceChildren();
          if (!shown.length) {
            const empty = document.createElement('p');
            empty.append('Nothing matches that search. Try another word, or ');
            const link = document.createElement('a');
            link.className = 'text-link';
            link.href = '/directory/submit';
            link.textContent = 'submit a business';
            empty.append(link, '.');
            listHost.append(empty);
            return;
          }
          const list = document.createElement('ul');
          list.className = 'biz-list';
          const scope = [...template.attributes].find((attr) => attr.name.startsWith('data-astro-cid'));
          if (scope) list.setAttribute(scope.name, scope.value);
          shown.forEach((row) => {
            const item = template.content.firstElementChild.cloneNode(true);
            const glyph = item.querySelector('.cat-svg');
            glyph.innerHTML = icons[row.i] || icons.store || '';
            const name = item.querySelector('.biz-name');
            name.href = row.h;
            name.textContent = row.n;
            if (/^https?:/i.test(row.h)) {
              name.target = '_blank';
              name.rel = 'noopener noreferrer';
            }
            if (!row.pr) item.querySelector('.badge').remove();
            fillLine(item.querySelector('[data-line="meta"]'), row.c + ' · ' + (row.t || 'Bastrop County'));
            fillLine(item.querySelector('[data-line="place"]'), row.p);
            fillLine(item.querySelector('[data-line="hours"]'), row.hr);
            fillLine(item.querySelector('[data-line="special"]'), row.ds ? 'Daily special: ' + row.ds : '');
            const summary = item.querySelector('.biz-summary');
            if (row.su) summary.textContent = row.su;
            else summary.remove();
            const actions = item.querySelector('.biz-actions');
            const phone = item.querySelector('[data-act="phone"]');
            const site = item.querySelector('[data-act="site"]');
            if (row.ph && row.pt) {
              phone.href = row.pt;
              phone.textContent = row.ph;
            } else if (row.ph) {
              phone.replaceWith(document.createTextNode(row.ph));
            } else phone.remove();
            if (row.w) site.href = row.w;
            else site.remove();
            if (!row.ph && !row.w) actions.remove();
            list.append(item);
          });
          listHost.append(list);
        };
        const apply = () => {
          const value = input.value.trim();
          if (clearButton) clearButton.hidden = !value;
          const url = new URL(location.href);
          if (value) url.searchParams.set('q', value);
          else url.searchParams.delete('q');
          history.replaceState(null, '', url);
          document.querySelectorAll('.town-row a').forEach((link) => {
            const next = new URL(link.href);
            if (value) next.searchParams.set('q', value);
            else next.searchParams.delete('q');
            link.href = next.pathname + next.search;
          });
          if (!value && !category) {
            results.hidden = true;
            if (browse) browse.hidden = false;
            return;
          }
          const needle = value.toLowerCase();
          paint(rows.filter((row) => (!category || row.c === category) && hit(row, needle)));
        };
        input.addEventListener('input', apply);
        clearButton?.addEventListener('click', () => {
          input.value = '';
          input.focus();
          apply();
        });
      }
    </script>

    <section class="notice" style="margin-top:1.5rem;">
      <p class="kicker" style="color: var(--river);">Partners</p>
      <h2>Free listing. Paid pages when you want the full treatment.</h2>
      <p class="lede" style="color:#d5e4dc;">
        Chamber members appear from the public Bastrop Regional Chamber directory. A free Bastropia note puts your name, trade, town, and phone on the desk. Partner pages like String Prairie and Barron Homes get a branded landing, LocalBusiness schema, and a share image.
      </p>
      <p class="cluster">
        <a class="button" href="/directory/submit">Submit free</a>
        <a class="button button-ghost" href="/advertise">Ask about a partner page</a>
        <a class="button button-ghost" href="https://business.bastropchamber.com/list" target="_blank" rel="noopener noreferrer">Chamber directory</a>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .looking {
    margin: 0.15rem 0 0.7rem;
  }
  .looking-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .looking-bar {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 3.4rem;
    padding: 0.2rem 0.45rem 0.2rem 0.95rem;
    background: #fff;
    border: 2px solid var(--ink);
    border-radius: 999px;
  }
  .looking-bar:focus-within {
    outline: 3px solid color-mix(in srgb, var(--river) 55%, white);
    outline-offset: 2px;
  }
  .looking-bar svg {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
    color: var(--ink);
  }
  .looking-bar input {
    flex: 1 1 auto;
    min-width: 0;
    border: 0;
    background: transparent;
    font: inherit;
    font-size: 1.12rem;
    padding: 0.7rem 0;
    color: var(--ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .looking-bar input:focus {
    outline: none;
  }
  .looking-bar input::-webkit-search-cancel-button {
    display: none;
  }
  .looking-clear {
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    font-size: 1.45rem;
    line-height: 1;
    cursor: pointer;
  }
  .looking-clear:hover {
    background: var(--paper-2);
  }
  .looking-clear[hidden] {
    display: none;
  }
  .biz-mark :global(svg) {
    width: 2rem;
    height: 2rem;
    display: block;
  }
  .looking-note {
    margin: 0.45rem 0 0.8rem;
    color: var(--ink-soft);
  }
  .town-row {
    margin-bottom: 0.35rem;
  }
  .cat-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8.6rem, 1fr));
    gap: 0.55rem;
    margin: 0.7rem 0 1.2rem;
    padding: 0;
  }
  .cat-grid a {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 0.35rem;
    min-height: 8.2rem;
    padding: 0.8rem 0.45rem 0.65rem;
    text-align: center;
    text-decoration: none;
    color: inherit;
    background: #fff;
    border: 1px solid var(--line);
  }
  .cat-grid a:hover {
    border-color: var(--ink);
    background: var(--paper-2);
  }
  .cat-mark {
    width: 3.1rem;
    height: 3.1rem;
    display: grid;
    place-items: center;
    border-radius: 0.45rem;
    background: var(--paper-2);
    color: var(--pine-deep);
  }
  .cat-grid a:hover .cat-mark,
  .cat-current .cat-mark {
    background: var(--pine-deep);
    color: #f4efe6;
  }
  .cat-name {
    font-size: 0.86rem;
    font-weight: 650;
    line-height: 1.2;
  }
  .cat-count {
    color: var(--ink-soft);
    font-size: 0.78rem;
  }
  .cat-current {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin: 0.2rem 0 0.6rem;
  }
  .cat-current h2 {
    font-size: clamp(1.45rem, 2.4vw, 1.9rem);
    margin: 0;
  }
  .biz-list {
    list-style: none;
    margin: 0.3rem 0 1.2rem;
    padding: 0;
  }
  .biz-row {
    display: grid;
    grid-template-columns: 4.4rem minmax(0, 1fr);
    gap: 0.35rem 0.9rem;
    align-items: start;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
  }
  .biz-mark {
    width: 4.4rem;
    height: 4.4rem;
    border-radius: 0.4rem;
    background: var(--pine-deep);
    color: #f4efe6;
    display: grid;
    place-items: center;
  }
  .biz-name {
    font-family: var(--serif);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.15;
    text-decoration: none;
    color: inherit;
  }
  .biz-name:hover {
    text-decoration: underline;
    text-underline-offset: 0.08em;
  }
  .badge {
    display: inline-block;
    margin-left: 0.4rem;
    padding: 0.08rem 0.4rem;
    border: 1px solid color-mix(in srgb, var(--river) 35%, transparent);
    border-radius: 4px;
    color: var(--river);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    vertical-align: middle;
  }
  .biz-line {
    display: block;
    margin-top: 0.16rem;
    color: var(--ink-soft);
    font-size: 0.92rem;
  }
  .biz-summary {
    margin: 0.28rem 0 0;
    color: var(--ink-soft);
    font-size: 0.92rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .biz-actions {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.9rem;
    margin: 0.15rem 0 0;
    font-size: 0.92rem;
  }
</style>
