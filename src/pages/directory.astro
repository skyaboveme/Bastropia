---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import HomeBanner from '../components/HomeBanner.astro';
import { categoryIcon, categoryIconSvg } from '../data/categoryIcons';
import { publicCategories, publicCategoryBySlug, publicCategoryFor } from '../data/directoryCategories';
import { filterDirectory, type DirectoryEntry } from '../data/directory';
import { directoryTowns } from '../data/taxonomy';
import { loadDirectoryEntries } from '../lib/directoryFeed';
import { outboundLabel } from '../lib/maps';

const params = Astro.url.searchParams;
const requestedTown = params.get('town');
const town =
  requestedTown === 'Countywide' || (directoryTowns as readonly string[]).includes(requestedTown || '')
    ? requestedTown || ''
    : '';
const category = (params.get('category') || '').trim().slice(0, 80);
const q = (params.get('q') || '').trim().slice(0, 80);
const page = Math.max(1, Number.parseInt(params.get('page') || '1', 10) || 1);
const pageSize = 24;
const group = publicCategoryBySlug(category);
const categoryLabel = group?.label || category;
const filtered = Boolean(category || town || q);

const all = await loadDirectoryEntries();
const visible = filterDirectory({ category, town, q }, all);
const start = (page - 1) * pageSize;
const shown = visible.slice(start, start + pageSize);
const placeLabel = town ? ` in ${town}` : '';
const kind = categoryLabel ? `${categoryLabel} ` : '';
const from = visible.length ? start + 1 : 0;
const to = start + shown.length;
const countText = !visible.length
  ? `No ${kind}businesses${placeLabel}.`
  : to < visible.length
    ? `Showing ${from}–${to} of ${visible.length} ${kind}businesses${placeLabel}.`
    : `${visible.length} ${kind}${visible.length === 1 ? 'business' : 'businesses'}${placeLabel}.`;

const title = group && town
  ? `${group.label} in ${town}`
  : group
    ? `${group.label} in Bastrop County`
    : category && town
      ? `${category} in ${town}`
      : category
        ? `${category} in Bastrop County`
        : town
          ? `Businesses in ${town}`
          : q
            ? `Businesses matching “${q}”`
            : 'Bastrop County business directory';

const description = group && town
  ? `${group.label} businesses in ${town}, Bastrop County, with phone numbers, hours, and directions.`
  : group
    ? `${group.label} businesses across Bastrop County, with phone numbers, hours, and directions.`
    : category && town
      ? `${category} businesses in ${town}, Bastrop County, with phone numbers, hours, and directions.`
      : category
        ? `${category} businesses across Bastrop County, with phone numbers, hours, and directions.`
        : town
          ? `Businesses in ${town}, Bastrop County. Browse by category or search by name, with phone numbers and directions.`
          : 'Find Bastrop County businesses by town and category. Free listings, with phone numbers, hours, and directions.';

const canonicalParams = new URLSearchParams();
if (category) canonicalParams.set('category', category);
if (town) canonicalParams.set('town', town);
const canonicalPath = canonicalParams.toString() ? `/directory?${canonicalParams}` : '/directory';

function href(overrides: Record<string, string | null>) {
  const next = new URLSearchParams();
  const merged = { category, town, q, ...overrides };
  for (const [key, value] of Object.entries(merged)) {
    if (value) next.set(key, value);
  }
  const search = next.toString();
  return search ? `/directory?${search}` : '/directory';
}

function pageHref(nextPage: number) {
  const next = new URLSearchParams();
  if (category) next.set('category', category);
  if (town) next.set('town', town);
  if (q) next.set('q', q);
  if (nextPage > 1) next.set('page', String(nextPage));
  const search = next.toString();
  return search ? `/directory?${search}` : '/directory';
}

function external(url: string) {
  return url.startsWith('http');
}

function badgeOf(entry: DirectoryEntry) {
  if (entry.tier === 'featured') return 'Featured';
  if (entry.tier === 'spotlight') return 'Spotlight';
  if (entry.source === 'partner') return 'Partner page';
  return '';
}

function linksOf(entry: DirectoryEntry) {
  const siteIsFacebook = outboundLabel(entry.website) === 'Facebook';
  return {
    website: !siteIsFacebook ? entry.website || '' : '',
    facebook: entry.facebook || (siteIsFacebook ? entry.website || '' : ''),
  };
}

const townPool = filterDirectory({ category }, all);
const townCards = directoryTowns
  .map((name) => ({ town: name, count: filterDirectory({ category, town: name }, townPool).length }))
  .filter((card) => card.count > 0);
const countywideCount = townPool.filter((entry) => !entry.town).length;
const categoryPool = filterDirectory({ town }, all);
const categoryCards = publicCategories
  .map((item) => ({
    ...item,
    count: categoryPool.filter((entry) => publicCategoryFor(entry.category).slug === item.slug).length,
  }))
  .filter((item) => item.count > 0);
const resultsHeading = categoryLabel && town ? `${categoryLabel} in ${town}` : categoryLabel || (town ? `Businesses in ${town}` : 'All businesses');
const suggestions = ['plumber', 'dentist', 'coffee', 'restaurant'];

const searchRows = filterDirectory({ town }, all).map((entry) => {
  const entryGroup = publicCategoryFor(entry.category);
  const links = linksOf(entry);
  return {
    n: entry.name,
    c: entry.category,
    g: entryGroup.slug,
    gl: entryGroup.label,
    t: entry.town || '',
    p: entry.place && entry.place !== entry.town && entry.place !== 'Bastrop County' ? entry.place : '',
    h: entry.href,
    ph: entry.phone || '',
    pt: entry.phoneHref || '',
    w: links.website,
    fb: links.facebook,
    maps: entry.mapsUrl || '',
    hr: entry.hours || '',
    ds: entry.dailySpecial || '',
    su: entry.source === 'chamber' ? '' : entry.summary || '',
    r: entry.tier === 'featured' ? 0 : entry.tier === 'spotlight' ? 1 : entry.source === 'partner' ? 2 : 3,
    b: badgeOf(entry),
    i: categoryIcon(entry.category),
    lg: entry.logo || '',
  };
});
const searchIcons = Object.fromEntries(
  [...new Set(searchRows.map((row) => row.i))].map((key) => [key, categoryIconSvg[key] || categoryIconSvg.store]),
);
const searchIndex = JSON.stringify({ rows: searchRows, icons: searchIcons }, (key, value) => (value === '' ? undefined : value)).replace(/</g, '\\u003c');
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  noindex={Boolean(q) || page > 1}
  nofollow={false}
>
  <div class="wrap">
    <header class="directory-head">
      <h1>Bastrop County business directory</h1>
      <p class="lede">Search by name, or browse a town and a category. Listings are free.</p>
    </header>

    <div class="looking-row">
      <form class="looking" method="get" action="/directory" role="search">
        <label class="looking-label" for="q">Search businesses</label>
        <div class="looking-bar">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
            <path d="M16 16.5 20.5 21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
          <input id="q" type="search" name="q" value={q} placeholder="plumber, dentist, coffee" autocomplete="off" enterkeyhint="search" />
          <button class="looking-clear" type="button" aria-label="Clear search" hidden={!q}>×</button>
          {category ? <input type="hidden" name="category" value={category} /> : null}
          {town ? <input type="hidden" name="town" value={town} /> : null}
        </div>
      </form>
      <a class="button list-free" href="/directory/submit">List your business free</a>
    </div>

    {(town || category || q) && (
      <ul class="filter-chips">
        {town && (
          <li>
            <a href={href({ town: null })}>Town: {town} <span aria-hidden="true">×</span><span class="sr"> Remove town</span></a>
          </li>
        )}
        {category && (
          <li>
            <a href={href({ category: null })}>{categoryLabel} <span aria-hidden="true">×</span><span class="sr"> Remove category</span></a>
          </li>
        )}
        {q && (
          <li>
            <a href={href({ q: null })}>“{q}” <span aria-hidden="true">×</span><span class="sr"> Remove search</span></a>
          </li>
        )}
      </ul>
    )}

    <div class="suggest" aria-label="Common searches">
      {suggestions.map((word) => (
        <a href={href({ q: word })} data-fill={word}>{word}</a>
      ))}
    </div>

    <div class="directory-stack" id="directory-stack" data-mode={filtered ? 'results' : 'browse'}>
      <details class="atlas" id="directory-browse" open={!filtered}>
        <summary>Browse by town and category</summary>
        <h2 class="atlas-label">By town</h2>
        <ul class="town-cards">
          {townCards.map((card) => (
            <li>
              <a href={href({ town: card.town })} aria-current={town === card.town ? 'true' : undefined}>
                <strong>{card.count}</strong>
                <em>{card.town}</em>
              </a>
            </li>
          ))}
          {countywideCount > 0 && (
            <li>
              <a href={href({ town: 'Countywide' })} aria-current={town === 'Countywide' ? 'true' : undefined}>
                <strong>{countywideCount}</strong>
                <em>Countywide</em>
              </a>
            </li>
          )}
        </ul>
        <h2 class="atlas-label">All categories</h2>
        <label class="cat-find">
          <span class="sr">Find a category</span>
          <input id="category-find" type="search" placeholder="All categories" autocomplete="off" />
        </label>
        <ul class="trade-grid" id="cat-grid">
          {categoryCards.map((item) => (
            <li>
              <a href={href({ category: item.slug })} aria-current={category === item.slug ? 'true' : undefined}>
                <span class="trade-mark" aria-hidden="true"><CategoryIcon icon={item.icon} /></span>
                <strong>{item.label}</strong>
                <span>{item.count} {item.count === 1 ? 'listing' : 'listings'}</span>
              </a>
            </li>
          ))}
        </ul>
      </details>

      <section class="results" id="directory-results" data-category={category} data-town={town} data-label={categoryLabel} aria-label="Businesses">
        <h2 id="directory-heading">{resultsHeading}</h2>
        <p class="meta" id="directory-count" aria-live="polite">{countText}</p>
        <div id="directory-list">
          {visible.length === 0 ? (
            <p>Nothing matches that search. Try another word, or <a class="text-link" href="/directory/submit">list your business</a>.</p>
          ) : (
            <ul class="biz-list">
              {shown.map((entry) => {
                const links = linksOf(entry);
                const badge = badgeOf(entry);
                return (
                  <li class="biz-row">
                    <span class:list={['biz-mark', entry.logo && 'has-logo']} aria-hidden="true">
                      {entry.logo ? <img class="biz-logo" src={entry.logo} alt="" /> : <CategoryIcon icon={categoryIcon(entry.category)} />}
                    </span>
                    <div class="biz-copy">
                      <p class="biz-title">
                        <a class="biz-name" href={entry.href} target={external(entry.href) ? '_blank' : undefined} rel={external(entry.href) ? 'noopener noreferrer' : undefined}>{entry.name}</a>
                        {badge && <span class:list={['badge', entry.tier === 'featured' && 'badge-featured', entry.tier === 'spotlight' && 'badge-spotlight']}>{badge}</span>}
                      </p>
                      <span class="biz-line">{entry.category} · {entry.town || 'Countywide'}</span>
                      {entry.place && entry.place !== entry.town && entry.place !== 'Bastrop County' && <span class="biz-line">{entry.place}</span>}
                      {entry.hours && <span class="biz-line">{entry.hours}</span>}
                      {entry.dailySpecial && <span class="biz-line">Daily special: {entry.dailySpecial}</span>}
                      {entry.source !== 'chamber' && entry.summary && <p class="biz-summary">{entry.summary}</p>}
                      {(entry.phoneHref || entry.mapsUrl || links.website || links.facebook) && (
                        <p class="biz-actions">
                          {entry.phoneHref && <a class="button biz-call" href={entry.phoneHref}>Call {entry.phone}</a>}
                          {entry.mapsUrl && <a class="button button-ghost" href={entry.mapsUrl} target="_blank" rel="noopener noreferrer">Directions</a>}
                          {links.website && <a class="button button-ghost" href={links.website} target="_blank" rel="noopener noreferrer">Website</a>}
                          {links.facebook && <a class="button button-ghost" href={links.facebook} target="_blank" rel="noopener noreferrer">Facebook</a>}
                        </p>
                      )}
                    </div>
                  </li>
                );
              })}
            </ul>
          )}
        </div>
        <p class="more-row">
          {page > 1 && <a class="button button-ghost" href={pageHref(page - 1)}>Previous</a>}
          <a class="button button-ghost" id="directory-more" href={pageHref(page + 1)} hidden={to >= visible.length}>Show more</a>
        </p>
      </section>

      <details class="directory-extra">
        <summary>Ads and partner pages</summary>
        <div class="site-banner">
          <HomeBanner />
        </div>
        <section class="notice">
          <p class="kicker" style="color: var(--river);">Partners</p>
          <h2>Free listing. Paid pages when you want the full treatment.</h2>
          <p class="lede" style="color:#d5e4dc;">
            A free listing puts your name, trade, town, phone, and hours on this directory. Partner pages add a branded landing page.
          </p>
          <p class="cluster">
            <a class="button" href="/directory/submit">List your business free</a>
            <a class="button button-ghost" href="/advertise">Ask about a partner page</a>
          </p>
        </section>
      </details>
    </div>

    <template id="directory-row">
      <li class="biz-row">
        <span class="biz-mark" aria-hidden="true"><img class="biz-logo" alt="" hidden /><span class="cat-svg"></span></span>
        <div class="biz-copy">
          <p class="biz-title">
            <a class="biz-name"></a>
            <span class="badge"></span>
          </p>
          <span class="biz-line" data-line="meta"></span>
          <span class="biz-line" data-line="place"></span>
          <span class="biz-line" data-line="hours"></span>
          <span class="biz-line" data-line="special"></span>
          <p class="biz-summary"></p>
          <p class="biz-actions">
            <a class="button biz-call" data-act="phone"></a>
            <a class="button button-ghost" data-act="maps" target="_blank" rel="noopener noreferrer">Directions</a>
            <a class="button button-ghost" data-act="site" target="_blank" rel="noopener noreferrer">Website</a>
            <a class="button button-ghost" data-act="facebook" target="_blank" rel="noopener noreferrer">Facebook</a>
          </p>
        </div>
      </li>
    </template>
    <script id="directory-index" type="application/json" is:inline set:html={searchIndex}></script>
    <script is:inline>
      const indexNode = document.getElementById('directory-index');
      const input = document.getElementById('q');
      const clearButton = document.querySelector('.looking-clear');
      const results = document.getElementById('directory-results');
      const listHost = document.getElementById('directory-list');
      const count = document.getElementById('directory-count');
      const more = document.getElementById('directory-more');
      const template = document.getElementById('directory-row');
      const stack = document.getElementById('directory-stack');
      const browse = document.getElementById('directory-browse');
      const find = document.getElementById('category-find');
      if (indexNode && input && results && listHost && count && template) {
        const data = JSON.parse(indexNode.textContent || '{"rows":[],"icons":{}}');
        const rows = data.rows || [];
        const icons = data.icons || {};
        const category = results.getAttribute('data-category') || '';
        const townLabel = results.getAttribute('data-town') || '';
        const pageSize = 24;
        const serverPage = Math.max(1, parseInt(new URL(location.href).searchParams.get('page') || '1', 10) || 1);
        let clientMode = serverPage === 1;
        let limit = pageSize;
        const hay = (row) => [row.n, row.c, row.gl, row.p, row.su].filter(Boolean).join(' ').toLowerCase();
        const hit = (row, needle) => {
          if (!needle) return true;
          const text = hay(row);
          const stem = needle.replace(/(ers|er|ists|ist|ing|s)$/i, '');
          const words = text.split(/[^a-z0-9]+/);
          return text.includes(needle) || (stem.length >= 4 && stem !== needle && words.some((word) => word.startsWith(stem)));
        };
        const matchesCategory = (row) => {
          if (!category) return true;
          const wanted = category.toLowerCase();
          return row.g === category || row.gl.toLowerCase() === wanted || row.c.toLowerCase() === wanted;
        };
        const fillLine = (node, text) => {
          if (!text) {
            node.remove();
            return;
          }
          node.textContent = text;
        };
        const paint = () => {
          const needle = input.value.trim().toLowerCase();
          const matches = rows.filter((row) => matchesCategory(row) && hit(row, needle));
          const slice = matches.slice(0, limit);
          const place = townLabel ? ' in ' + townLabel : '';
          const kind = results.getAttribute('data-label') ? results.getAttribute('data-label') + ' ' : '';
          count.textContent = !matches.length
            ? 'No ' + kind + 'businesses' + place + '.'
            : slice.length < matches.length
              ? 'Showing 1–' + slice.length + ' of ' + matches.length + ' ' + kind + 'businesses' + place + '.'
              : matches.length + ' ' + kind + (matches.length === 1 ? 'business' : 'businesses') + place + '.';
          if (more) more.hidden = slice.length >= matches.length;
          listHost.replaceChildren();
          if (!slice.length) {
            const empty = document.createElement('p');
            empty.append('Nothing matches that search. Try another word, or ');
            const link = document.createElement('a');
            link.className = 'text-link';
            link.href = '/directory/submit';
            link.textContent = 'list your business';
            empty.append(link, '.');
            listHost.append(empty);
            return;
          }
          const list = document.createElement('ul');
          list.className = 'biz-list';
          const scope = [...template.attributes].find((attr) => attr.name.startsWith('data-astro-cid'));
          if (scope) list.setAttribute(scope.name, scope.value);
          slice.forEach((row) => {
            const item = template.content.firstElementChild.cloneNode(true);
            const mark = item.querySelector('.biz-mark');
            const glyph = item.querySelector('.cat-svg');
            const logo = item.querySelector('.biz-logo');
            if (row.lg) {
              logo.src = row.lg;
              logo.hidden = false;
              glyph.remove();
              mark.classList.add('has-logo');
            } else {
              logo.remove();
              glyph.innerHTML = icons[row.i] || icons.store || '';
            }
            const name = item.querySelector('.biz-name');
            name.href = row.h;
            name.textContent = row.n;
            if (/^https?:/i.test(row.h)) {
              name.target = '_blank';
              name.rel = 'noopener noreferrer';
            }
            const badge = item.querySelector('.badge');
            if (row.b) {
              badge.textContent = row.b;
              if (row.r === 0) badge.classList.add('badge-featured');
              if (row.r === 1) badge.classList.add('badge-spotlight');
            } else badge.remove();
            fillLine(item.querySelector('[data-line="meta"]'), row.c + ' · ' + (row.t || 'Countywide'));
            fillLine(item.querySelector('[data-line="place"]'), row.p);
            fillLine(item.querySelector('[data-line="hours"]'), row.hr);
            fillLine(item.querySelector('[data-line="special"]'), row.ds ? 'Daily special: ' + row.ds : '');
            const summary = item.querySelector('.biz-summary');
            if (row.su) summary.textContent = row.su;
            else summary.remove();
            const phone = item.querySelector('[data-act="phone"]');
            const maps = item.querySelector('[data-act="maps"]');
            const site = item.querySelector('[data-act="site"]');
            const facebook = item.querySelector('[data-act="facebook"]');
            if (row.pt) {
              phone.href = row.pt;
              phone.textContent = 'Call ' + row.ph;
            } else phone.remove();
            if (row.maps) maps.href = row.maps;
            else maps.remove();
            if (row.w) site.href = row.w;
            else site.remove();
            if (row.fb) facebook.href = row.fb;
            else facebook.remove();
            if (!row.pt && !row.maps && !row.w && !row.fb) item.querySelector('.biz-actions').remove();
            list.append(item);
          });
          listHost.append(list);
        };
        const setMode = (hasQuery) => {
          const active = Boolean(hasQuery || category || townLabel);
          if (stack) stack.dataset.mode = active ? 'results' : 'browse';
          if (browse && hasQuery) browse.open = false;
          if (browse && !active) browse.open = true;
        };
        const apply = () => {
          const value = input.value.trim();
          if (clearButton) clearButton.hidden = !value;
          const url = new URL(location.href);
          if (value) url.searchParams.set('q', value);
          else url.searchParams.delete('q');
          url.searchParams.delete('page');
          history.replaceState(null, '', url);
          clientMode = true;
          limit = pageSize;
          setMode(Boolean(value));
          paint();
        };
        input.addEventListener('input', apply);
        clearButton?.addEventListener('click', () => {
          input.value = '';
          input.focus();
          apply();
        });
        document.querySelectorAll('[data-fill]').forEach((link) => {
          link.addEventListener('click', (event) => {
            event.preventDefault();
            input.value = link.getAttribute('data-fill') || '';
            input.focus();
            apply();
          });
        });
        more?.addEventListener('click', (event) => {
          if (!clientMode && serverPage > 1) return;
          event.preventDefault();
          clientMode = true;
          limit += pageSize;
          paint();
        });
      }
      if (find) {
        const items = () => [...document.querySelectorAll('#cat-grid li')];
        find.addEventListener('input', () => {
          const needle = find.value.trim().toLowerCase();
          items().forEach((item) => {
            item.hidden = Boolean(needle) && !item.textContent.toLowerCase().includes(needle);
          });
        });
        find.addEventListener('keydown', (event) => {
          if (event.key !== 'Enter') return;
          const visible = items().filter((item) => !item.hidden);
          const link = visible.length === 1 ? visible[0].querySelector('a') : null;
          if (!link || !find.value.trim()) return;
          event.preventDefault();
          location.href = link.href;
        });
      }
    </script>
  </div>
</BaseLayout>

<style>
  .directory-head { padding: 0.15rem 0 0.85rem; }
  .directory-head h1 { margin: 0; font-size: clamp(2rem, 4vw, 3.05rem); }
  .directory-head .lede { margin-top: 0.3rem; max-width: 38rem; }
  .looking-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .looking { flex: 1 1 auto; margin: 0; min-width: 0; }
  .list-free { flex: none; }
  .looking-label, .cat-find span.sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .looking-bar {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 3.6rem;
    padding: 0.2rem 0.45rem 0.2rem 1rem;
    background: var(--paper);
    border: 3px solid var(--ink);
    border-radius: 999px;
  }
  .looking-bar:focus-within {
    outline: 3px solid color-mix(in srgb, var(--river) 55%, white);
    outline-offset: 2px;
  }
  .looking-bar svg { width: 1.35rem; height: 1.35rem; flex: none; }
  .looking-bar input {
    flex: 1 1 auto;
    min-width: 0;
    border: 0;
    background: transparent;
    font: inherit;
    font-size: 1.15rem;
    padding: 0.7rem 0;
    color: var(--ink);
  }
  .looking-bar input:focus { outline: none; }
  .looking-bar input::-webkit-search-cancel-button { display: none; }
  .looking-clear {
    width: 2.4rem;
    height: 2.4rem;
    flex: none;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }
  .looking-clear[hidden] { display: none; }
  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
  }
  .filter-chips a {
    display: inline-flex;
    align-items: center;
