---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import CountyFeeds from '../components/CountyFeeds.astro';
import VideoSection from '../components/VideoSection.astro';
---

<BaseLayout title="Videos" description="The newest video from each local YouTube channel, plus tours of Bastrop.">
  <PageHead
    kicker="Watch"
    title="Bastrop on video"
    lede="Local channels are first, with the newest video from each one. Tours of town are below."
  />
  <div class="wrap">
    <CountyFeeds />
    <VideoSection heading="Now playing" />
  </div>
</BaseLayout>
