---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import CountyFeeds from '../components/CountyFeeds.astro';
import VideoSection from '../components/VideoSection.astro';
---

<BaseLayout title="Videos" description="Elgin ISD board video, links to live county audio and high school games, and tours of Bastrop.">
  <PageHead
    kicker="Watch"
    title="Bastrop on video"
    lede="The Elgin ISD board recording plays here. Scanner audio, games, agendas, city meetings, and river gauges open on the site that publishes them. Tours of town are below."
  />
  <div class="wrap">
    <CountyFeeds heading="County feeds" />
    <VideoSection heading="Now playing" />
  </div>
</BaseLayout>
