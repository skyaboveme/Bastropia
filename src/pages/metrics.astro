---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { burnBan, burnStatus } from '../data/burnBan';
import { serviceGroups } from '../data/services';
import { getCountyNow } from '../lib/countyNow';
import { getSchoolDays, schoolSummary } from '../lib/interruptions';
import { offsiteAttrs } from '../lib/links';
import { flowLabel, getMetricsExtra } from '../lib/metricsExtra';
import { readTown, townCookie } from '../lib/townChoice';
import { getAlerts, getForecast, isTown, weatherLabel } from '../lib/weather';

const saved = readTown(Astro.cookies.get(townCookie)?.value);
const town = isTown(saved) ? saved : 'Bastrop';
const checkedLabel = new Intl.DateTimeFormat('en-US', {
  timeZone: 'UTC',
  month: 'long',
  day: 'numeric',
}).format(new Date(`${burnBan.checked}T12:00:00Z`));
const burnAge = (() => {
  const [fromYear, fromMonth, fromDay] = burnBan.checked.split('-').map(Number);
  const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Chicago', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
  const [toYear, toMonth, toDay] = today.split('-').map(Number);
  return Math.round((Date.UTC(toYear, toMonth - 1, toDay) - Date.UTC(fromYear, fromMonth - 1, fromDay)) / 86400000);
})();

const [county, forecast, alerts, schools, extra] = await Promise.all([
  getCountyNow(),
  getForecast(town),
  getAlerts(),
  getSchoolDays(),
  getMetricsExtra(),
]);

const schoolLine = schoolSummary(schools);
const highway = (route: string) => county.roads.find((road) => road.route === route);
const sh71 = highway('SH 71');
const us290 = highway('US 290');
const flow = county.river ? flowLabel(county.river.detail) : null;

function quiet(label: string) {
  return label === 'Normal day' || label === 'None reported' || label === 'None listed' || label === 'No burn ban' || label === 'None';
}

const board: { href: string; kicker: string; value: string; detail: string; alert: boolean; stale?: boolean }[] = [
  {
    href: `/weather?town=${encodeURIComponent(town)}`,
    kicker: 'Right now',
    value: forecast ? `${forecast.temp}°` : '—',
    detail: forecast ? `${weatherLabel(forecast.code)} in ${town}. Feels like ${forecast.feels}°.` : 'The forecast did not load.',
    alert: false,
  },
  {
    href: '/burn-ban',
    kicker: 'Burn ban',
    value: burnStatus,
    detail: `Checked ${checkedLabel}.${burnAge >= 3 ? ` ${burnAge} days ago.` : ''}`,
    alert: burnBan.inEffect,
    stale: !burnBan.inEffect && burnAge >= 3,
  },
  {
    href: county.river?.href ?? 'https://waterdata.usgs.gov/monitoring-location/08159200/',
    kicker: 'Colorado River',
    value: county.river?.label ?? '—',
    detail: county.river?.detail || 'The Bastrop gauge did not load.',
    alert: false,
  },
  {
    href: county.air?.href ?? 'https://www.tceq.texas.gov/cgi-bin/compliance/monops/daily_summary.pl?cams=1612',
    kicker: 'Air',
    value: county.air?.label ?? '—',
    detail: county.air?.detail || 'The air reading did not load.',
    alert: Boolean(county.air && Number(county.air.label) > 100),
  },
  {
    href: '/roads',
    kicker: 'SH 71',
    value: sh71?.label ?? '—',
    detail: sh71?.label === 'None listed' ? 'No alert filed.' : sh71?.detail || 'DriveTexas did not load.',
    alert: Boolean(sh71 && !quiet(sh71.label)),
  },
  {
    href: '/roads',
    kicker: 'US 290',
    value: us290?.label ?? '—',
    detail: us290?.label === 'None listed' ? 'No alert filed.' : us290?.detail || 'DriveTexas did not load.',
    alert: Boolean(us290 && !quiet(us290.label)),
  },
  {
    href: '/schools',
    kicker: 'Schools',
    value: schoolLine.label,
    detail: schoolLine.detail,
    alert: !quiet(schoolLine.label),
  },
  {
    href: county.power?.href ?? 'https://www.bluebonnet.coop/outages',
    kicker: 'Power',
    value: county.power?.label ?? '—',
    detail: county.power?.detail || 'Bluebonnet did not load.',
    alert: Boolean(county.power && !quiet(county.power.label)),
  },
  {
    href: county.beef?.href ?? 'https://www.ams.usda.gov/mnreports/ams_1955.pdf',
    kicker: 'Beef',
    value: county.beef?.label ?? '—',
    detail: county.beef?.note || 'The Texas auction summary did not load.',
    alert: false,
  },
  {
    href: '/weather',
    kicker: 'Rain',
    value: county.rain?.label ?? '—',
    detail: county.rain ? `${county.rain.detail}, Bastrop.` : 'The seven-day total did not load.',
    alert: false,
  },
];

const gasTowns = [
  ['Bastrop', 'bastrop'],
  ['Elgin', 'elgin'],
  ['Smithville', 'smithville'],
  ['Cedar Creek', 'cedar-creek'],
  ['McDade', 'mcdade'],
  ['Paige', 'paige'],
].map(([name, slug]) => ({
  name,
  href: `https://www.gasbuddy.com/gasprices/texas/${slug}`,
}));

const trash = serviceGroups.find((group) => group.id === 'trash');
const cities = serviceGroups.find((group) => group.id === 'cities');
const aqua = serviceGroups.find((group) => group.id === 'roads')?.items.find((item) => item.name === 'Aqua Water Supply');

const boilOnAqua = /boil/i.test(extra.aquaOutage?.detail ?? '');
---

<BaseLayout
  title="County metrics"
  description="Bastrop County readings: weather, river, lake level, sunrise, gas, water notices, trash day, schools, state parks, and cedar season."
>
  <PageHead
    kicker="Bastrop County"
    title="County metrics"
    lede={`The numbers from the top of the site, then sun, lake, fuel, water, trash, schools, parks, and cedar. Weather follows ${town}. A dash means that source did not load.`}
  />

  <div class="wrap metrics">
    {alerts && alerts.length > 0 && (
      <div class="metric-alerts">
        {alerts.map((alert) => (
          <article>
            <p class="kicker">{alert.severity}</p>
            <h2>{alert.event}</h2>
            <p>{alert.headline}</p>
          </article>
        ))}
      </div>
    )}

    <section class="metric-section">
      <div class="section-head">
        <div>
          <p class="kicker">Already on every page</p>
          <h2>Right now</h2>
        </div>
        <a href="/now">The same board, larger</a>
      </div>
      <div class="metric-board">
        {board.map((card) => (
          <a class:list={['metric-tile', { 'is-alert': card.alert, 'is-stale': card.stale }]} href={card.href} {...offsiteAttrs(card.href)}>
            <p class="kicker">{card.kicker}</p>
            <strong class:list={{ 'is-phrase': card.value.trim().split(/\s+/).length > 2 }}>{card.value}</strong>
            <span>{card.detail}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="metric-section">
      <div class="section-head">
        <div>
          <p class="kicker">Sun and water</p>
          <h2>Daylight, the lake, the gauge</h2>
        </div>
      </div>
      <div class="metric-board metric-board-wide">
        <a class="metric-tile" href={extra.sunrise?.href ?? 'https://open-meteo.com/'} {...offsiteAttrs(extra.sunrise?.href ?? 'https://open-meteo.com/')}>
          <p class="kicker">Sunrise</p>
          <strong>{extra.sunrise?.label ?? '—'}</strong>
          <span>{extra.sunrise?.detail ?? 'Open-Meteo did not load.'}</span>
        </a>
        <a class="metric-tile" href={extra.sunset?.href ?? 'https://open-meteo.com/'} {...offsiteAttrs(extra.sunset?.href ?? 'https://open-meteo.com/')}>
          <p class="kicker">Sunset</p>
          <strong>{extra.sunset?.label ?? '—'}</strong>
          <span>{extra.sunset?.detail ?? 'Open-Meteo did not load.'}</span>
        </a>
        <a class="metric-tile" href={extra.lake?.href ?? 'https://hydromet.lcra.org/riverreport/'} {...offsiteAttrs(extra.lake?.href ?? 'https://hydromet.lcra.org/riverreport/')}>
          <p class="kicker">Lake Bastrop</p>
          <strong>{extra.lake?.label ?? '—'}</strong>
          <span>{extra.lake?.detail || 'The LCRA lake table did not load.'}</span>
        </a>
        <a class="metric-tile metric-span" href={county.river?.href ?? 'https://waterdata.usgs.gov/monitoring-location/08159200/'} {...offsiteAttrs(county.river?.href ?? 'https://waterdata.usgs.gov/monitoring-location/08159200/')}>
          <p class="kicker">Paddling flow</p>
          <strong>{flow ?? '—'}</strong>
          <span>
            {county.river
              ? `${county.river.label} at the Bastrop gauge. ${county.river.detail}. The flow is the paddling number. This page does not add a separate runnable rating.`
              : 'The Bastrop gauge did not load.'}
          </span>
        </a>
      </div>
    </section>

    <section class="metric-section">
      <div class="section-head">
        <div>
          <p class="kicker">Fuel</p>
          <h2>Gas</h2>
        </div>
      </div>
      <div class="metric-split">
        <a class="metric-tile metric-hero" href={extra.gas?.href ?? 'https://www.eia.gov/petroleum/gasdiesel/'} {...offsiteAttrs(extra.gas?.href ?? 'https://www.eia.gov/petroleum/gasdiesel/')}>
          <p class="kicker">Texas regular</p>
          <strong>{extra.gas?.label ?? '—'}</strong>
          <span>{extra.gas?.detail ?? 'The EIA weekly table did not load.'}</span>
        </a>
        <div>
          <p class="meta">No public feed posts a Bastrop County station price. These links open a lookup. They are not a price.</p>
          <ul class="metric-links">
            {gasTowns.map((place) => (
              <li>
                <a href={place.href} {...offsiteAttrs(place.href)}>
                  <strong>{place.name}</strong>
                  <span>Look up stations</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="metric-section">
      <div class="section-head">
        <div>
          <p class="kicker">Drinking water</p>
          <h2>Notices and outages</h2>
        </div>
      </div>
      <div class="metric-board metric-board-wide">
        <a class:list={['metric-tile', { 'is-alert': extra.aquaOutage?.label === 'Listed' }]} href={extra.aquaOutage?.href ?? 'https://www.aquawsc.com/service-interruptions/'} {...offsiteAttrs('https://www.aquawsc.com/service-interruptions/')}>
          <p class="kicker">Aqua outage</p>
          <strong>{extra.aquaOutage?.label ?? '—'}</strong>
          <span>{extra.aquaOutage?.detail ?? 'The Aqua interruptions page did not load.'}</span>
        </a>
        <a class="metric-tile" href={extra.aquaDrought?.href ?? 'https://www.aquawsc.com/conservation-environment/water-conservation/water-restrictions/'} {...offsiteAttrs(extra.aquaDrought?.href ?? 'https://www.aquawsc.com/')}>
          <p class="kicker">Aqua drought</p>
          <strong>{extra.aquaDrought?.label ?? '—'}</strong>
          <span>{extra.aquaDrought?.detail ?? 'The drought page did not load.'}</span>
        </a>
        <article class:list={['metric-tile', { 'is-alert': boilOnAqua }]}>
          <p class="kicker">Boil notice</p>
          <strong class:list={{ 'is-phrase': Boolean(extra.aquaOutage) && !boilOnAqua }}>{!extra.aquaOutage ? '—' : boilOnAqua ? 'Listed' : 'Not on Aqua’s list'}</strong>
          <span>
            {!extra.aquaOutage
              ? 'The Aqua page did not load, so a boil notice was not checked.'
              : boilOnAqua
                ? extra.aquaOutage.detail
                : 'A boil sentence is shown here only when Aqua’s interruptions page writes one. City water notices stay on the city site.'}
          </span>
          <p class="metric-inline">
            {aqua?.href && <a href={aqua.href} {...offsiteAttrs(aqua.href)}>Aqua Water Supply</a>}
            {cities?.items.map((city) => (
              city.href && <a href={city.href} {...offsiteAttrs(city.href)}>{city.name}</a>
            ))}
          </p>
        </article>
      </div>
    </section>

    <section class="metric-section">
      <div class="section-head">
        <div>
          <p class="kicker">Hauling</p>
          <h2>Trash, recycling, bulk</h2>
        </div>
        <a href="/new-here#trash">New resident guide</a>
      </div>
      <p class="meta">{trash?.intro} The day is on the city map, not a single county calendar.</p>
      <div class="metric-board">
        {trash?.items.map((item) => (
          <article class="metric-tile">
            <p class="kicker">{item.name.replace(' trash and recycling', '')}</p>
            <strong>By route</strong>
            <span>{item.detail}{item.hours ? ` ${item.hours}` : ''}{item.phone ? ` ${item.phone}.` : ''}</span>
            {item.href && <a href={item.href} {...offsiteAttrs(item.href)}>Schedule</a>}
          </article>
        ))}
      </div>
    </section>

    <section class="metric-section">
      <div class="section-head">
        <div>
          <p class="kicker">Four districts</p>
          <h2>Schools</h2>
        </div>
        <a href="/schools">School status</a>
      </div>
      <div class="metric-board">
        {schools.map((day) => (
          <article class:list={['metric-tile', { 'is-alert': day.status === 'closed' || day.status === 'delayed' }]}>
            <p class="kicker">{day.name}</p>
            <strong>{day.label}</strong>
            <span>{day.note}</span>
            {!/early release|early dismissal/i.test(day.note) && <span>No early release is posted on the homepage.</span>}
            {!/\bbus\b/i.test(day.note) && <span>No bus delay is posted on the homepage.</span>}
            <span>Lunch is on the district site, not copied here.</span>
            <a href={day.href} {...offsiteAttrs(day.href)}>Calendar and menu</a>
          </article>
        ))}
      </div>
    </section>

    <section class="metric-section">
      <div class="section-head">
        <div>
          <p class="kicker">Lost Pines</p>
          <h2>State parks</h2>
        </div>
      </div>
      <div class="metric-board metric-board-wide">
        {extra.parks.map((park) => (
          <article class:list={['metric-tile', { 'is-alert': park.label === 'Alert' }]}>
            <p class="kicker">{park.name}</p>
            <strong>{park.label}</strong>
            <span>
              {park.detail}
              {park.label === 'Notice' ? ' No closure is written in this notice.' : ''}
              {' '}Capacity is not a number on the alert page.
            </span>
            <p class="metric-inline">
              <a href={park.alertHref} {...offsiteAttrs(park.alertHref)}>Alerts</a>
              <a href={park.href} {...offsiteAttrs(park.href)}>Park page</a>
            </p>
          </article>
        ))}
        <article class="metric-tile">
          <p class="kicker">Prescribed fire</p>
          <strong>{extra.burnSeason ? 'Season posted' : 'See the park page'}</strong>
          <span>
            {extra.burnSeason
              ? `TPWD plans to ${extra.burnSeason} A burn is listed above only when the alert page names one.`
              : 'The forest page did not load. Check the park alerts for a burn.'}
            {extra.burnSignup ? ` ${extra.burnSignup}` : ''}
          </span>
          <a href="https://tpwd.texas.gov/state-parks/bastrop/protecting-forest" {...offsiteAttrs('https://tpwd.texas.gov/state-parks/bastrop/protecting-forest')}>Forest page</a>
        </article>
      </div>
    </section>

    <section class="metric-section">
      <div class="section-head">
        <div>
          <p class="kicker">Seasonal</p>
          <h2>Cedar</h2>
        </div>
      </div>
      <a class="metric-tile metric-hero" href="https://www.aaaai.org/tools-for-the-public/allergy-and-asthma-resources" {...offsiteAttrs('https://www.aaaai.org/tools-for-the-public/allergy-and-asthma-resources')}>
        <p class="kicker">Cedar count</p>
        <strong>Not posted</strong>
        <span>Cedar fever season starts in December. This page does not invent a grain count. The link is the National Allergy Bureau directory, where a station posts its own number.</span>
      </a>
    </section>

    <p class="disclaimer">
      Weather is the forecast for {town}. The river and the paddling flow are the USGS gauge at Bastrop and can be provisional.
      Lake Bastrop is the LCRA elevation. Sunrise and sunset are Open-Meteo at the Bastrop coordinates.
      Gas is the EIA weekly Texas regular average, not a station in town.
      Aqua lines are copied from Aqua’s own pages. Trash days are the city route, linked from the phone book checked in early November 2026.
      School lines are each district homepage today. Park lines are the dated notices on the TPWD alert page.
    </p>
  </div>
</BaseLayout>

<style>
  .metrics { display: grid; gap: 2.2rem; padding-bottom: 2rem; }
  .metric-section { min-width: 0; }
  .section-head { display: flex; justify-content: space-between; gap: 1rem; align-items: end; margin-bottom: 0.8rem; }
  .section-head h2 { margin: 0.15rem 0 0; }
  .section-head a { color: var(--river-deep); font-weight: 650; }
  .metric-alerts { display: grid; gap: 0.7rem; }
  .metric-alerts h2 { font-size: 1.45rem; margin: 0.15rem 0; }
  .metric-board {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11.5rem, 1fr));
    gap: 0.75rem;
  }
  .metric-board-wide { grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
  .metric-tile {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
    padding: 0.9rem 0.95rem 1rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-top: 4px solid var(--pine);
    color: inherit;
    text-decoration: none;
  }
  .metric-tile.is-alert { border-top-color: var(--stop); }
  .metric-tile.is-stale { border-top-color: var(--sun-deep); }
  .metric-tile .kicker { margin: 0; }
  .metric-tile strong {
    font-family: var(--serif);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 560;
    line-height: 0.95;
    letter-spacing: -0.03em;
  }
  .metric-tile strong.is-phrase {
    font-size: clamp(1.45rem, 2.4vw, 2rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .metric-tile span { color: var(--ink-soft); font-size: 0.95rem; line-height: 1.4; }
  .metric-tile > a, .metric-inline { margin-top: auto; }
  .metric-tile > a, .metric-inline a { color: var(--river-deep); font-weight: 650; }
  .metric-inline { display: flex; flex-wrap: wrap; gap: 0.35rem 0.9rem; }
  .metric-span { grid-column: 1 / -1; }
  .metric-hero strong { font-size: clamp(3rem, 8vw, 5.4rem); }
  .metric-split {
    display: grid;
    grid-template-columns: minmax(16rem, 0.8fr) minmax(0, 1.2fr);
    gap: 1rem;
    align-items: start;
  }
  .metric-links { list-style: none; margin: 0.6rem 0 0; padding: 0; display: grid; gap: 0; }
  .metric-links a {
    display: flex;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.45rem 0;
    border-top: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
  }
  .metric-links strong { font-family: var(--serif); font-size: 1.25rem; font-weight: 560; }
  .metric-links span { color: var(--river-deep); font-size: 0.88rem; font-weight: 650; }
  @media (max-width: 800px) {
    .section-head { flex-direction: column; align-items: start; }
    .metric-split { grid-template-columns: 1fr; }
  }
</style>
