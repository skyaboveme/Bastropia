---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HomeBanner from '../components/HomeBanner.astro';
import InstallPrompt from '../components/InstallPrompt.astro';
import { siteDescription, siteName } from '../data/site';
import { breadcrumb, graph, organization, stringify, webPage, website } from '../lib/schema';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  /** Rotating sponsored banner. Off on the private desk. */
  banner?: boolean;
  pageType?: string;
  canonicalPath?: string;
  extra?: Record<string, unknown>[];
}

const { title, description = siteDescription, image, imageAlt, noindex = false, banner, pageType = 'WebPage', canonicalPath, extra = [] } = Astro.props;
const fullTitle = title === siteName ? `${siteName} — Everything happening in Bastrop County` : `${title} · ${siteName}`;
const requestPath = Astro.url.pathname.length > 1 && Astro.url.pathname.endsWith('/') ? Astro.url.pathname.slice(0, -1) : Astro.url.pathname;
const showBanner = banner ?? !(requestPath === '/desk' || requestPath.startsWith('/desk/'));
const path = canonicalPath ?? requestPath;
const canonical = new URL(path, Astro.site);
const sharePath = image || '/brand/og.png';
const shareAlt = image ? (imageAlt ?? title) : 'Bastropia — everything happening in Bastrop County';
const shareImage = new URL(sharePath, Astro.site);
const themeColor = '#10281f';

const sections: Record<string, string> = {
  events: 'Events',
  news: 'News',
  social: 'Social',
  government: 'Government',
  groups: 'Social',
  calendar: 'Calendar',
  'this-weekend': 'This weekend',
  weather: 'Weather',
  'burn-ban': 'Burn ban',
  videos: 'Videos',
  about: 'About',
  submit: 'Add an event',
  tips: 'Tips',
  newsletter: 'Newsletter',
  advertise: 'Advertise',
  upgrade: 'Upgrade a listing',
  'go-vote': 'Go Vote',
  'election-night': 'Election night',
  results: 'Results',
  scores: 'Scores',
  roads: 'Roads',
  development: 'Development',
  'new-here': 'New here',
};
const parts = requestPath.split('/').filter(Boolean);
const crumbs: { name: string; path: string }[] = [];
if (sections[parts[0]]) crumbs.push({ name: sections[parts[0]], path: `/${parts[0]}` });
if (parts.length > 1) crumbs.push({ name: title, path: requestPath });
const schemaType = pageType === 'NewsArticle' || pageType === 'Article' ? 'WebPage' : pageType;
const nodes = [
  organization(),
  website(),
  webPage({ path, name: title, description, type: schemaType, image: sharePath }),
  ...(crumbs.length ? [breadcrumb(crumbs)] : []),
  ...extra,
];
const jsonLd = stringify(graph(nodes));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="fo-verify" content="59ee4acc-51b2-4e7b-b5e2-7be0bb4faab1" />
    <meta name="geo.region" content="US-TX" />
    <meta name="geo.placename" content="Bastrop County" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Bastropia" />
    <link rel="alternate" type="application/rss+xml" title="Bastrop County" href="/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="Bastropia events" href="/events.xml" />
    <link rel="alternate" type="text/plain" title="LLM site guide" href="/llms.txt" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={pageType === 'NewsArticle' || pageType === 'Article' ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:alt" content={shareAlt} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    {!image && <meta property="og:image:type" content="image/png" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={shareAlt} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,560;9..144,680&family=Outfit:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,560;9..144,680&family=Outfit:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,560;9..144,680&family=Outfit:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap"
      />
    </noscript>
    <script type="application/ld+json" set:html={jsonLd} />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-E7PPDYNQ3H" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-E7PPDYNQ3H');
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
      {showBanner && (
        <div class="wrap site-banner" data-site-banner hidden>
          <HomeBanner />
        </div>
      )}
    </main>
    {showBanner && (
      <script is:inline>
        (function () {
          var main = document.getElementById('main');
          var banner = main && main.querySelector('[data-site-banner]');
          if (!main || !banner) return;

          // News and other long reads can ask for the banner after the story.
          var end = main.querySelector('[data-banner-end]');
          if (end) {
            end.after(banner);
            banner.hidden = false;
            return;
          }

          function blocks(parent) {
            return Array.prototype.filter.call(parent.children, function (el) {
              return el !== banner && el.tagName !== 'SCRIPT' && el.tagName !== 'STYLE';
            });
          }

          var root = main;
          var kids = blocks(main);

          // One shell (homepage stack, article wrap): place midway inside it.
          if (kids.length === 1 && blocks(kids[0]).length >= 2) {
            root = kids[0];
            kids = blocks(root);
          } else if (kids.length >= 2 && kids[0].classList && kids[0].classList.contains('page-head')) {
            // Page head + content wrap: place midway inside the wrap.
            var shell = kids[1];
            if (shell && blocks(shell).length >= 2) {
              root = shell;
              kids = blocks(root);
            }
          }

          if (!kids.length) {
            banner.hidden = false;
            return;
          }

          var mid = Math.floor(kids.length / 2);
          var anchor = kids[Math.max(0, mid - 1)];
          anchor.after(banner);
          banner.hidden = false;
        })();
      </script>
    )}
    <Footer />
    {!noindex && <InstallPrompt />}
    <script is:inline>
      (function () {
        function offsite(href) {
          if (!href) return false;
          var value = String(href).trim();
          if (!value || value.charAt(0) === '#' || value.charAt(0) === '?') return false;
          if (value.charAt(0) === '/' && value.charAt(1) !== '/') return false;
          if (/^(mailto|tel|sms|javascript):/i.test(value)) return false;
          try {
            var url = new URL(value, location.href);
            if (url.protocol !== 'http:' && url.protocol !== 'https:') return false;
            var host = url.hostname.replace(/^www\./i, '').toLowerCase();
            var here = location.hostname.replace(/^www\./i, '').toLowerCase();
            return host !== here;
          } catch (error) {
            return false;
          }
        }

        function mark(anchor) {
          if (!anchor || anchor.target === '_blank') return;
          if (!offsite(anchor.getAttribute('href'))) return;
          anchor.target = '_blank';
          var rel = anchor.getAttribute('rel') || '';
          if (!/\bnoopener\b/i.test(rel)) rel = (rel + ' noopener').trim();
          if (!/\bnoreferrer\b/i.test(rel)) rel = (rel + ' noreferrer').trim();
          anchor.setAttribute('rel', rel);
        }

        function markAll(root) {
          var links = (root || document).querySelectorAll('a[href]');
          for (var i = 0; i < links.length; i += 1) mark(links[i]);
        }

        markAll(document);
        document.addEventListener(
          'click',
          function (event) {
            var node = event.target;
            if (!node || !node.closest) return;
            mark(node.closest('a[href]'));
          },
          true,
        );
      })();
    </script>
  </body>
</html>
