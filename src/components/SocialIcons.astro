---
import { facebookGroup, facebookGroupReason, youtubeChannel } from '../data/site';
import { offsiteAttrs } from '../lib/links';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<nav class:list={['social-icons', className]} aria-label="Social">
  <a
    class="social-icon"
    href={facebookGroup}
    aria-label="Bastropia Facebook Group"
    title={facebookGroupReason}
    {...offsiteAttrs(facebookGroup)}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path
        fill="currentColor"
        d="M22 12.07C22 6.48 17.52 2 11.93 2S1.86 6.48 1.86 12.07c0 5.02 3.66 9.18 8.44 9.93v-7.03H7.9v-2.9h2.4V9.86c0-2.37 1.4-3.69 3.56-3.69 1.04 0 2.12.19 2.12.19v2.33h-1.2c-1.18 0-1.55.73-1.55 1.48v1.78h2.64l-.42 2.9h-2.22V22c4.78-.75 8.44-4.91 8.44-9.93Z"
      />
    </svg>
  </a>
  <a
    class="social-icon"
    href={youtubeChannel}
    aria-label="Bastropia YouTube"
    title="Bastropia on YouTube"
    {...offsiteAttrs(youtubeChannel)}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path
        fill="currentColor"
        d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6a3 3 0 0 0-2.1 2.1A31.5 31.5 0 0 0 0 12a31.5 31.5 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.5 31.5 0 0 0 24 12a31.5 31.5 0 0 0-.5-5.8ZM9.8 15.5v-7L16.2 12l-6.4 3.5Z"
      />
    </svg>
  </a>
</nav>
