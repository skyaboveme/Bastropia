---
const messages: Record<string, string> = {
  email: 'Enter an email we can reply to.',
  terms: 'Confirm the terms before this reservation is saved.',
  placement: 'Choose a placement.',
  count: 'Choose how many months or weekends you want.',
  date: 'Add a start date.',
  details: 'Add the required fields and a short description the desk can review.',
  tier: 'Choose Spotlight, Featured, or Lost Pines.',
  event: 'Choose the listing you want to upgrade.',
  topics: 'Choose a burn ban, the schools, the power, or name a road.',
  phone: 'Use a 10-digit mobile number, or leave that box empty.',
  form: 'That form could not be read. Try it again.',
  save: 'That request could not be sent to the desk. Try it again in a minute.',
  auth: 'That password did not match.',
  login: 'That username or password did not match.',
  username: 'Usernames are at least 3 letters or numbers.',
  password: 'Passwords need at least 8 characters.',
  photo: 'Use a JPEG, PNG, or WebP under 4 MB, or send a link instead.',
};
const error = Astro.url.searchParams.get('error');
---

{error && messages[error] && <p class="form-error" role="alert">{messages[error]}</p>}
