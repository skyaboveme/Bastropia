---
import type { CollectionEntry } from 'astro:content';
import { categoryMeta, type Tier } from '../data/taxonomy';
import { siteUrl } from '../data/site';
import { phoneHref } from '../lib/format';
import { googleCalendarUrl } from '../lib/ics';
import { offsiteAttrs } from '../lib/links';
import { stampParts, whenLabel } from '../lib/time';

interface Props {
  event: CollectionEntry<'events'>;
  tier?: Tier;
  compact?: boolean;
}

const { event, tier = event.data.tier, compact = false } = Astro.props;
const stamp = stampParts(event.data.start);
const category = categoryMeta[event.data.category];
const pageUrl = new URL(`/events/${event.id}`, siteUrl).toString();
const place = [event.data.address, event.data.venue, `${event.data.city}, TX`].filter(Boolean).join(', ');
const mapHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(place)}`;
const calendarHref = googleCalendarUrl(event, pageUrl);
---

<article class:list={['event-card', `tier-${tier}`, { compact }]}>
  <a class:list={[{ 'has-photo': Boolean(event.data.image) }]} href={`/events/${event.id}`}>
    {!compact && (
      <time class="date-stamp" datetime={event.data.start.toISOString()}>
        <span>{stamp.month}</span>
        <strong>{stamp.day}</strong>
      </time>
    )}
    {event.data.image && <img class="event-thumb" src={event.data.image} alt={event.data.title} width="160" height="120" loading="lazy" />}
    <div>
      <p class="kicker">{category.label} · {event.data.city}</p>
      <h3>{event.data.title}</h3>
      <p class="meta">{whenLabel(event.data.schedule, event.data.start, event.data.end)}{compact ? '' : ` · ${event.data.venue}`}</p>
      {tier !== 'community' && <p class="badge">{tier === 'lost-pines' ? 'Lost Pines' : tier}</p>}
    </div>
  </a>
  <p class="event-actions">
    <a href={calendarHref} {...offsiteAttrs(calendarHref)}>Add to calendar</a>
    <a href={mapHref} {...offsiteAttrs(mapHref)}>Map</a>
    {event.data.phone && <a href={phoneHref(event.data.phone)}>Call {event.data.phone}</a>}
  </p>
</article>
