---
/**
 * Accessible, swipeable photo carousel for news stories (history features and similar).
 *
 * In an MDX story:
 *
 *   import PhotoCarousel from '../../components/PhotoCarousel.astro';
 *
 *   <PhotoCarousel
 *     label="Historic photographs of Bastrop County"
 *     slides={[
 *       {
 *         src: '/images/news/example/photo.jpg',
 *         alt: 'What the photograph shows.',
 *         caption: 'Short caption.',
 *         credit: 'Photo by Name via Wikimedia Commons (CC BY 4.0). Image resized.',
 *         width: 1600,
 *         height: 944,
 *       },
 *     ]}
 *   />
 *
 * No extra libraries. Horizontal CSS scroll-snap handles swipes. Arrow buttons,
 * dots, and left/right keys move between slides. Captions and credits sit under
 * each photo. The first image loads eagerly; the rest are lazy-loaded.
 */
export interface Slide {
  src: string;
  alt: string;
  caption: string;
  credit: string;
  width?: number;
  height?: number;
}

interface Props {
  slides: Slide[];
  label?: string;
}

const { slides, label = 'Photograph carousel' } = Astro.props;
const count = slides.length;
const carouselId = `photo-carousel-${Math.random().toString(36).slice(2, 9)}`;
---

{count > 0 && (
  <div
    class="photo-carousel"
    data-photo-carousel
    role="region"
    aria-roledescription="carousel"
    aria-label={label}
    id={carouselId}
  >
    <div class="photo-carousel-toolbar">
      <p class="photo-carousel-status" data-carousel-status aria-live="polite">
        Photo 1 of {count}
      </p>
      {count > 1 && (
        <div class="photo-carousel-controls">
          <button type="button" class="photo-carousel-btn" data-carousel-prev aria-label="Previous photo">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M15.5 4.5 8 12l7.5 7.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
          <button type="button" class="photo-carousel-btn" data-carousel-next aria-label="Next photo">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M8.5 4.5 16 12l-7.5 7.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>
      )}
    </div>

    <div class="photo-carousel-viewport" data-carousel-track tabindex={count > 1 ? 0 : undefined} aria-label={count > 1 ? 'Photo list. Use the arrow keys to move between photos.' : undefined}>
      {slides.map((slide, index) => (
        <figure class="photo-carousel-slide" data-carousel-slide aria-hidden={index === 0 ? 'false' : 'true'}>
          <div class="photo-carousel-frame">
            <img
              src={slide.src}
              alt={slide.alt}
              width={slide.width}
              height={slide.height}
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </div>
          <figcaption>
            {slide.caption && <span class="photo-carousel-caption">{slide.caption}</span>}
            {slide.credit && <span class="photo-carousel-credit">{slide.credit}</span>}
          </figcaption>
        </figure>
      ))}
    </div>

    {count > 1 && (
      <div class="photo-carousel-dots" data-carousel-dots>
        {slides.map((slide, index) => (
          <button
            type="button"
            class:list={['photo-carousel-dot', { 'is-active': index === 0 }]}
            aria-label={`Go to photo ${index + 1}: ${slide.caption || slide.alt}`}
            aria-current={index === 0 ? 'true' : undefined}
            data-carousel-dot={index}
          />
        ))}
      </div>
    )}
  </div>
)}

<script>
  function setupCarousel(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>('[data-carousel-track]');
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-carousel-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]'));
    const status = root.querySelector<HTMLElement>('[data-carousel-status]');
    const prev = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
    if (!track || slides.length === 0) return;

    let index = 0;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const goTo = (nextIndex: number, { focusTrack = false } = {}) => {
      index = (nextIndex + slides.length) % slides.length;
      const slide = slides[index];
      track.scrollTo({
        left: slide.offsetLeft - track.offsetLeft,
        behavior: reduceMotion ? 'auto' : 'smooth',
      });
      update(index);
      if (focusTrack) track.focus();
    };

    const update = (active: number) => {
      index = active;
      slides.forEach((slide, i) => {
        slide.setAttribute('aria-hidden', i === active ? 'false' : 'true');
      });
      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', i === active);
        if (i === active) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
      if (status) status.textContent = `Photo ${active + 1} of ${slides.length}`;
    };

    const currentFromScroll = () => {
      const left = track.scrollLeft;
      let closest = 0;
      let dist = Infinity;
      slides.forEach((slide, i) => {
        const d = Math.abs(slide.offsetLeft - track.offsetLeft - left);
        if (d < dist) {
          dist = d;
          closest = i;
        }
      });
      return closest;
    };

    prev?.addEventListener('click', () => goTo(index - 1));
    next?.addEventListener('click', () => goTo(index + 1));
    dots.forEach((dot) => {
      dot.addEventListener('click', () => goTo(Number(dot.dataset.carouselDot)));
    });

    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        goTo(index - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        goTo(index + 1);
      } else if (event.key === 'Home') {
        event.preventDefault();
        goTo(0);
      } else if (event.key === 'End') {
        event.preventDefault();
        goTo(slides.length - 1);
      }
    });

    let ticking = false;
    track.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          update(currentFromScroll());
          ticking = false;
        });
      },
      { passive: true },
    );
  }

  document.querySelectorAll<HTMLElement>('[data-photo-carousel]').forEach(setupCarousel);
</script>

<style>
  .photo-carousel {
    margin: 1.4rem 0 1.85rem;
    max-width: 42rem;
  }

  .photo-carousel-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    margin: 0 0 0.45rem;
  }

  .photo-carousel-status {
    margin: 0;
    font-family: var(--sans);
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .photo-carousel-controls {
    display: flex;
    gap: 0.35rem;
  }

  .photo-carousel-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--card);
    color: var(--pine-deep);
    cursor: pointer;
  }

  .photo-carousel-btn svg {
    width: 1.15rem;
    height: 1.15rem;
    display: block;
  }

  .photo-carousel-btn:hover {
    border-color: var(--pine);
    color: var(--pine);
  }

  .photo-carousel-btn:focus-visible,
  .photo-carousel-dot:focus-visible,
  .photo-carousel-viewport:focus-visible {
    outline: 3px solid var(--sun);
    outline-offset: 2px;
  }

  .photo-carousel-viewport {
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    gap: 0;
    border: 1px solid var(--line);
    border-radius: 0.7rem;
    background: var(--pine-deep);
    scrollbar-width: none;
  }

  .photo-carousel-viewport::-webkit-scrollbar {
    display: none;
  }

  .photo-carousel-slide {
    flex: 0 0 100%;
    width: 100%;
    margin: 0;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    background: var(--card);
  }

  .photo-carousel-frame {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    background: var(--pine-deep);
    overflow: hidden;
  }

  .photo-carousel-frame img {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    object-fit: contain;
    background: var(--pine-deep);
  }

  .photo-carousel-slide figcaption {
    margin: 0;
    padding: 0.7rem 0.9rem 0.85rem;
    background: var(--paper);
    border-top: 1px solid var(--line);
  }

  .photo-carousel-caption,
  .photo-carousel-credit {
    display: block;
    font-family: var(--sans);
    line-height: 1.4;
  }

  .photo-carousel-caption {
    font-size: 0.95rem;
    color: var(--ink);
  }

  .photo-carousel-credit {
    margin-top: 0.28rem;
    font-size: 0.8rem;
    color: var(--ink-soft);
  }

  .photo-carousel-dots {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
    margin: 0.7rem 0 0;
  }

  .photo-carousel-dot {
    width: 0.62rem;
    height: 0.62rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: var(--line);
    cursor: pointer;
  }

  .photo-carousel-dot.is-active {
    background: var(--pine);
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-carousel-viewport {
      scroll-behavior: auto;
    }
  }
</style>
