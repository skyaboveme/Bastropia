---
/**
 * PhotoCarousel — one swipeable photo strip for a news story.
 *
 * Props (keep this shape; the Friday history story passes it):
 * - label?: string — accessible name of the carousel. Default: "Photograph carousel".
 * - slides: Slide[] — required. Each slide:
 *   - src: string — site path, such as /images/news/story/photo.jpg
 *   - alt: string — what the photograph shows. Not a substitute for the caption.
 *   - caption: string — one line under the photo. Empty string hides it.
 *   - credit: string — source and license under the caption. Empty string hides it.
 *   - width?: number — intrinsic pixel width of the file
 *   - height?: number — intrinsic pixel height of the file
 *
 * Arrow keys, Home, and End move between slides when focus is inside the carousel.
 * Touch and trackpad swipes use native horizontal scrolling with scroll-snap.
 * Previous, next, and the dots call the same movement. The first image loads
 * immediately; the rest wait until they are near the screen.
 */
export interface Slide {
  src: string;
  alt: string;
  caption: string;
  credit: string;
  width?: number;
  height?: number;
}

interface Props {
  slides: Slide[];
  label?: string;
}

const { slides = [], label = 'Photograph carousel' } = Astro.props;
const count = slides.length;
const carouselId = `photo-carousel-${Math.random().toString(36).slice(2, 9)}`;
---

{count > 0 && (
  <div
    class="photo-carousel"
    data-photo-carousel
    role="region"
    aria-roledescription="carousel"
    aria-label={label}
    id={carouselId}
  >
    <div class="photo-carousel-toolbar">
      <p class="photo-carousel-status" data-carousel-status aria-live="polite" aria-atomic="true">
        Photo 1 of {count}
      </p>
      {count > 1 && (
        <div class="photo-carousel-controls">
          <button type="button" class="photo-carousel-btn" data-carousel-prev aria-label="Previous photo">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M15.5 4.5 8 12l7.5 7.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
          <button type="button" class="photo-carousel-btn" data-carousel-next aria-label="Next photo">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M8.5 4.5 16 12l-7.5 7.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>
      )}
    </div>

    <div
      class="photo-carousel-viewport"
      data-carousel-track
      tabindex={count > 1 ? 0 : undefined}
      aria-label={count > 1 ? 'Photo list. Use the arrow keys to move between photos.' : undefined}
    >
      {slides.map((slide, index) => (
        <figure
          class="photo-carousel-slide"
          data-carousel-slide
          id={`${carouselId}-slide-${index}`}
          role="group"
          aria-roledescription="slide"
          aria-label={`Photo ${index + 1} of ${count}`}
        >
          <div class="photo-carousel-frame">
            <img
              src={slide.src}
              alt={slide.alt}
              width={slide.width}
              height={slide.height}
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding="async"
              fetchpriority={index === 0 ? undefined : 'low'}
            />
          </div>
          {(slide.caption || slide.credit) && (
            <figcaption>
              {slide.caption && <span class="photo-carousel-caption">{slide.caption}</span>}
              {slide.credit && (
                <span class="photo-carousel-credit">
                  <span class="photo-carousel-sr">Credit: </span>
                  {slide.credit}
                </span>
              )}
            </figcaption>
          )}
        </figure>
      ))}
    </div>

    {count > 1 && (
      <div class="photo-carousel-dots" data-carousel-dots>
        {slides.map((slide, index) => (
          <button
            type="button"
            class:list={['photo-carousel-dot', { 'is-active': index === 0 }]}
            aria-label={`Go to photo ${index + 1}: ${slide.caption || slide.alt}`}
            aria-current={index === 0 ? 'true' : undefined}
            data-carousel-dot={index}
          />
        ))}
      </div>
    )}
  </div>
)}

<script>
  function setupCarousel(root: HTMLElement) {
    if (root.dataset.carouselReady === 'true') return;
    root.dataset.carouselReady = 'true';

    const track = root.querySelector<HTMLElement>('[data-carousel-track]');
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-carousel-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]'));
    const status = root.querySelector<HTMLElement>('[data-carousel-status]');
    const prev = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
    if (!track || slides.length === 0) return;

    let index = 0;
    let animating = false;
    let moveId = 0;
    let settleTimer = 0;
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

    const update = (active: number) => {
      index = active;
      slides.forEach((slide, i) => {
        if (i === active) slide.removeAttribute('aria-hidden');
        else slide.setAttribute('aria-hidden', 'true');
      });
      dots.forEach((dot, i) => {
        const on = i === active;
        dot.classList.toggle('is-active', on);
        if (on) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
      if (status) status.textContent = `Photo ${active + 1} of ${slides.length}`;
    };

    const currentFromScroll = () => {
      const left = track.scrollLeft;
      let closest = 0;
      let dist = Infinity;
      slides.forEach((slide, i) => {
        const d = Math.abs(slide.offsetLeft - left);
        if (d < dist) {
          dist = d;
          closest = i;
        }
      });
      return closest;
    };

    const syncFromScroll = () => {
      const nextIndex = currentFromScroll();
      if (nextIndex !== index) update(nextIndex);
    };

    // behavior: 'auto' follows the CSS scroll-behavior, which is smooth.
    // An inline auto value is the reliable way to jump.
    const scrollTrackTo = (left: number, smooth: boolean) => {
      if (!smooth) {
        const previous = track.style.scrollBehavior;
        track.style.scrollBehavior = 'auto';
        track.scrollTo({ left, behavior: 'auto' });
        track.style.scrollBehavior = previous;
        return;
      }
      track.scrollTo({ left, behavior: 'smooth' });
    };

    const goTo = (nextIndex: number) => {
      if (slides.length < 2) return;
      const wrapped = (nextIndex + slides.length) % slides.length;
      const move = ++moveId;
      const adjacent = Math.abs(wrapped - index) === 1;
      const smooth = adjacent && !motionQuery.matches;
      animating = true;
      update(wrapped);
      scrollTrackTo(slides[wrapped].offsetLeft, smooth);
      window.clearTimeout(settleTimer);
      settleTimer = window.setTimeout(() => {
        if (move !== moveId) return;
        if (Math.abs(track.scrollLeft - slides[wrapped].offsetLeft) > 2) {
          scrollTrackTo(slides[wrapped].offsetLeft, false);
        }
        animating = false;
        syncFromScroll();
      }, smooth ? 1000 : 50);
    };

    prev?.addEventListener('click', () => goTo(index - 1));
    next?.addEventListener('click', () => goTo(index + 1));
    dots.forEach((dot) => {
      dot.addEventListener('click', () => goTo(Number(dot.dataset.carouselDot)));
    });

    root.addEventListener('keydown', (event) => {
      if (slides.length < 2) return;
      if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        goTo(index - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        goTo(index + 1);
      } else if (event.key === 'Home') {
        event.preventDefault();
        goTo(0);
      } else if (event.key === 'End') {
        event.preventDefault();
        goTo(slides.length - 1);
      }
    });

    track.addEventListener('pointerdown', () => {
      moveId += 1;
      animating = false;
      window.clearTimeout(settleTimer);
    });

    let ticking = false;
    track.addEventListener(
      'scroll',
      () => {
        if (animating || ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          if (animating) return;
          const nextIndex = currentFromScroll();
          if (nextIndex !== index) update(nextIndex);
        });
      },
      { passive: true },
    );

    track.addEventListener('scrollend', () => {
      if (animating && Math.abs(track.scrollLeft - slides[index].offsetLeft) > 2) return;
      animating = false;
      window.clearTimeout(settleTimer);
      syncFromScroll();
    });

    let lastWidth = track.clientWidth;
    const observer = new ResizeObserver(() => {
      const width = track.clientWidth;
      if (width === lastWidth) return;
      lastWidth = width;
      const previous = track.style.scrollBehavior;
      track.style.scrollBehavior = 'auto';
      track.scrollTo({ left: slides[index].offsetLeft, behavior: 'auto' });
      track.style.scrollBehavior = previous;
    });
    observer.observe(track);

    update(0);
  }

  document.querySelectorAll<HTMLElement>('[data-photo-carousel]').forEach(setupCarousel);
</script>

<style>
  .photo-carousel {
    width: 100%;
    margin: 1.4rem 0 1.85rem;
    max-width: 42rem;
  }

  .photo-carousel-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    margin: 0 0 0.45rem;
  }

  .photo-carousel-status {
    margin: 0;
    font-family: var(--sans);
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .photo-carousel-controls {
    display: flex;
    gap: 0.35rem;
  }

  .photo-carousel-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--card);
    color: var(--pine-deep);
    cursor: pointer;
  }

  .photo-carousel-btn svg {
    width: 1.15rem;
    height: 1.15rem;
    display: block;
  }

  .photo-carousel-btn:hover {
    border-color: var(--pine);
    color: var(--pine);
  }

  .photo-carousel-btn:focus-visible,
  .photo-carousel-dot:focus-visible,
  .photo-carousel-viewport:focus-visible {
    outline: 3px solid var(--sun);
    outline-offset: 2px;
  }

  .photo-carousel-viewport {
    position: relative;
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    gap: 0;
    border: 1px solid var(--line);
    border-radius: 0.7rem;
    background: var(--pine-deep);
    scrollbar-width: none;
  }

  .photo-carousel-viewport::-webkit-scrollbar {
    display: none;
  }

  .photo-carousel-slide {
    flex: 0 0 100%;
    width: 100%;
    min-width: 100%;
    margin: 0;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    background: var(--card);
  }

  .photo-carousel-frame {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    background: var(--pine-deep);
    overflow: hidden;
  }

  .photo-carousel-frame img {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    object-fit: contain;
    object-position: center;
    background: var(--pine-deep);
  }

  .photo-carousel-slide figcaption {
    margin: 0;
    padding: 0.7rem 0.9rem 0.85rem;
    background: var(--paper);
    border-top: 1px solid var(--line);
  }

  .photo-carousel-caption,
  .photo-carousel-credit {
    display: block;
    font-family: var(--sans);
    line-height: 1.4;
  }

  .photo-carousel-caption {
    font-size: 0.95rem;
    color: var(--ink);
  }

  .photo-carousel-credit {
    margin-top: 0.28rem;
    font-size: 0.8rem;
    color: var(--ink-soft);
  }

  .photo-carousel-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .photo-carousel-dots {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.2rem;
    margin: 0.55rem 0 0;
  }

  .photo-carousel-dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
  }

  .photo-carousel-dot::before {
    content: "";
    width: 0.62rem;
    height: 0.62rem;
    border-radius: 999px;
    background: #8a8478;
  }

  .photo-carousel-dot.is-active::before {
    background: var(--pine);
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-carousel-viewport {
      scroll-behavior: auto;
    }
  }

  @media (forced-colors: active) {
    .photo-carousel-btn,
    .photo-carousel-dot {
      border: 1px solid ButtonText;
    }

    .photo-carousel-dot::before,
    .photo-carousel-dot.is-active::before {
      background: ButtonText;
    }
  }
</style>
