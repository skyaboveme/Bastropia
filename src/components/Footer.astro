---
import { facebookGroup, facebookGroupReason, youtubeChannel } from '../data/site';
---

<footer class="site-footer">
  <div class="footer-grid">
    <div class="footer-brand">
      <a href="/">
        <picture>
          <source srcset="/brand/logo-footer.webp" type="image/webp" />
          <img
            src="/brand/logo-footer.png"
            alt="Bastropia"
            width="281"
            height="300"
            loading="lazy"
            decoding="async"
          />
        </picture>
      </a>
      <p class="legal">Everything in Bastrop County.</p>
    </div>
    <div>
      <h3>Sections</h3>
      <p><a href="/scores">Scores</a></p>
      <p><a href="/news">News</a></p>
      <p><a href="/development">Development</a></p>
      <p><a href="/events">Events</a></p>
      <p><a href="/this-weekend">This weekend</a></p>
      <p><a href="/videos">Videos</a></p>
      <p><a href="/weather">Weather</a></p>
      <p><a href="/burn-ban">Burn ban</a></p>
      <p><a href="/government">Government</a></p>
      <p><a href="/new-here">New here</a></p>
      <p><a href="/phone-numbers">Phone numbers</a></p>
      <p><a href="/government/court-decisions">Court decisions</a></p>
      <p><a href="/groups">Social</a></p>
    </div>
    <div>
      <h3>Take part</h3>
      <p><a href="/submit">Add an event</a></p>
      <p><a href="/newsletter">Newsletter</a></p>
      <p><a href="/tips">Send a tip or photo</a></p>
      <p><a href="/upgrade">Upgrade a listing</a></p>
      <p><a href="/advertise">Advertise</a></p>
      <p><a href="/businesses">Business directory</a></p>
      <p><a href="/businesses/submit">List your business</a></p>
      <p><a href={facebookGroup}>Facebook Group</a></p>
      <p class="meta">{facebookGroupReason}</p>
      <p><a href={youtubeChannel}>YouTube</a></p>
      <p><a href="/about">About Bastropia</a></p>
      <p><a href="/rss.xml">RSS</a></p>
      <p><a href="/llms.txt">llms.txt</a></p>
    </div>
    <p class="fine">Bastropia is a community site. It is not Bastrop County, a city, or an emergency service. Confirm bans, closures, and meeting times on the official pages linked here.</p>
  </div>
</footer>
