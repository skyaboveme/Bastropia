---
import {
  newsletterFormAction,
  newsletterOffer,
  newsletterSampleHref,
  newsletterSampleLabel,
} from '../data/site';

interface Props {
  id?: string;
  heading?: string;
  dek?: string;
  compact?: boolean;
  /** Kit tag IDs applied on subscribe (hidden tags[] fields). */
  tagIds?: number[];
  buttonLabel?: string;
}

const {
  id = 'newsletter',
  heading = 'Get the weekend by email',
  dek = newsletterOffer,
  compact = false,
  tagIds = [],
  buttonLabel = 'Sign up',
} = Astro.props;
---

<section class:list={['band newsletter', { compact }]} id={id}>
  <div>
    <p class="kicker">Weekly</p>
    <h2>{heading}</h2>
    <p class="dek">{dek}</p>
    <p class="meta"><a class="text-link" href={newsletterSampleHref}>{newsletterSampleLabel}</a></p>
  </div>
  <form class="form" data-newsletter-form action={newsletterFormAction} method="post">
    {tagIds.map((tagId) => (
      <input type="checkbox" name="tags[]" value={String(tagId)} checked hidden />
    ))}
    <label class="field">
      <span>Email</span>
      <input name="email_address" type="email" required autocomplete="email" />
    </label>
    <button class="button" type="submit">{buttonLabel}</button>
  </form>
</section>
