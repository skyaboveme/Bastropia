---
/**
 * Infographic layout for the Eats Beat news column: a weekday scan table
 * and one DealCard per restaurant, grouped by town.
 */
import DealCard from './DealCard.astro';

type Town = 'Bastrop' | 'Elgin' | 'Smithville' | 'Paige';
type Item = { day?: string; text: string };
type Block = { when?: string; items?: Item[] | string[]; note?: string };
type Mark = 'hh' | 'sp' | 'both' | 'confirm' | '';

