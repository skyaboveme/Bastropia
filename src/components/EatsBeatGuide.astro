  name: string;
  town: Town;
  address: string;
  website?: string;
  sourceLabel?: string;
  phone?: string;
  hours?: string;
  happyHour?: Block | null;
  specials?: Block | null;
  wide?: boolean;
  /** Sunday through Saturday marks for the week-at-a-glance table. */
  week?: [Mark, Mark, Mark, Mark, Mark, Mark, Mark];
};

