const towns: Town[] = ['Bastrop', 'Elgin', 'Smithville'];
const days = [
  { key: 'sun', label: 'Sun' },
  { key: 'mon', label: 'Mon' },
  { key: 'tue', label: 'Tue' },
  { key: 'wed', label: 'Wed' },
  { key: 'thu', label: 'Thu' },
  { key: 'fri', label: 'Fri' },
  { key: 'sat', label: 'Sat' },
] as const;

const scanRows = venues.filter((venue) => venue.week?.some(Boolean));

const mondayHappyHour = [
  { name: 'Casa Chapala', detail: '11 a.m.–7 p.m.' },
  { name: 'Chapala Fiestas & Grill', detail: '11 a.m.–10 p.m.' },
  { name: 'Old Town Restaurant & Bar', detail: '3–7 p.m.' },
  { name: 'Piney Creek Chop House', detail: '5–7 p.m.' },
  { name: "Chili's Grill & Bar", detail: '3–6 p.m.' },
];

const mondaySpecials = [
  { name: 'Casa Chapala', detail: 'Kids eat free all day; lunch buffet 11 a.m.–2 p.m.' },
  { name: 'Old Town Restaurant & Bar', detail: 'Catfish basket' },
  { name: 'Bastrop Beer Company', detail: 'Free popcorn all day' },
  { name: "Maxine's Cafe & Bakery", detail: 'Remix Monday, 11 a.m.–3 p.m.' },
  { name: 'True Texas BBQ', detail: 'Family meal and limited-time menu items' },
  { name: "Pocket's Grille", detail: 'Large single-topping pizza $10, 4–8 p.m.' },
];

const markLabel: Record<Exclude<Mark, ''>, string> = {
  hh: 'Happy hour',
  sp: 'Specials',
  both: 'Happy hour and specials',
  confirm: 'Listed, confirm first',
};

function markText(mark: Mark): string {
  if (mark === 'hh') return 'HH';
  if (mark === 'sp') return 'SP';
  if (mark === 'both') return 'HH+SP';
  if (mark === 'confirm') return '?';
  return '—';
}

const counts = {
  total: venues.length,
  Bastrop: venues.filter((venue) => venue.town === 'Bastrop').length,
  Elgin: venues.filter((venue) => venue.town === 'Elgin').length,
  Smithville: venues.filter((venue) => venue.town === 'Smithville').length,
};
---

<div class="eats-beat">
  <div class="eats-counts" role="list">
    <div class="eats-count" role="listitem">
      <p class="eats-count-value">{counts.total}</p>
      <p class="eats-count-label">Official listings</p>
    </div>
    <div class="eats-count" role="listitem">
      <p class="eats-count-value">{counts.Bastrop}</p>
      <p class="eats-count-label">Bastrop</p>
    </div>
    <div class="eats-count" role="listitem">
      <p class="eats-count-value">{counts.Elgin}</p>
      <p class="eats-count-label">Elgin</p>
    </div>
    <div class="eats-count" role="listitem">
      <p class="eats-count-value">{counts.Smithville}</p>
      <p class="eats-count-label">Smithville</p>
    </div>
  </div>

  <section class="eats-monday" aria-labelledby="eats-monday-heading">
    <h2 id="eats-monday-heading">Monday, Nov. 16, at a glance</h2>
    <div class="eats-monday-grid">
      <div class="eats-monday-col">
        <h3>Happy hour today</h3>
        <ul>
          {mondayHappyHour.map((row) => (
            <li><strong>{row.name}</strong> <span>{row.detail}</span></li>
          ))}
        </ul>
      </div>
      <div class="eats-monday-col eats-monday-sp">
        <h3>Specials today</h3>
        <ul>
          {mondaySpecials.map((row) => (
            <li><strong>{row.name}</strong> <span>{row.detail}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="eats-scan" aria-labelledby="eats-scan-heading">
    <h2 id="eats-scan-heading">This week by day</h2>
    <p class="eats-scan-legend">
      <span class="eats-mark is-hh">HH</span> happy hour
      <span class="eats-mark is-sp">SP</span> specials
      <span class="eats-mark is-both">HH+SP</span> both
      <span class="eats-mark is-confirm">?</span> listed, confirm first
    </p>
    <div class="eats-scan-wrap" tabindex="0">
      <table class="eats-scan-table">
        <thead>
          <tr>
            <th scope="col">Restaurant</th>
            {days.map((day) => <th scope="col">{day.label}</th>)}
          </tr>
        </thead>
        <tbody>
          {scanRows.map((venue) => (
            <tr>
              <th scope="row">
                {venue.name}
                <span class={`eats-mini-town is-${venue.town.toLowerCase()}`}>{venue.town}</span>
              </th>
              {(venue.week ?? ['', '', '', '', '', '', '']).map((mark) => (
                <td>
                  <span class={`eats-mark is-${mark || 'none'}`} title={mark ? markLabel[mark] : 'No posted deal'}>
                    {markText(mark)}
                  </span>
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  {towns.map((town) => (
    <section class={`eats-town eats-town-${town.toLowerCase()}`} aria-labelledby={`eats-town-${town.toLowerCase()}`}>
      <h2 id={`eats-town-${town.toLowerCase()}`}>{town}</h2>
      <div class="eats-card-grid">
        {venues
          .filter((venue) => venue.town === town)
          .map((venue) => (
            <DealCard
              name={venue.name}
              town={venue.town}
              address={venue.address}
              website={venue.website}
              sourceLabel={venue.sourceLabel}
              phone={venue.phone}
              hours={venue.hours}
              happyHour={venue.happyHour}
              specials={venue.specials}
              wide={venue.wide}
            />
          ))}
      </div>
    </section>
  ))}
</div>

<style>
  :global(.prose:has(.eats-beat)) {
    max-width: 72rem;
  }
  :global(.prose .eats-beat h2) {
    margin: 0;
  }
  :global(.prose .eats-beat p),
  :global(.prose .eats-beat ul),
  :global(.prose .eats-beat li) {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .eats-beat {
    display: grid;
    gap: 1.4rem;
    margin: 1.1rem 0 1.6rem;
    font-family: var(--sans);
    min-width: 0;
    max-width: 100%;
  }
  .eats-counts,
  .eats-monday,
  .eats-scan,
  .eats-town,
  .eats-card-grid {
    min-width: 0;
    max-width: 100%;
  }

  .eats-counts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.55rem;
  }
  .eats-count {
    background: var(--card);
    border: 1px solid var(--line);
    border-top: 4px solid var(--pine);
    border-radius: 0.35rem;
    padding: 0.55rem 0.7rem 0.65rem;
  }
  .eats-count:nth-child(2) { border-top-color: var(--pine); }
  .eats-count:nth-child(3) { border-top-color: var(--river-deep); }
  .eats-count:nth-child(4) { border-top-color: var(--sun-deep); }
  .eats-count-value {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.6rem, 5vw, 2.2rem);
    font-weight: 620;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--pine-deep);
  }
  .eats-count-label {
    margin: 0.25rem 0 0;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .eats-monday,
  .eats-scan {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 0.45rem;
    padding: 0.85rem 0.95rem 1rem;
  }
  .eats-monday h2,
  .eats-scan h2,
  .eats-town h2 {
    font-family: var(--serif);
    font-size: 1.45rem;
    font-weight: 620;
    line-height: 1.15;
  }
  .eats-monday-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
    margin-top: 0.7rem;
  }
  @media (min-width: 700px) {
    .eats-monday-grid { grid-template-columns: 1fr 1fr; }
  }
  .eats-monday-col {
    padding: 0.55rem 0.65rem 0.7rem;
    background: var(--paper);
    border-radius: 0.35rem;
    border-left: 3px solid var(--river-deep);
  }
  .eats-monday-sp { border-left-color: var(--sun-deep); }
  .eats-monday-col h3 {
    margin: 0 0 0.4rem;
    font-family: var(--sans);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--river-deep);
  }
  .eats-monday-sp h3 { color: var(--sun-deep); }
  .eats-monday-col ul { display: grid; gap: 0.35rem; }
  .eats-monday-col li {
    display: grid;
    gap: 0.05rem;
    font-size: 0.92rem;
    line-height: 1.35;
  }
  .eats-monday-col li span { color: var(--ink-soft); font-size: 0.86rem; }

  .eats-scan-legend {
    margin: 0.4rem 0 0.65rem;
