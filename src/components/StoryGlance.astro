---
import { storyCards, type StoryCard, type StoryStatInput } from '../lib/storyStats';

interface Props {
  stats?: StoryStatInput[];
  keyFacts?: string[];
}

const cards: StoryCard[] = storyCards(Astro.props.stats, Astro.props.keyFacts);
---

{cards.length > 0 && (
  <section class="story-glance" aria-labelledby="story-glance-title">
    <h2 id="story-glance-title">Story at a glance</h2>
    <ul class="stat-grid">
      {cards.map((card) => card.kind === 'figure' ? (
        <li class="stat-card">
          <p class:list={['stat-card-value', card.value.length > 16 && 'is-long']}>{card.value}</p>
          {card.label && <p class="stat-card-label">{card.label}</p>}
          {(card.note || card.source) && (
            <p class="stat-card-note">
              {card.note && <span class="stat-card-context">{card.note}</span>}
              {card.source && <span class="stat-card-source">{card.source}</span>}
            </p>
          )}
        </li>
      ) : (
        <li class="stat-card stat-card-chip">
          <p class="stat-card-lead">
            <span class="stat-chip-mark" aria-hidden="true"></span>
            {card.lead}
          </p>
          {card.detail && <p class="stat-card-detail">{card.detail}</p>}
        </li>
      ))}
    </ul>
  </section>
)}
