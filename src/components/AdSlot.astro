---
import { placements, type PlacementId } from '../data/commerce';
import { textAds } from '../lib/ads';
import { activeSponsor } from '../lib/intake';
import { money } from '../lib/format';
import { eventKey } from '../lib/time';

interface Props {
  placement: PlacementId;
}

const { placement } = Astro.props;
const meta = placements.find((item) => item.id === placement);
const managed = meta && placement !== 'home-banner' && placement !== 'event-banner' ? await textAds(placement) : [];
const sponsor = managed.length ? null : await activeSponsor(placement, eventKey(new Date()));
---

{meta && managed.length > 0 && (
  <div class="ad-stack" data-ad-stack>
    {managed.map((ad) => (
      <aside class="ad-slot" aria-label="Sponsored" data-ad-id={ad.id} data-ad-placement={placement}>
        <div>
          <p>Sponsored</p>
          <a href={ad.go} target="_blank" rel="sponsored noopener noreferrer">
            <strong>{ad.name}</strong>
            <span>{ad.line}</span>
          </a>
        </div>
        <a class="button" href={ad.go} target="_blank" rel="sponsored noopener noreferrer">Visit</a>
      </aside>
    ))}
    <script is:inline>
      const stack = document.currentScript && document.currentScript.parentElement;
      const seen = (window.__bastropiaAds = window.__bastropiaAds || new Set());
      if (stack) {
        stack.querySelectorAll('[data-ad-id]').forEach((node) => {
          const id = node.getAttribute('data-ad-id');
          const place = node.getAttribute('data-ad-placement');
          const key = `${id}|${place}`;
          if (!id || !place || seen.has(key)) return;
          seen.add(key);
          const body = new URLSearchParams({ id, placement: place });
          if (navigator.sendBeacon) navigator.sendBeacon('/api/ad-stat', body);
          else fetch('/api/ad-stat', { method: 'POST', body, keepalive: true });
        });
      }
    </script>
  </div>
)}

{meta && !managed.length && (
  <aside class:list={['ad-slot', { 'ad-open': !sponsor }]} aria-label={sponsor ? 'Sponsored' : 'Advertising'}>
    <div>
      <p>{sponsor ? 'Sponsored' : 'Open placement'}</p>
      {sponsor ? (
        <a href={sponsor.href}>
          <strong>{sponsor.name}</strong>
          <span>{sponsor.line}</span>
        </a>
      ) : (
        <a href={`/advertise?placement=${meta.id}`}>
          <strong>{meta.name}</strong>
          <span>{meta.detail} {money(meta.rate)} a {meta.unit}.</span>
        </a>
      )}
    </div>
    <a class="button" href={sponsor ? sponsor.href : `/advertise?placement=${meta.id}`}>
      {sponsor ? 'Visit' : 'Advertise'}
    </a>
  </aside>
)}
