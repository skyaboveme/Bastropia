---
import { countyFeeds } from '../data/countyFeeds';
import { channelUrl, youtubeChannels } from '../data/youtubeChannels';
import { latestChannelVideos } from '../lib/youtubeLatest';

interface Props {
  heading?: string;
  allFeeds?: boolean;
}

const { heading = 'Local channels', allFeeds = false } = Astro.props;
const videos = await latestChannelVideos();
const featured = videos[0];
const elsewhere = countyFeeds.filter((feed) => !['elgin-isd', 'bastrop-isd-youtube', 'smithville-isd-youtube'].includes(feed.id));
---

<section class="section" aria-labelledby={heading ? 'county-feeds-heading' : undefined}>
  {heading && (
    <div class="section-head">
      <h2 id="county-feeds-heading">{heading}</h2>
      {allFeeds && <a href="/live">All live</a>}
    </div>
  )}
  {featured ? (
    <div class="video-layout" data-county-feeds>
      <div class="video-main">
        <div class="video-stage" data-feed-stage>
          <a class="video-thumb" href={featured.href} data-youtube={featured.videoId} data-title={featured.title}>
            <img src={featured.thumb} alt="" width="480" height="270" />
            <span class="video-play" aria-hidden="true"></span>
            <span class="sr">Play: {featured.title}</span>
          </a>
        </div>
        <h3 data-feed-title><a href={featured.href} rel="noopener">{featured.title}</a></h3>
        <p class="meta" data-feed-note>
          <a href={featured.channelHref} rel="noopener">{featured.channel.name}</a>
          {featured.when ? ` · ${featured.when}` : ''}
        </p>
      </div>
      <ul class="video-list">
        {videos.map((video) => (
          <li>
            <a
              class="video-item"
              href={video.href}
              data-feed-id={video.channel.id}
              data-title={video.title}
              data-channel={video.channel.name}
              data-when={video.when}
              data-channel-href={video.channelHref}
              data-youtube={video.videoId}
              aria-current={video.channel.id === featured.channel.id ? 'true' : undefined}
              rel="noopener"
            >
              <img src={video.thumb} alt="" width="168" height="94" loading="lazy" />
              <span>
                <strong>{video.title}</strong>
                <em>{video.channel.name}{video.when ? ` · ${video.when}` : ''}</em>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  ) : (
    <p class="lede">The channel list did not load. Open a channel directly:</p>
  )}
  <ul class="channel-links">
    {(videos.length ? videos.map((video) => video.channel) : youtubeChannels).map((channel) => (
      <li><a href={channelUrl(channel.handle)} rel="noopener">{channel.name}</a></li>
    ))}
  </ul>
  <p class="disclaimer">The newest public video on each channel. Playback is that channel’s YouTube player. Bastropia does not rebroadcast them.</p>
  <div class="section-head" style="margin-top:1.4rem;">
    <h2>Open on their site</h2>
  </div>
  <ul class="off-yt">
    {elsewhere.map((feed) => (
      <li>
        <a href={feed.href} rel="noopener">{feed.name}</a>
        <span>{feed.kind}</span>
      </li>
    ))}
  </ul>
</section>

<script is:inline>
  document.querySelectorAll('[data-county-feeds]').forEach((root) => {
    const stage = root.querySelector('[data-feed-stage]');
    const title = root.querySelector('[data-feed-title]');
    const note = root.querySelector('[data-feed-note]');
    if (!stage || !title || !note) return;

    const play = (id, name) => {
      const frame = document.createElement('iframe');
      frame.src = 'https://www.youtube-nocookie.com/embed/' + encodeURIComponent(id) + '?autoplay=1&rel=0';
      frame.title = name;
      frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      frame.allowFullscreen = true;
      frame.referrerPolicy = 'strict-origin-when-cross-origin';
      stage.replaceChildren(frame);
    };

    const poster = (id, name, href) => {
      const thumb = document.createElement('a');
      thumb.className = 'video-thumb';
      thumb.href = href;
      thumb.dataset.youtube = id;
      thumb.dataset.title = name;
      const image = document.createElement('img');
      image.src = 'https://i.ytimg.com/vi/' + encodeURIComponent(id) + '/hqdefault.jpg';
      image.alt = '';
      image.width = 480;
      image.height = 270;
      const button = document.createElement('span');
      button.className = 'video-play';
      button.setAttribute('aria-hidden', 'true');
      const label = document.createElement('span');
      label.className = 'sr';
      label.textContent = 'Play: ' + name;
      thumb.append(image, button, label);
      stage.replaceChildren(thumb);
    };

    const select = (item, startPlayback) => {
      root.querySelectorAll('[data-feed-id]').forEach((other) => other.removeAttribute('aria-current'));
      item.setAttribute('aria-current', 'true');
      const name = item.dataset.title || 'Video';
      const link = document.createElement('a');
      link.href = item.href;
      link.rel = 'noopener';
      link.textContent = name;
      title.replaceChildren(link);
      note.replaceChildren();
      const channel = document.createElement('a');
      channel.href = item.dataset.channelHref || item.href;
      channel.rel = 'noopener';
      channel.textContent = item.dataset.channel || '';
      note.append(channel);
      if (item.dataset.when) note.append(' · ' + item.dataset.when);
      if (startPlayback) play(item.dataset.youtube, name);
      else poster(item.dataset.youtube, name, item.href);
    };

    stage.addEventListener('click', (event) => {
      const thumb = event.target.closest('.video-thumb');
      if (!thumb || !thumb.dataset.youtube) return;
      event.preventDefault();
      play(thumb.dataset.youtube, thumb.dataset.title || 'Video');
    });

    root.querySelectorAll('[data-feed-id]').forEach((item) => {
      item.addEventListener('click', (event) => {
        event.preventDefault();
        select(item, true);
        stage.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      });
    });
  });
</script>
