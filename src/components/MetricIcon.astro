---
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<svg class="metric-icon" viewBox="0 0 24 24" aria-hidden="true">
  {name === 'sunrise' && (
    <>
      <path d="M8.2 16.2a3.8 3.8 0 0 1 7.6 0" />
      <path d="M4.2 16.2h15.6" />
      <path d="M12 4.2v2.3" />
      <path d="M6.4 7.2 8 8.8" />
      <path d="M17.6 7.2 16 8.8" />
    </>
  )}
  {name === 'sunset' && (
    <>
      <path d="M8.2 16.6a3.8 3.8 0 0 1 7.6 0" />
      <path d="M4.2 16.6h15.6" />
      <path d="M7 19.8h10" />
    </>
  )}
  {name === 'lake' && (
    <>
      <path d="M3.4 9.2c1.8 1.3 3.4 1.3 5.2 0s3.4-1.3 5.2 0 3.4 1.3 5.2 0" />
      <path d="M4.4 13.6c1.6 1.1 3 1.1 4.6 0s3-1.1 4.6 0 3 1.1 4.6 0" />
      <path d="M6 18.2h12" />
    </>
  )}
  {name === 'flow' && (
    <>
      <path d="M12 3.2v17.6" />
      <path d="M12 5c2.6 1.5 2.6 3 0 4.4" />
      <path d="M12 14.6c-2.6 1.5-2.6 3 0 4.4" />
    </>
  )}
  {name === 'gas' && (
    <>
      <path d="M6.4 3.6h8.2V17H6.4z" />
      <path d="M8.2 6.6h4.6" />
      <path d="M14.6 8.2h2a1.7 1.7 0 0 1 1.7 1.7v3.2" />
      <path d="M18.3 13.1v2.1" />
      <path d="M6.4 17h8.2" />
      <path d="M7.4 20.2h7.2" />
    </>
  )}
  {name === 'outage' && (
    <>
      <path d="M12 3.2C12 3.2 7.2 8.4 7.2 12.2a4.8 4.8 0 0 0 9.6 0C16.8 8.4 12 3.2 12 3.2Z" />
      <path d="M8.4 16.6 15.6 8.6" />
    </>
  )}
  {name === 'drought' && (
    <>
      <circle cx="12" cy="6.2" r="2.1" />
      <path d="M12 2.2v1.2" />
      <path d="M12 9v1.2" />
      <path d="M8.1 6.2H6.8" />
      <path d="M17.2 6.2h-1.3" />
      <path d="M4 16.4c1.7 1.2 3.2 1.2 4.9 0s3.2-1.2 4.9 0" />
      <path d="M4 19.6c1.7 1.2 3.2 1.2 4.9 0s3.2-1.2 4.9 0 3.2 1.2 4.9 0" />
    </>
  )}
  {name === 'boil' && (
    <>
      <path d="M8 11.2h8v4.8a4 4 0 0 1-8 0v-4.8Z" />
      <path d="M6.8 11.2h10.4" />
      <path d="M10 8.4c.4-1 .4-1.6 0-2.5" />
      <path d="M14 8.4c.4-1 .4-1.6 0-2.5" />
    </>
  )}
  {name === 'trash' && (
    <>
      <path d="M5 7.2h14" />
      <path d="M9 7.2 10 5h4l1 2.2" />
      <path d="M7.2 7.2 8.2 19.5h7.6l1-12.3" />
      <path d="M10.2 11v6" />
      <path d="M13.8 11v6" />
    </>
  )}
  {name === 'school' && (
    <>
      <path d="m3.5 9.5 8.5-3 8.5 3-8.5 3-8.5-3Z" />
      <path d="M7 11.2v4.1c0 .7 2.2 2.2 5 2.2s5-1.5 5-2.2v-4.1" />
      <path d="M20.5 9.5v6" />
    </>
  )}
  {name === 'park' && (
    <>
      <path d="M12 3.4 7.2 10h2.4L6.2 16.4h11.6L14.4 10h2.4L12 3.4Z" />
      <path d="M12 16.4v4.2" />
    </>
  )}
  {name === 'fire' && (
    <path d="M12 20.6c3.3 0 5.5-2.3 5.5-5.4 0-3-2.1-4.6-2.5-7.1-.2 2.1-1.6 3-2.5 2.8.2-3-1.4-4.8-3.2-6.4.2 3.2-2.1 4.6-2.5 8.1.2 2.6 1.9 8 5.2 8Z" />
  )}
  {name === 'cedar' && (
    <>
      <path d="M12 20.4V4.2" />
      <path d="M12 8.2 7.6 6.4" />
      <path d="M12 8.2 16.4 6.4" />
      <path d="M12 12.4 7 11.2" />
      <path d="M12 12.4 17 11.2" />
      <path d="M12 16.4 7.8 15.6" />
      <path d="M12 16.4 16.2 15.6" />
    </>
  )}
</svg>

<style>
  .metric-icon {
    width: 1.55rem;
    height: 1.55rem;
    flex: none;
    display: block;
    color: inherit;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media (max-width: 800px) {
    .metric-icon { width: 1.25rem; height: 1.25rem; }
  }
</style>
