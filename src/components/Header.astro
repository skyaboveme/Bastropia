---
import BurnMark from './BurnMark.astro';
import { burnBan, burnStatus } from '../data/burnBan';
import { facebookGroup } from '../data/site';
import { earlyVotingDays, electionDay, electionHours, voteIsLive, voteLiveUntil } from '../data/vote';
import { eventKey, formatLong, labelFromKey } from '../lib/time';
import { getForecast, isTown, weatherLabel } from '../lib/weather';
import { readTown, townCookie } from '../lib/townChoice';

const path = Astro.url.pathname;
const checkedLabel = new Intl.DateTimeFormat('en-US', {
  timeZone: 'UTC',
  month: 'long',
  day: 'numeric',
}).format(new Date(`${burnBan.checked}T12:00:00Z`));
const savedTown = readTown(Astro.cookies.get(townCookie)?.value);
const weatherTown = isTown(savedTown) ? savedTown : 'Bastrop';
const forecast = await getForecast(weatherTown);
const now = new Date();
const today = formatLong(now);
const dayKey = eventKey(now);
const earlyToday = earlyVotingDays.find((day) => day.date === dayKey);
const lastEarly = earlyVotingDays[earlyVotingDays.length - 1]?.date;
const voteLive = voteIsLive(now);
const voteBanner =
  dayKey === electionDay
    ? `Today is Election Day. Polls are open ${electionHours}. See polling places.`
    : earlyToday && dayKey === lastEarly
      ? `Last day of early voting. Polls are open ${earlyToday.hours} today. Election Day is ${labelFromKey(electionDay)}.`
      : earlyToday
        ? `Early voting is open today, ${earlyToday.hours}. Election Day is ${labelFromKey(electionDay)}.`
        : `Election Day is ${labelFromKey(electionDay)}, polls open ${electionHours}. See hours and polling places.`;

const links = [
  { href: '/', label: 'Front page' },
  { href: '/results', label: 'Results' },
  { href: '/scores', label: 'Scores' },
  { href: '/news', label: 'News' },
  { href: '/events', label: 'Events' },
  { href: '/this-weekend', label: 'This weekend' },
  { href: '/live', label: 'Live' },
  { href: '/videos', label: 'Videos' },
  { href: '/weather', label: 'Weather' },
  { href: '/government', label: 'Government' },
  { href: '/groups', label: 'Social' },
  { href: '/advertise', label: 'Advertise' },
];
const voteLink = { href: '/go-vote', label: 'Go Vote' };

function current(href: string) {
  if (href === '/') return path === '/';
  if (href === '/events') return path === '/events' || path.startsWith('/events/') || path === '/calendar';
  if (href === '/groups') return path === '/groups' || path.startsWith('/groups/') || path === '/social' || path.startsWith('/social/');
  return path === href || path.startsWith(`${href}/`);
}
---

{burnBan.inEffect && (
  <a class="alert-bar" href="/burn-ban">Burn ban in effect in Bastrop County. Read the order before you burn.</a>
)}
{voteLive && (
  <a class="vote-bar" href="/go-vote" data-expires={voteLiveUntil}>
    <strong>Go Vote.</strong> {voteBanner}
  </a>
)}
<header class="site-head">
  <div class="utility">
    <div class="utility-inner">
      <p>{today}</p>
      <div class="utility-links">
        <a href={facebookGroup}>Facebook group</a>
        <a href="/#newsletter">Newsletter</a>
        <a href="/submit">Add an event</a>
      </div>
    </div>
  </div>

  <div class="masthead">
    <a class="ear ear-left" href={`/weather?town=${encodeURIComponent(weatherTown)}`}>
      <span class="ear-label">Right now</span>
      <strong>{forecast ? `${forecast.temp}°` : 'Weather'}</strong>
      <span class="ear-sub">{forecast ? `${weatherLabel(forecast.code)} in ${weatherTown}` : 'County forecast'}</span>
    </a>
    <a class="brand" href="/">
      <img src="/brand/logo-trim.png" alt="Bastropia" width="865" height="923" />
    </a>
    <a class="ear ear-right" href="/burn-ban" aria-label={`Burn ban: ${burnStatus}. Checked ${checkedLabel}`}>
      <span class="ear-label">Burn ban</span>
      <strong class:list={['burn-word', burnBan.inEffect ? 'is-stop' : 'is-ok']}>
        <BurnMark banned={burnBan.inEffect} />
        <span>{burnStatus}</span>
      </strong>
      <span class="ear-sub">Checked {checkedLabel}</span>
    </a>
  </div>

  <div class="county-strip" id="county-strip">
    <a href="https://waterdata.usgs.gov/monitoring-location/08159200/">
      <span>Colorado River</span>
      <strong data-now="river">—</strong>
      <em data-now="river-detail">Bastrop gauge</em>
    </a>
    <a href="https://www.tceq.texas.gov/cgi-bin/compliance/monops/daily_summary.pl?cams=1612">
      <span>Air</span>
      <strong data-now="air">—</strong>
      <em data-now="air-detail">Bastrop</em>
    </a>
    <a href="/roads">
      <span>SH 71</span>
      <strong data-now="sh71">—</strong>
      <em data-now="sh71-detail">Construction</em>
    </a>
    <a href="/roads">
      <span>US 290</span>
      <strong data-now="us290">—</strong>
      <em data-now="us290-detail">Construction</em>
    </a>
    <a href="/schools">
      <span>Schools</span>
      <strong data-now="schools">—</strong>
      <em data-now="schools-detail">Four districts</em>
    </a>
    <a href="https://www.bluebonnet.coop/outages">
      <span>Power</span>
      <strong data-now="power">—</strong>
      <em data-now="power-detail">Bluebonnet</em>
    </a>
    <a href="/roads">
      <span>Roads</span>
      <strong data-now="closed">—</strong>
      <em data-now="closed-detail">Closures</em>
    </a>
  </div>
  <p class="strip-also"><a href="/alerts">Email or text when one of these changes</a></p>
  <p class="strip-also" data-now="also" hidden></p>
  <script is:inline>
    fetch('/api/now')
      .then((response) => response.json())
      .then((data) => {
        const set = (key, value) => {
          const node = document.querySelector(`[data-now="${key}"]`);
          if (node && value) node.textContent = value;
        };
        if (data.river) {
          set('river', data.river.label);
          set('river-detail', data.river.detail);
        }
        if (data.air) {
          set('air', data.air.label);
          set('air-detail', data.air.detail);
        }
        const sh = (data.roads || []).find((road) => road.route === 'SH 71');
        const us = (data.roads || []).find((road) => road.route === 'US 290');
        if (sh) {
          set('sh71', sh.label);
          set('sh71-detail', sh.label === 'None listed' ? 'No alert filed' : sh.detail);
        }
        if (us) {
          set('us290', us.label);
          set('us290-detail', us.label === 'None listed' ? 'No alert filed' : us.detail);
        }
        const fill = (key, line) => {
          if (!line) return;
          set(key, line.label);
          set(`${key}-detail`, line.detail);
          const node = document.querySelector(`[data-now="${key}"]`);
          const link = node && node.closest('a');
          if (!link) return;
          const quiet = line.label === 'Normal day' || line.label === 'None reported' || line.label === 'None listed';
          link.classList.toggle('is-alert', !quiet);
        };
        fill('schools', data.schools);
        fill('power', data.power);
        fill('closed', data.closureLine);
        const also = document.querySelector('[data-now="also"]');
        if (also && data.others && data.others.length) {
          also.hidden = false;
          also.textContent = data.others.map((alert) => `${alert.route}: ${alert.detail}`).join(' ');
        }
      })
      .catch(() => {});
  </script>

  <div class="sections-bar">
    <div class="sections-inner">
      <button class="menu" type="button" aria-expanded="false" aria-controls="site-nav">Sections</button>
      <nav id="site-nav" class="nav" aria-label="Sections">
        {voteLive && (
          <a class="nav-vote" href={voteLink.href} data-expires={voteLiveUntil} aria-current={current(voteLink.href) ? 'page' : undefined}>{voteLink.label}</a>
        )}
        {links.map((link) => (
          <a href={link.href} aria-current={current(link.href) ? 'page' : undefined}>{link.label}</a>
        ))}
      </nav>
      <form class="nav-search" action="/search" method="get" role="search">
        <label class="sr" for="nav-q">Search Bastropia</label>
        <input id="nav-q" name="q" type="search" placeholder="Search" />
      </form>
    </div>
  </div>
</header>
<script is:inline>
  (function () {
    var key = 'bastropia-city';
    var saved = '';
    try { saved = localStorage.getItem(key) || ''; } catch (error) { saved = ''; }
    var match = document.cookie.match(/(?:^|; )bastropia-city=([^;]*)/);
    var current = match ? decodeURIComponent(match[1]) : '';
    if (current && current !== saved) {
      try { localStorage.setItem(key, current); } catch (error) { /* private browsing */ }
    } else if (saved && !current) {
      document.cookie = key + '=' + encodeURIComponent(saved) + '; path=/; max-age=31536000; SameSite=Lax';
      location.reload();
    }
  })();
</script>
<script>
  // Pages built ahead of time can outlive the Go Vote page, so expiring links remove themselves.
  const chicagoToday = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Chicago' }).format(new Date());
  document.querySelectorAll<HTMLElement>('[data-expires]').forEach((element) => {
    if (element.dataset.expires && chicagoToday >= element.dataset.expires) element.remove();
  });

  const button = document.querySelector('.menu');
  const nav = document.querySelector('#site-nav');
  button?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open');
    button.setAttribute('aria-expanded', String(Boolean(open)));
  });
</script>
