---
import BurnMark from './BurnMark.astro';
import SectionNav from './SectionNav.astro';
import SlimBar from './SlimBar.astro';
import SocialIcons from './SocialIcons.astro';
import { burnBan } from '../data/burnBan';
import { burnView } from '../lib/burnBanView';
import { earlyVotingDays, electionDay, electionHours, voteIsLive, voteLiveUntil } from '../data/vote';
import { headerHero, headerNight } from '../lib/headerHero';
import { eventKey, formatLong, labelFromKey } from '../lib/time';
import { getForecast, isTown, weatherLabel } from '../lib/weather';
import { readTown, townCookie } from '../lib/townChoice';

const path = Astro.url.pathname.replace(/\/index\.html$/, '').replace(/\/+$/, '') || '/';
const savedTown = readTown(Astro.cookies.get(townCookie)?.value);
const requestedTown = path === '/weather' ? Astro.url.searchParams.get('town') : null;
const weatherTown =
  path === '/weather'
    ? isTown(requestedTown)
      ? requestedTown
      : 'Bastrop'
    : isTown(savedTown)
      ? savedTown
      : 'Bastrop';
const forecast = await getForecast(weatherTown);
const now = new Date();
const today = formatLong(now);
const dayKey = eventKey(now);
const burn = burnView(now);
const earlyToday = earlyVotingDays.find((day) => day.date === dayKey);
const lastEarly = earlyVotingDays[earlyVotingDays.length - 1]?.date;
const voteLive = voteIsLive(now);
const voteBanner =
  dayKey === electionDay
    ? `Today is Election Day. Polls are open ${electionHours}. See polling places.`
    : earlyToday && dayKey === lastEarly
      ? `Last day of early voting. Polls are open ${earlyToday.hours} today. Election Day is ${labelFromKey(electionDay)}.`
      : earlyToday
        ? `Early voting is open today, ${earlyToday.hours}. Election Day is ${labelFromKey(electionDay)}.`
        : `Election Day is ${labelFromKey(electionDay)}, polls open ${electionHours}. See hours and polling places.`;

const hero = headerHero(path, { night: headerNight(now), scene: forecast?.scene });
const beforeLocal = [
  { href: '/', label: 'Front page' },
  { href: '/weather', label: 'Weather' },
  { href: '/scores', label: 'Scores' },
  { href: '/news', label: 'News' },
  { href: '/guides', label: 'Guides' },
  { href: '/events', label: 'Events' },
  { href: '/this-weekend', label: 'WeekEnd' },
  { href: '/videos', label: 'Videos' },
];
const localLinks = [
  { href: '/government', label: 'Gov' },
  { href: '/cattle', label: 'Cattle' },
  { href: '/churches', label: 'Churches' },
  { href: '/heb-specials', label: 'H-E-B' },
];
const afterLocal = [
  { href: '/groups', label: 'Social' },
  { href: '/directory', label: 'Directory' },
  { href: '/eats', label: 'Eats' },
  { href: '/advertise', label: 'Advertise' },
];
const voteLink = { href: '/go-vote', label: 'Go Vote' };

function current(href: string) {
  if (href === '/') return path === '/';
  if (href === '/events') return path === '/events' || path.startsWith('/events/') || path === '/calendar';
  if (href === '/groups') return path === '/groups' || path.startsWith('/groups/') || path === '/social' || path.startsWith('/social/');
  if (href === '/directory') return path === '/directory' || path.startsWith('/directory/');
  return path === href || path.startsWith(`${href}/`);
}

interface Props {
  compact?: boolean;
  /** The shared sticky bar only, shown at once. Directory, listings, and submit use this. */
  pinnedBar?: boolean;
}

const { compact = false, pinnedBar = false } = Astro.props;
const statusHref = burnBan.inEffect && !burn.stale ? '/burn-ban' : '/now';
const statusText = forecast
  ? `${forecast.temp}° · ${burnBan.inEffect && !burn.stale ? 'Burn ban' : burn.stale ? 'Burn status unconfirmed' : 'No burn ban'}`
  : burnBan.inEffect && !burn.stale
    ? 'Burn ban'
    : 'No burn ban';
---

{pinnedBar ? (
  <SlimBar pinned newsCurrent={current('/news')} eventsCurrent={current('/events')} newsletterCurrent={current('/newsletter')} />
) : compact ? (
  <header class="compact-head">
    <div class="compact-bar">
      <a class="compact-brand" href="/">
        <picture>
          <source srcset="/brand/logo-masthead.webp" type="image/webp" />
          <img src="/brand/logo-masthead.png" alt="" width="37" height="40" decoding="async" />
        </picture>
        <span>Bastropia</span>
      </a>
      <a class="compact-status" href={statusHref}>{statusText}</a>
      <button class="menu compact-menu" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menu">☰</button>
    </div>
    <SectionNav navClass="compact-nav" before={beforeLocal} local={localLinks} after={afterLocal} isCurrent={current} />
  </header>
) : (
  <>
{burnBan.inEffect && !burn.stale && (
  <a class="alert-bar" href="/burn-ban">Burn ban in effect in Bastrop County. Read the order before you burn.</a>
)}
{burn.stale && (
  <a class="stale-bar" href={burnBan.sourceUrl}>
    Status not confirmed since {burn.checkedLong} — check the county page.
  </a>
)}
{voteLive && (
  <a class="vote-bar" href="/go-vote" data-expires={voteLiveUntil}>
    <strong>Go Vote.</strong> {voteBanner}
  </a>
)}
<header class="site-head">
  <div class="utility">
    <div class="utility-inner">
      <p>{today}</p>
      <div class="utility-links">
        <SocialIcons />
        <a href="/new-here">New here</a>
        <a href="/newsletter">Newsletter</a>
        <a href="/submit">Add an event</a>
      </div>
    </div>
  </div>

  <div class="header-stage">
    <div
      class:list={['header-hero', hero.heroClass]}
      data-header-hero={hero.rest.length > 0 ? 'true' : undefined}
      aria-hidden="true"
    >
      <img
        class="is-on"
        src={hero.visible.src}
        alt=""
        width={hero.visible.width}
        height={hero.visible.height}
        decoding="async"
        fetchpriority="high"
        sizes="100vw"
      />
      {hero.rest.map((image) => (
        <img
          src={image.src}
          alt=""
          width={image.width}
          height={image.height}
          decoding="async"
          fetchpriority="low"
          loading="lazy"
          sizes="100vw"
        />
      ))}
    </div>
    <div class="brand-band">
      <div class="brand-row">
        <a class="brand" href="/">
          <span class="brand-mark">
            <picture>
              <source srcset="/brand/logo-masthead.webp" type="image/webp" />
              <img src="/brand/logo-masthead.png" alt="" width="440" height="470" decoding="async" />
            </picture>
          </span>
          <span class="brand-name">Bastropia</span>
        </a>
      </div>
    </div>

    <section class="now-board" id="county-strip" aria-label="Right now in Bastrop County">
      <ul class="now-grid">
        <li>
          <a class="now-card is-lead" href={`/weather?town=${encodeURIComponent(weatherTown)}`}>
            <strong class="now-value">{forecast ? `${forecast.temp}°` : 'Weather'}</strong>
            <span class="now-label">Right now</span>
            <span class="now-detail">{forecast ? `${weatherLabel(forecast.code)} in ${weatherTown}` : 'County forecast'}</span>
            <svg class="now-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.1" fill="none" stroke="currentColor" stroke-width="1.8"/><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M12 3.4v2M12 18.6v2M3.4 12h2M18.6 12h2M6.1 6.1l1.4 1.4M16.5 16.5l1.4 1.4M17.9 6.1l-1.4 1.4M7.5 16.5 6.1 17.9"/></svg>
          </a>
        </li>
        <li>
          <a class:list={['now-card', burn.tone === 'stop' && 'is-alert', burn.tone === 'stale' && 'is-stale']} href="/burn-ban" aria-label={burn.aria}>
            <strong class:list={['now-value', 'is-phrase', 'burn-word', `is-${burn.tone}`]}>{burn.status}</strong>
            <span class="now-label">Burn ban</span>
            <span class:list={['now-detail', { 'is-stale': burn.stale }]}>{burn.sub}</span>
            <BurnMark banned={burnBan.inEffect && !burn.stale} />
          </a>
        </li>
        <li>
          <a class="now-card" href="https://waterdata.usgs.gov/monitoring-location/08159200/">
            <strong class="now-value" data-now="river">—</strong>
            <span class="now-label">Colorado River</span>
            <span class="now-detail" data-now="river-detail">Bastrop gauge</span>
            <svg class="now-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M3 10.5c1.6 1.4 3.4 1.4 5 0s3.4-1.4 5 0 3.4 1.4 5 0M3 14.5c1.6 1.4 3.4 1.4 5 0s3.4-1.4 5 0 3.4 1.4 5 0M3 18.5c1.6 1.4 3.4 1.4 5 0s3.4-1.4 5 0 3.4 1.4 5 0"/></svg>
          </a>
        </li>
        <li>
          <a class="now-card" href="https://www.tceq.texas.gov/cgi-bin/compliance/monops/daily_summary.pl?cams=1612">
            <strong class="now-value" data-now="air">—</strong>
            <span class="now-label">Air</span>
            <span class="now-detail" data-now="air-detail">Bastrop</span>
            <svg class="now-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M3.5 8.5c2.2 0 3.3 1.7 5.5 1.7S12.3 8.5 14.5 8.5 17.8 10.2 20 10.2M3.5 13c2.2 0 3.3 1.7 5.5 1.7S12.3 13 14.5 13s3.3 1.7 5.5 1.7M3.5 17.5c2.2 0 3.3 1.7 5.5 1.7S12.3 17.5 14.5 17.5s3.3 1.7 5.5 1.7"/></svg>
          </a>
        </li>
        <li>
          <a class="now-card" href="/roads">
            <strong class="now-value" data-now="sh71">—</strong>
            <span class="now-label">SH 71</span>
            <span class="now-detail" data-now="sh71-detail">Construction</span>
            <svg class="now-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="m12 3.5 8.5 17h-17L12 3.5Z"/><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M12 10v4.5M12 17.5v.2"/></svg>
          </a>
        </li>
        <li>
          <a class="now-card" href="/roads">
            <strong class="now-value" data-now="us290">—</strong>
            <span class="now-label">US 290</span>
            <span class="now-detail" data-now="us290-detail">Construction</span>
            <svg class="now-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="m12 3.5 8.5 17h-17L12 3.5Z"/><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M12 10v4.5M12 17.5v.2"/></svg>
          </a>
        </li>
        <li>
          <a class="now-card" href="/schools">
            <strong class="now-value" data-now="schools">—</strong>
            <span class="now-label">Schools</span>
            <span class="now-detail" data-now="schools-detail">Four districts</span>
            <svg class="now-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="m3.5 9.5 8.5-3 8.5 3-8.5 3-8.5-3Z"/><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M7 11.2v4.1c0 .7 2.2 2.2 5 2.2s5-1.5 5-2.2v-4.1M20.5 9.5v6"/></svg>
          </a>
        </li>
        <li>
          <a class="now-card" href="https://www.bluebonnet.coop/outages">
            <strong class="now-value" data-now="power">—</strong>
            <span class="now-label">Power</span>
            <span class="now-detail" data-now="power-detail">Bluebonnet</span>
            <svg class="now-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M13 3.5 6.5 13h5l-1 7.5L18 10.5h-5L13 3.5Z"/></svg>
          </a>
        </li>
        <li>
          <a class="now-card" href="https://www.ams.usda.gov/mnreports/ams_1955.pdf">
            <strong class="now-value" data-now="beef">—</strong>
            <span class="now-label">Beef</span>
            <span class="now-detail" data-now="beef-detail">Texas auctions</span>
            <svg class="now-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M4.8 15.2c.2-2.4 2-4.3 4.4-4.5.3-1.6 1.7-2.8 3.4-2.6 1.4.2 2.5 1.2 2.9 2.4 1.9.3 3.3 1.8 3.3 3.6 0 2-1.5 3.4-3.5 3.4H8.3c-2 0-3.5-1.4-3.5-3.3Z"/><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M8.2 11.2 7 8.4M15.2 10.8l1.3-2.6"/></svg>
          </a>
        </li>
        <li>
          <a class="now-card" href="/weather">
            <strong class="now-value" data-now="rain">—</strong>
            <span class="now-label">Rain</span>
            <span class="now-detail" data-now="rain-detail">Last 7 days</span>
            <svg class="now-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M12 3.2C12 3.2 7.2 9 7.2 12.4a4.8 4.8 0 0 0 9.6 0C16.8 9 12 3.2 12 3.2Z"/></svg>
          </a>
        </li>
      </ul>
      <details class="now-chip" hidden>
        <summary>
          <span class="now-chip-kicker">Road alert</span>
          <span class="now-chip-text" data-now="also"></span>
          <span class="now-chip-chevron" aria-hidden="true"></span>
        </summary>
      </details>
    </section>
  </div>
  <script is:inline>
    fetch('/api/now')
      .then((response) => response.json())
      .then((data) => {
        const set = (key, value) => {
          const node = document.querySelector(`[data-now="${key}"]`);
          if (!node || !value) return;
          node.textContent = value;
          if (node.classList.contains('now-value')) node.classList.toggle('is-phrase', value.length > 8);
          if (node.classList.contains('now-detail')) node.title = value;
        };
        const mark = (key, label) => {
          const node = document.querySelector(`[data-now="${key}"]`);
          const link = node && node.closest('a');
          if (!link || !label) return;
          const quiet = label === 'Normal day' || label === 'None reported' || label === 'None listed' || label === 'No burn ban';
          link.classList.toggle('is-alert', !quiet);
        };
        if (data.river) {
          set('river', data.river.label);
          set('river-detail', data.river.detail);
        }
        if (data.air) {
          set('air', data.air.label);
          set('air-detail', data.air.detail);
        }
        if (data.rain) {
          set('rain', data.rain.label);
          set('rain-detail', data.rain.detail);
        }
        const sh = (data.roads || []).find((road) => road.route === 'SH 71');
        const us = (data.roads || []).find((road) => road.route === 'US 290');
        if (sh) {
          set('sh71', sh.label);
          set('sh71-detail', sh.label === 'None listed' ? 'No alert filed' : sh.detail);
          mark('sh71', sh.label);
        }
        if (us) {
          set('us290', us.label);
          set('us290-detail', us.label === 'None listed' ? 'No alert filed' : us.detail);
          mark('us290', us.label);
        }
        const fill = (key, line) => {
          if (!line) return;
          set(key, line.label);
          set(`${key}-detail`, line.detail);
          mark(key, line.label);
        };
        fill('schools', data.schools);
        fill('power', data.power);
        if (data.beef) {
          set('beef', data.beef.label);
          set('beef-detail', data.beef.detail);
          const beefNode = document.querySelector('[data-now="beef"]');
          const beefLink = beefNode && beefNode.closest('a');
          if (beefLink && data.beef.href) beefLink.href = data.beef.href;
        }
        const also = document.querySelector('[data-now="also"]');
        if (also && data.others && data.others.length) {
          also.textContent = data.others.map((alert) => `${alert.route}: ${alert.detail}`).join(' ');
          const chip = also.closest('.now-chip');
          if (chip) chip.hidden = false;
        }
      })
      .catch(() => {});
  </script>
  {path === '/' && (
    <script is:inline>
      (function () {
        var root = document.querySelector('[data-header-hero]');
        if (!root) return;
        var slides = root.querySelectorAll('img');
        if (slides.length < 2) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var index = 0;
        setInterval(function () {
          slides[index].classList.remove('is-on');
          index = (index + 1) % slides.length;
          slides[index].classList.add('is-on');
        }, 11000);
      })();
    </script>
  )}

  <div class="sections-bar">
    <div class="sections-inner">
      <button class="menu" type="button" aria-expanded="false" aria-controls="site-nav">Sections</button>
      <nav class="quick-links" aria-label="Shortcuts">
        <a href="/news" aria-current={current('/news') ? 'page' : undefined}>News</a>
        <a href="/events" aria-current={current('/events') ? 'page' : undefined}>Events</a>
        <a class="quick-join" href="/newsletter#newsletter" aria-current={current('/newsletter') ? 'page' : undefined}>Newsletter</a>
      </nav>
      <SectionNav before={beforeLocal} local={localLinks} after={afterLocal} isCurrent={current} vote={voteLive ? voteLink : null} voteExpires={voteLive ? voteLiveUntil : undefined} />
      <form class="nav-search" action="/search" method="get" role="search">
        <label class="sr" for="nav-q">Search Bastropia</label>
        <input id="nav-q" name="q" type="search" placeholder="Search" />
      </form>
    </div>
  </div>
</header>
<SlimBar newsCurrent={current('/news')} eventsCurrent={current('/events')} newsletterCurrent={current('/newsletter')} />
  </>
)}
<script is:inline>
  (function () {
    var key = 'bastropia-city';
    var saved = '';
    try { saved = localStorage.getItem(key) || ''; } catch (error) { saved = ''; }
    var match = document.cookie.match(/(?:^|; )bastropia-city=([^;]*)/);
    var current = match ? decodeURIComponent(match[1]) : '';
    if (current && current !== saved) {
      try { localStorage.setItem(key, current); } catch (error) { /* private browsing */ }
    } else if (saved && !current) {
      document.cookie = key + '=' + encodeURIComponent(saved) + '; path=/; max-age=31536000; SameSite=Lax';
      location.reload();
    }
  })();
</script>
<script>
  // Pages built ahead of time can outlive the Go Vote page, so expiring links remove themselves.
  const chicagoToday = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Chicago' }).format(new Date());
  document.querySelectorAll<HTMLElement>('[data-expires]').forEach((element) => {
    if (element.dataset.expires && chicagoToday >= element.dataset.expires) element.remove();
  });

  const button = document.querySelector('.menu');
  const nav = document.querySelector('#site-nav');
  button?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open');
    button.setAttribute('aria-expanded', String(Boolean(open)));
  });

  const local = document.querySelector<HTMLElement>('[data-nav-local]');
  const localButton = local?.querySelector<HTMLButtonElement>('.nav-local-btn');
  if (local && localButton) {
    const setOpen = (on: boolean) => {
      local.classList.toggle('is-open', on);
      localButton.setAttribute('aria-expanded', String(on));
    };
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    let suppressFocus = false;
    if (canHover) {
      local.addEventListener('mouseenter', () => setOpen(true));
      local.addEventListener('mouseleave', () => {
        if (!local.contains(document.activeElement)) setOpen(false);
      });
      local.addEventListener('focusin', () => {
        if (!suppressFocus) setOpen(true);
      });
      local.addEventListener('focusout', (event) => {
        const next = event.relatedTarget;
        if (!(next instanceof Node) || !local.contains(next)) setOpen(false);
      });
    } else {
      localButton.addEventListener('click', () => {
        setOpen(localButton.getAttribute('aria-expanded') !== 'true');
      });
    }
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !local.contains(event.target)) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && local.classList.contains('is-open')) {
        suppressFocus = true;
        setOpen(false);
        localButton.focus();
        suppressFocus = false;
      }
    });
  }
</script>
<script is:inline>
  (function () {
    var bar = document.querySelector('[data-slim-bar]');
    var head = document.querySelector('.site-head');
    if (!bar || !head || !('IntersectionObserver' in window)) return;
    var observer = new IntersectionObserver(function (entries) {
      var on = !entries[0].isIntersecting;
      bar.classList.toggle('is-on', on);
      if (on) {
        bar.removeAttribute('inert');
        bar.removeAttribute('aria-hidden');
      } else {
        bar.setAttribute('inert', '');
        bar.setAttribute('aria-hidden', 'true');
      }
    });
    observer.observe(head);
  })();
</script>
