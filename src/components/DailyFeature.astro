---
import { tiktokProfile, youtubeChannel } from '../data/site';
import { offsiteAttrs } from '../lib/links';

interface Props {
  /** Home uses h1. The news page already has a page title. */
  level?: 'h1' | 'h2';
}

const { level = 'h2' } = Astro.props;
const Title = level;

/** Uploads playlist for channel UCdxOffp6asSKV6aPNT1vkdA (UU + id without UC). */
const embedSrc = 'https://www.youtube-nocookie.com/embed/videoseries?list=UUdxOffp6asSKV6aPNT1vkdA';
const subscribeHref = `${youtubeChannel}?sub_confirmation=1`;
const episodesHref = `${youtubeChannel}/videos`;
---

<section class="daily-feature" aria-labelledby="daily-heading">
  <p class="kicker">Latest episode</p>
  <Title id="daily-heading" class="daily-title">Bastropia Daily</Title>
  <p class="dek">The newest upload from the Bastropia YouTube channel.</p>
  <div class="daily-player">
    <iframe
      src={embedSrc}
      title="Latest Bastropia Daily episode"
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen"
      allowfullscreen
      referrerpolicy="strict-origin-when-cross-origin"
    ></iframe>
  </div>
  <div class="daily-actions">
    <a class="button" href={subscribeHref} {...offsiteAttrs(subscribeHref)}>Subscribe on YouTube</a>
    <a class="button" href={tiktokProfile} {...offsiteAttrs(tiktokProfile)}>Follow on TikTok</a>
    <a class="daily-more" href={episodesHref} {...offsiteAttrs(episodesHref)}>More episodes</a>
  </div>
  <p class="daily-note">AI-generated anchor and narration. Photos credited on screen.</p>
</section>
