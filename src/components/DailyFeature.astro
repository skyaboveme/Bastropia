---
import { tiktokProfile, youtubeChannel } from '../data/site';
import { currentDailyVideo, playlistEmbed, videoEmbed, type DailyVideoRecord } from '../lib/dailyVideo';
import { offsiteAttrs } from '../lib/links';

interface Props {
  /** Home uses h1. The news page already has a page title. */
  level?: 'h1' | 'h2';
  /** Pass a record already loaded for schema. Omit it and the component reads KV. */
  video?: DailyVideoRecord | null;
}

const { level = 'h2' } = Astro.props;
const Title = level;

/**
 * KV holds the newest full edition, refreshed by the 15-minute cron and
 * /api/daily-video. Empty KV refreshes once here. The playlist is only the
 * last fallback, and the script replaces it when the API has an id.
 */
const video = Astro.props.video !== undefined ? Astro.props.video : await currentDailyVideo();
const embedSrc = video ? videoEmbed(video.videoId) : playlistEmbed;
const frameTitle = video?.title || 'Latest Bastropia Daily episode';
const subscribeHref = `${youtubeChannel}?sub_confirmation=1`;
const episodesHref = `${youtubeChannel}/videos`;
---

<section class="daily-feature" aria-labelledby="daily-heading">
  <p class="kicker">Latest episode</p>
  <Title id="daily-heading" class="daily-title">Bastropia Daily</Title>
  <p class="dek">The newest full episode from the Bastropia YouTube channel.</p>
  <div class="daily-player">
    <iframe
      data-daily-player
      data-video={video?.videoId ?? ''}
      src={embedSrc}
      title={frameTitle}
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen"
      allowfullscreen
      referrerpolicy="strict-origin-when-cross-origin"
    ></iframe>
  </div>
  <script is:inline>
    document.querySelectorAll('[data-daily-player]').forEach((frame) => {
      fetch('/api/daily-video', { headers: { accept: 'application/json' } })
        .then((response) => (response.ok ? response.json() : null))
        .then((data) => {
          const id = data && data.videoId;
          if (!/^[\w-]{11}$/.test(id) || id === frame.dataset.video) return;
          frame.dataset.video = id;
          if (data.title) frame.title = data.title;
          frame.src = 'https://www.youtube-nocookie.com/embed/' + encodeURIComponent(id) + '?rel=0';
        })
        .catch(() => {});
    });
  </script>
  <div class="daily-actions">
    <a class="button" href={subscribeHref} {...offsiteAttrs(subscribeHref)}>Subscribe on YouTube</a>
    <a class="button" href={tiktokProfile} {...offsiteAttrs(tiktokProfile)}>Follow on TikTok</a>
    <a class="daily-more" href={episodesHref} {...offsiteAttrs(episodesHref)}>More episodes</a>
  </div>
  <p class="daily-note">AI-generated anchor and narration. Photos credited on screen.</p>
</section>
