---
import { youtubeChannel } from '../data/site';
import { thumbnail, watchUrl } from '../data/videos';
import { getCollection } from 'astro:content';
import { currentDailyVideo } from '../lib/dailyVideo';
import { capOrganizer, filterEvents } from '../lib/events';
import { offsiteAttrs } from '../lib/links';
import { eventKey, labelFromKey, stampParts, thisWeekendKeys, whenLabel } from '../lib/time';
import { getForecast, weatherLabel, type Forecast, type TownName } from '../lib/weather';

const stripTowns = ['Bastrop', 'Elgin', 'Smithville', 'Paige'] as const satisfies readonly TownName[];

const now = new Date();
const today = eventKey(now);
const todayLabel = new Intl.DateTimeFormat('en-US', {
  timeZone: 'America/Chicago',
  weekday: 'long',
  month: 'short',
  day: 'numeric',
}).format(now);
const [events, video, forecasts] = await Promise.all([
  getCollection('events'),
  currentDailyVideo(),
  Promise.all(
    stripTowns.map(async (town) => {
      try {
        return { town, forecast: await getForecast(town) };
      } catch {
        return { town, forecast: null as Forecast | null };
      }
    }),
  ),
]);

const todayEvents = capOrganizer(filterEvents(events, { when: 'today' }, now)).slice(0, 3);
const nextEvents = filterEvents(events, { when: 'upcoming' }, now)
  .filter((event) => eventKey(event.data.start) > today)
  .slice(0, 3);
const shownEvents = todayEvents.length ? todayEvents : nextEvents;
const eventsAreToday = todayEvents.length > 0;
const weekendKeys = thisWeekendKeys(now);
const weekendEvents = filterEvents(events, { when: 'weekend' }, now);
const weekendPool = weekendKeys.flatMap((day) =>
  capOrganizer(weekendEvents.filter((event) => eventKey(event.data.start) === day)),
);
const shownIds = new Set(shownEvents.map((event) => event.id));
const weekendFresh = weekendPool.filter((event) => !shownIds.has(event.id));
const weekendHighlights = (weekendFresh.length >= 2 ? weekendFresh : weekendPool).slice(0, 3);
const dayOf = (forecast: Forecast | null) =>
  forecast?.daily.find((item) => item.date === today) ?? forecast?.daily[0];
const bastrop = forecasts.find((item) => item.town === 'Bastrop')?.forecast ?? null;
const bastropDay = dayOf(bastrop);
const conditions = bastrop ? weatherLabel(bastrop.code) : '';
const otherTowns = forecasts.filter(
  (item): item is { town: TownName; forecast: Forecast } => item.town !== 'Bastrop' && item.forecast !== null,
);
const clipHref = video ? watchUrl(video.videoId) : `${youtubeChannel}/videos`;
const clipTitle = video?.title || 'Newest full episode';
const clipWhen = (() => {
  const published = Date.parse(video?.published ?? '');
  if (!Number.isFinite(published)) return '';
  return new Intl.DateTimeFormat('en-US', {
    timeZone: 'America/Chicago',
    month: 'short',
    day: 'numeric',
  }).format(published);
})();
const weatherLabelText =
  forecasts
    .flatMap(({ town, forecast }) => {
      if (!forecast) return [];
      const day = dayOf(forecast);
      const sky = weatherLabel(forecast.code);
      const range = day ? `, high ${day.high}, low ${day.low}` : '';
      return [`${town} ${forecast.temp} degrees, ${sky}${range}`];
    })
    .join('. ') || 'County weather forecast';
---

<section class="today-strip" aria-labelledby="today-heading">
  <p class="col-title" id="today-heading">Today in Bastrop <span class="today-date">{todayLabel}</span></p>
  <div class="today-row">
    <a class="today-card today-wx" href="/weather" aria-label={weatherLabelText}>
      <p class="kicker">Weather</p>
      {bastrop ? (
        <>
          <strong class="wx-now">{bastrop.temp}°</strong>
          <span>Bastrop · {conditions}</span>
          {bastropDay && <span class="meta">High {bastropDay.high}° · Low {bastropDay.low}°</span>}
        </>
      ) : (
        <span class="meta">Bastrop forecast unavailable</span>
      )}
      {otherTowns.length > 0 && (
        <ul class="wx-towns">
          {otherTowns.map(({ town, forecast }) => {
            const sky = weatherLabel(forecast.code);
            const day = dayOf(forecast);
            const detail = sky && sky !== 'Forecast' ? sky : day ? `${day.high}°/${day.low}°` : '';
            return (
              <li>
                <span>{town}</span>
                <strong>{forecast.temp}°</strong>
                {detail && <span>{detail}</span>}
              </li>
            );
          })}
        </ul>
      )}
    </a>

    <a class="today-card today-video" href={clipHref} {...offsiteAttrs(clipHref)}>
      {video && (
        <img
          src={thumbnail(video.videoId, 'hqdefault')}
          alt=""
          width="320"
          height="180"
          loading="lazy"
          decoding="async"
        />
      )}
      <span class="today-copy">
        <p class="kicker">Bastropia Daily</p>
        <strong>{clipTitle}</strong>
        {clipWhen && <span class="meta">{clipWhen}</span>}
      </span>
    </a>

    <article class="today-card today-events-card" aria-label={eventsAreToday ? "Today's events" : 'Upcoming events'}>
      <p class="kicker">{eventsAreToday ? 'Today' : 'Next up'}</p>
      {shownEvents.length ? (
        <ul class="today-events">
          {shownEvents.map((event) => (
            <li>
              <a href={`/events/${event.id}`}>
                <span class="when">
                  {eventsAreToday
                    ? whenLabel(event.data.schedule, event.data.start, event.data.end)
                    : labelFromKey(eventKey(event.data.start))}
                </span>
                <strong>{event.data.title}</strong>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="meta">Nothing is on the calendar yet.</p>
      )}
      <a class="today-more" href="/events">{eventsAreToday ? 'All events' : 'Events calendar'}</a>
    </article>

    <article class="today-card today-events-card" aria-label="This weekend">
      <p class="kicker">This weekend</p>
      {weekendHighlights.length ? (
        <ul class="today-events">
          {weekendHighlights.map((event) => (
            <li>
              <a href={`/events/${event.id}`}>
                <span class="when">{stampParts(event.data.start).weekday} · {whenLabel(event.data.schedule, event.data.start, event.data.end)}</span>
                <strong>{event.data.title}</strong>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="meta">Nothing is listed for this weekend.</p>
      )}
      <a class="today-more" href="/this-weekend">Friday to Sunday</a>
    </article>
  </div>
</section>
