---
import BaseLayout from '../layouts/BaseLayout.astro';
import { directoryBusiness, listingSummary } from '../lib/schema';
import { logoSrc, type Biz, type BizEvent, type BizSpecial } from '../lib/businessDb';
import { publicCategoryFor } from '../data/directoryCategories';
import { mapsSearchUrl, outboundLabel } from '../lib/maps';

interface Props {
  business: Biz;
  specials?: BizSpecial[];
  events?: BizEvent[];
}

const { business, specials = [], events = [] } = Astro.props;
const phoneDigits = business.phone.replace(/\D/g, '');
const upcoming = events.filter((item) => item.starts >= new Date().toISOString().slice(0, 10));
const description = listingSummary(business);
const map = mapsSearchUrl(business.address);
const siteLabel = outboundLabel(business.website);
const publicGroup = publicCategoryFor(business.category);
---

<BaseLayout title={business.name} description={description} extra={[directoryBusiness(business)]}>
  <article class="wrap">
    <header class="page-head" style="padding-left:0;padding-right:0;width:auto;">
      <div style="display:flex;gap:0.9rem;align-items:center;">
        {business.logo_type && (
          <img src={logoSrc(business)} alt="" width="72" height="72" style="width:4.4rem;height:4.4rem;object-fit:cover;border-radius:0.4rem;background:#fff;flex:none;" />
        )}
        <div>
          <p class="kicker">{business.category} · {business.city}</p>
          <h1>{business.name}</h1>
        </div>
      </div>
      {business.details && <p class="lede">{business.details}</p>}
      {business.hours && <p class="listing-hours">{business.hours}</p>}
    </header>
    {business.banner_url && (
      <section class="home-banner banner-poster" data-listing-banner={business.id} aria-label="Sponsored" style="margin-top:1rem;">
        <div class="home-banner-frame">
          <a class="home-banner-slide is-on" href={`/go/biz/${business.id}?to=banner`}>
            <img src={business.banner_url} alt={business.name} width="1200" height="500" decoding="async" />
          </a>
        </div>
      </section>
      <script is:inline>
        const root = document.currentScript && document.currentScript.previousElementSibling;
        const id = root && root.getAttribute('data-listing-banner');
        if (id) {
          const body = new URLSearchParams({ id, placement: 'listing' });
          if (navigator.sendBeacon) navigator.sendBeacon('/api/ad-stat', body);
          else fetch('/api/ad-stat', { method: 'POST', body, keepalive: true });
        }
      </script>
    )}
    {business.daily_special && (
      <section class="notice" style="margin-top:1rem;">
        <p class="kicker" style="color: var(--river);">Daily special</p>
        <h2>{business.daily_special}</h2>
      </section>
    )}
    <p class="cluster listing-actions">
      {phoneDigits && <a class="button" href={`/go/biz/${business.id}?to=phone`}>Call {business.phone}</a>}
      {map && <a class="button button-ghost" href={map} target="_blank" rel="noopener noreferrer">Directions</a>}
      {business.website && <a class="button button-ghost" href={`/go/biz/${business.id}?to=site`}>{siteLabel}</a>}
      <a class="button button-ghost" href={`/directory?category=${encodeURIComponent(publicGroup.slug)}`}>More {publicGroup.label}</a>
    </p>
    <dl class="facts">
      {business.address && (
        <div>
          <dt>Address</dt>
          <dd>{business.address}{map && <> · <a href={map} target="_blank" rel="noopener noreferrer">Map</a></>}</dd>
        </div>
      )}
      {business.hours && <div><dt>Hours</dt><dd>{business.hours}</dd></div>}
      {business.phone && <div><dt>Phone</dt><dd><a href={`/go/biz/${business.id}?to=phone`}>{business.phone}</a></dd></div>}
      {business.website && <div><dt>{siteLabel}</dt><dd><a href={`/go/biz/${business.id}?to=site`}>{business.website.replace(/^https?:\/\//, '')}</a></dd></div>}
      {business.areas && <div><dt>Also serves</dt><dd>{business.areas}</dd></div>}
    </dl>
    {specials.length > 0 && (
      <section class="section">
        <h2>Specials</h2>
        {specials.map((item) => (
          <article>
            <h3>{item.title}</h3>
            <p>{item.details}</p>
            {(item.starts || item.ends) && <p class="meta">{[item.starts, item.ends].filter(Boolean).join(' – ')}</p>}
          </article>
        ))}
      </section>
    )}
    {upcoming.length > 0 && (
      <section class="section">
        <h2>Events</h2>
        {upcoming.map((item) => (
          <article>
            <h3>{item.title}</h3>
            <p class="meta">{item.starts}{item.ends ? ` – ${item.ends}` : ''}{item.venue ? ` · ${item.venue}` : ''}</p>
            {item.details && <p>{item.details}</p>}
          </article>
        ))}
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .listing-hours { margin: 0.35rem 0 0; font-weight: 650; }
  .listing-actions { margin-top: 1rem; }
  .listing-actions .button { min-height: 2.75rem; }
</style>
