---
import { categoryIconSvg } from '../data/categoryIcons';

interface Props {
  icon: string;
  large?: boolean;
}

const { icon, large = false } = Astro.props;
const markup = categoryIconSvg[icon] || categoryIconSvg.store;
---

<span class:list={['cat-svg', { 'is-lg': large }]} set:html={markup} />

<style>
  .cat-svg {
    display: grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    color: inherit;
  }
  .cat-svg.is-lg {
    width: 2rem;
    height: 2rem;
  }
  .cat-svg :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
