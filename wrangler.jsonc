{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bastropia",
  "account_id": "aa96f50b9174b128d2cbe8f6db54b940",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "096bc1b30b154282a5b0397d8dd4b5d5"
    }
  ],
  "routes": [
    { "pattern": "bastropia.com", "custom_domain": true },
    { "pattern": "www.bastropia.com", "custom_domain": true }
  ]
}
